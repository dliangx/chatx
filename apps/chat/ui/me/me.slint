import { ScrollView, VerticalBox } from "std-widgets.slint";
import { Icon, Glyph, Variant } from "../components/icon.slint";
import { SettingItem, ProfileItem } from "../components/item.slint";
import { Theme } from "../theme.slint";
import { SubPageType, AppState } from "../components/app_state.slint";
import { EditProfileState } from "./edit.slint";


export component MeView inherits Rectangle {
    background: Theme.bg;
    in-out property <int> selected-key: -1;

    ProfileItem {
        name: AppState.user-id;
        nickname: AppState.nickname;
        peer-id: AppState.peer-id;
        show-qr(peer) => { AppState.show-qr-code(peer); }
        open-edit => {
            EditProfileState.edit-username = AppState.user-id;
            EditProfileState.request-load-name(AppState.user-id);
            AppState.push-sub(SubPageType.EditProfile, 0);
        }
    }

    ScrollView {
        width: 100%;
        height: parent.height - 100px;
        y: 100px;
        VerticalLayout {
            width: 100%;
            spacing: 0px;

            SettingItem {
                width: 100%;
                id: 1;
                icon: Glyph.notes;
                title: @tr("My notes");
                selected: root.selected-key == 1;
                clicked => { root.selected-key = 1; AppState.push-sub(SubPageType.MyNote, 0); }
            }

            SettingItem {
                width: 100%;
                id: 5;
                icon: Glyph.device;
                title: @tr("My devices");
                selected: root.selected-key == 5;
                clicked => { root.selected-key = 5; AppState.push-sub(SubPageType.MyDevices, 0); }
            }

            SettingItem {
                width: 100%;
                id: 4;
                icon: Glyph.setting;
                title: @tr("Settings");
                selected: root.selected-key == 4;
                clicked => { root.selected-key = 4; AppState.push-sub(SubPageType.Settings, 0); }
            }
        }
    }
}
