import { Header } from "../components/header.slint";
import { SettingItem } from "../components/item.slint";
import { Glyph } from "../components/icon.slint";
import { SubPageType, AppState } from "../components/app_state.slint";

export component SettingView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #f5f5f5;

    Header {
        name: @tr("setting");
    }

    SettingItem {
        y: 49px;
        width: 100%;
        id: 2;
        icon: Glyph.configuration;
        title: @tr("Language");
        clicked => { AppState.push-sub(SubPageType.LanguagePicker, 0); }
    }

    SettingItem {
        y: 97px;
        width: 100%;
        id: 1;
        icon: Glyph.close-circle;
        title: @tr("Sign out");
        clicked => { AppState.logout(); }
    }
}
