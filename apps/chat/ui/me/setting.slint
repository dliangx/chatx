import { SubPageType } from "../components/nav_state.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Horizontal } from "../../material-1.0/material.slint";
import { AppState } from "../components/app_state.slint";

export component SettingView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    callback on-back();
    callback open-sub(SubPageType);

    VerticalLayout {
        width: 100%;

        // 标题栏
        Rectangle {
            width: 100%;
            height: 48px;
            if AppState.is-mobile:
            Icon {
                x: 12px;
                y: (parent.height - self.size) / 2;
                size: 24px;
                glyph: Glyph.left;
                tint: Theme.fg;
                TouchArea {
                    width: 48px;
                    height: 48px;
                    clicked => { root.on-back(); }
                }
            }

            Text {
                x: 60px;
                y: 0px;
                width: parent.width - 120px;
                height: 48px;
                text: "设置";
                font-size: 16px;
                font-weight: 600;
                color: Theme.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 占位分隔线
        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border;
        }
    }
}
