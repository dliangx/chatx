import { Header } from "../components/header.slint";
import { SettingItem } from "../components/item.slint";
import { Glyph, Icon, Variant } from "../components/icon.slint";
import { SubPageType, AppState } from "../components/app_state.slint";
import { Theme } from "../theme.slint";

export component SettingView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    Header {
        name: @tr("setting");
    }

    SettingItem {
        y: 49px;
        width: 100%;
        id: 2;
        icon: Glyph.configuration;
        title: @tr("Language");
        clicked => { AppState.push-sub(SubPageType.LanguagePicker, 0); }
    }

    // Dark mode row: title + right-side indicator. The whole 48px strip acts
    // as the tap target; the indicator is a 4×20 bar that's brand-soft when
    // active and surface-2 when off, mirroring the `SettingItem` look.
    Rectangle {
        y: 97px;
        width: 100%;
        height: 48px;
        background: transparent;
        clip: true;

        Icon {
            x: 8px;
            y: 12px;
            size: 24px;
            glyph: Glyph.configuration;
            variant: Variant.raw;
            tint: ta.pressed ? Theme.brand-soft : Theme.fg;
        }

        Text {
            x: 40px;
            y: 0px;
            width: parent.width - 96px;
            height: parent.height;
            vertical-alignment: center;
            text: @tr("Dark mode");
            font-size: 14px;
            color: ta.pressed ? Theme.brand-soft : Theme.fg;
        }

        Rectangle {
            x: parent.width - 40px;
            y: 14px;
            width: 28px;
            height: 20px;
            border-radius: 10px;
            background: Theme.dark ? Theme.brand : Theme.surface-2;
            border-width: 1px;
            border-color: Theme.dark ? Theme.brand : Theme.disabled;

            Rectangle {
                x: Theme.dark ? 10px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.dark ? Theme.fg-on-accent : Theme.disabled;
            }
        }

        Rectangle {
            x: 40px;
            y: 48px;
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        ta := TouchArea {
            width: 100%;
            height: 100%;
            clicked => { AppState.toggle-theme(!Theme.dark); }
        }
    }

    SettingItem {
        y: 145px;
        width: 100%;
        id: 1;
        icon: Glyph.close-circle;
        title: @tr("Sign out");
        clicked => { AppState.logout(); }
    }
}
