import { Icon, Glyph, Variant } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { AppState } from "../components/app_state.slint";

component LangRow inherits Rectangle {
    in property <string> code;
    in property <string> label;
    in property <bool> selected;
    width: 100%;
    height: 52px;
    background: Theme.bg;

    Text {
        x: 16px;
        y: 0px;
        width: parent.width - 56px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        font-size: 15px;
        color: Theme.fg;
    }

    if root.selected:
    Icon {
        x: parent.width - 34px;
        y: (parent.height - self.size) / 2;
        size: 20px;
        glyph: Glyph.selected;
        variant: Variant.filled;
        tint: Theme.brand;
    }

    Rectangle {
        x: 16px;
        y: root.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.border;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            AppState.lang = root.code;
            AppState.select-language(root.code);
            AppState.pop-sub();
        }
    }
}

export component LanguagePickerView inherits Rectangle {
    width: 100%;
    height: 100%;
        background: Theme.bg;

    Header {
        name: @tr("Language");
    }

    Rectangle {
        x: 8px;
        y: 56px;
        width: parent.width - 16px;
        height: parent.height - 56px;
        border-radius: 10px;
        background: Theme.surface;

        LangRow {
            y: 0px;
            code: "en";
            label: "English";
            selected: AppState.lang == "en";
        }
        LangRow {
            y: 52px;
            code: "zh_CN";
            label: "中文";
            selected: AppState.lang == "zh_CN";
        }
        LangRow {
            y: 104px;
            code: "de";
            label: "Deutsch";
            selected: AppState.lang == "de";
        }
        LangRow {
            y: 156px;
            code: "fr";
            label: "français";
            selected: AppState.lang == "fr";
        }
        LangRow {
            y: 208px;
            code: "ru";
            label: "русский";
            selected: AppState.lang == "ru";
        }
        LangRow {
            y: 260px;
            code: "es";
            label: "Español";
            selected: AppState.lang == "es";
        }
        LangRow {
            y: 312px;
            code: "ar";
            label: "العربية";
            selected: AppState.lang == "ar";
        }
        LangRow {
            y: 364px;
            code: "ja";
            label: "日本語";
            selected: AppState.lang == "ja";
        }
    }
}
