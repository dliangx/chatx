import {
    SubPageType,
    ContactRow,
    LetterEntry,
    FriendRequestRow,
    AppState,
} from "../components/app_state.slint";
import { ContactListItem } from "../components/item.slint";
import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search.slint";

component FriendRequestRowView inherits Rectangle {
    in property <int> key: 0;
    in property <string> name: "";
    in property <string> time-label: "";
    width: 100%;
    height: 56px;
    background: #f7f8fa;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: 100%;
        background: Theme.brand;
    }

    Rectangle {
        x: 12px;
        y: 12px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: #dfe3ee;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "+";
            font-size: 20px;
            font-weight: 800;
            color: Theme.brand;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 56px;
        y: 10px;
        width: parent.width - 56px - 168px;
        text: root.name;
        font-size: 14px;
        font-weight: 800;
        color: Theme.fg;
        overflow: elide;
        vertical-alignment: center;
    }

    Text {
        x: 56px;
        y: 30px;
        width: parent.width - 56px - 168px;
        text: @tr("New add request · {}", root.time-label);
        font-size: 11px;
        color: Theme.fg-muted;
        overflow: elide;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 150px;
        y: 17px;
        width: 64px;
        height: 22px;
        border-radius: 11px;
        border-width: 1px;
        border-color: #d5d8e4;
        background: #ffffff;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: @tr("Decline");
            font-size: 12px;
            color: Theme.fg-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { AppState.reject-friend-request(root.key); }
        }
    }

    Rectangle {
        x: parent.width - 78px;
        y: 17px;
        width: 64px;
        height: 22px;
        border-radius: 11px;
        background: Theme.brand;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: @tr("Accept");
            font-size: 12px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { AppState.accept-friend-request(root.key); }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height;
        width: 100%;
        height: 1px;
        background: #ececec;
    }
}

export component ContactListView inherits Rectangle {
    in property <[ContactRow]> rows: [];
    in property <[LetterEntry]> letters: [];
    in property <[FriendRequestRow]> requests: [];
    in-out property <int> selected-key: -1;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> row-h: 52px;
    out property <length> req-h: 56px;
    out property <length> bar-w: 28px;
    out property <length> list-top: 48px;
    out property <length> req-block-h: root.requests.length * root.req-h;
    out property <length> bottom: AppState.is-mobile ? 58px : 0px;

    SearchBar {
        y: 0px;
    }

    if root.requests.length > 0:
    Text {
        x: 12px;
        y: root.list-top - 2px;
        text: @tr("Add request");
        font-size: 12px;
        font-weight: 800;
        color: Theme.fg-muted;
        vertical-alignment: center;
        height: 18px;
    }

    for fq[i] in root.requests: FriendRequestRowView {
        x: 0px;
        y: root.list-top + 18px + root.req-h * i;
        width: parent.width;
        key: fq.key;
        name: fq.name;
        time-label: fq.time-label;
    }

    if root.requests.length == 0 && root.rows.length == 0:
    Text {
        y: 180px;
        width: parent.width;
        text: @tr("No contacts yet. They'll appear here once added.");
        color: #9aa0b4;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    fk := Flickable {
        x: 0px;
        y: root.list-top + 18px + root.req-block-h;
        width: parent.width;
        height: parent.height - root.list-top - 18px - root.req-block-h - root.bottom;
        content-height: root.rows.length * root.row-h;
        interactive: true;

        for r[i] in root.rows: ContactListItem {
            x: 0px;
            y: root.row-h * i;
            width: parent.width;
            height: root.row-h;
            id: r.id;
            image: r.image;
            peer_id: r.peer_id;
            title: r.name;
            selected: r.id == root.selected-key;

            clicked => {
                root.selected-key = r.id;
                AppState.push-sub(SubPageType.ContactProfile, r.id);
            }
        }
    }

    for le[j] in root.letters: Rectangle {
        x: parent.width - root.bar-w - 8px;
        y: root.list-top + 18px + root.req-block-h + 6px + j * ((parent.height - root.list-top - 18px - root.req-block-h - root.bottom - 12px) / root.letters.length);
        width: root.bar-w;
        height: (parent.height - root.list-top - 18px - root.req-block-h - root.bottom - 12px) / root.letters.length;
        background: transparent;

        out property <bool> active:
            (-fk.content-y >= root.letters[j].target * root.row-h) &&
            (j == root.letters.length - 1 || -fk.content-y < root.letters[j + 1].target * root.row-h);

        Rectangle {
            visible: AppState.is-mobile && parent.active;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.width;
            background: Theme.brand;
            border-radius: parent.width / 2;
        }

        Text {
            x: 0px;
            y: 0px;
            visible: AppState.is-mobile;
            width: parent.width;
            height: parent.height;
            text: le.letter;
            color: parent.active ? white : Theme.brand;
            font-size: parent.active ? 14px : 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { fk.content-y = -(root.row-h * le.target); }
        }
    }
}
