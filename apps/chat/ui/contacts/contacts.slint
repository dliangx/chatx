import { ScrollView, VerticalBox } from "std-widgets.slint";
import { SubPageType } from "../components/nav_state.slint";
import { ContactListItem } from "../components/item.slint";
import { Theme } from "../theme.slint";

export struct ContactRow {
    id: int,
    peer_id: string,
    name: string,
}

export component ContactListView inherits Rectangle {
    in property <[ContactRow]> rows: [];

    width: 100%;
    height: 100%;
    background: Theme.bg;
    callback navigate-to(SubPageType, int);

    if root.rows.length == 0:
    Text {
        y: 180px;
        text: "暂无联系人，添加后会出现在这里";
        color: #9aa0b4;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    ScrollView {
        width: 100%;

        VerticalBox {
            width: 100%;
            spacing: 0px;

            for row[i] in root.rows: ContactListItem {
                width: parent.width;
                height: 56px;
                id: row.id;
                peer_id: row.peer_id;
                title: row.name;

                clicked => { root.navigate-to(SubPageType.ContactProfile, row.id); }
            }
        }
    }
}
