import {
    SubPageType,
    ContactRow,
    LetterEntry,
    AppState,
} from "../components/app_state.slint";
import { ContactListItem } from "../components/item.slint";
import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search.slint";

export component ContactListView inherits Rectangle {
    in property <[ContactRow]> rows: [];
    in property <[LetterEntry]> letters: [];
    in-out property <int> selected-key: -1;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> row-h: 52px;
    out property <length> bar-w: 28px;
    out property <length> list-top: 48px;
    out property <length> bottom: AppState.is-mobile ? 58px : 0px;

    SearchBar {
        y: 0px;
    }

    if root.rows.length == 0:
    Text {
        y: 180px;
        width: parent.width;
        text: "暂无联系人，添加后会出现在这里";
        color: #9aa0b4;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    fk := Flickable {
        x: 0px;
        y: root.list-top;
        width: parent.width;
        height: parent.height - root.list-top - root.bottom;
        content-height: root.rows.length * root.row-h;
        interactive: true;

        for r[i] in root.rows: ContactListItem {
            x: 0px;
            y: root.row-h * i;
            width: parent.width;
            height: root.row-h;
            id: r.id;
            image: r.image;
            peer_id: r.peer_id;
            title: r.name;
            selected: r.id == root.selected-key;

            clicked => {
                root.selected-key = r.id;
                AppState.push-sub(SubPageType.ContactProfile, r.id);
            }
        }
    }

    for le[j] in root.letters: Rectangle {
        x: parent.width - root.bar-w - 8px;
        y: root.list-top + 6px + j * ((parent.height - root.list-top - root.bottom - 12px) / root.letters.length);
        width: root.bar-w;
        height: (parent.height - root.list-top - root.bottom - 12px) / root.letters.length;
        background: transparent;

        out property <bool> active:
            (-fk.content-y >= root.letters[j].target * root.row-h) &&
            (j == root.letters.length - 1 || -fk.content-y < root.letters[j + 1].target * root.row-h);

        Rectangle {
            visible: AppState.is-mobile && parent.active;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.width;
            background: Theme.brand;
            border-radius: parent.width / 2;
        }

        Text {
            x: 0px;
            y: 0px;
            visible: AppState.is-mobile;
            width: parent.width;
            height: parent.height;
            text: le.letter;
            color: parent.active ? white : Theme.brand;
            font-size: parent.active ? 14px : 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { fk.content-y = -(root.row-h * le.target); }
        }
    }
}
