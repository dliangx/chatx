import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { ProfileItem } from "../components/item.slint";
import {
    SubPageType,
    AppState,
    SearchUser,
} from "../components/app_state.slint";

component ResultRow inherits Rectangle {
    in property <string> name;
    in property <string> username;
    in property <string> peer_id;
    in property <bool> is_local;
    width: 100%;
    height: 132px;
    background: Theme.bg;

    ProfileItem {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 100px;
        name: root.name;
        nickname: root.is_local ? @tr("Add via QR scan") : root.username;
        peer-id: root.peer_id;
        edit-visible: false;
        show-qr(peer) => { AppState.show-qr-code(peer); }
    }

    Rectangle {
        x: 0px;
        y: 100px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    Text {
        x: 16px;
        y: 100px;
        width: parent.width - 120px;
        height: 32px;
        text: @tr("Add to contacts");
        font-size: 14px;
        color: Theme.fg-muted;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 100px;
        y: 105px;
        width: 84px;
        height: 22px;
        border-radius: 11px;
        background: Theme.brand;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: @tr("Add");
            font-size: 13px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { AppState.add-contact(root.username, root.peer_id); }
        }
    }
}

export component AddContactView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    Header {
        name: @tr("Add Member");
    }

    Rectangle {
        x: 16px;
        y: 60px;
        width: parent.width - 32px;
        height: 40px;
        border-radius: 8px;
        background: Theme.surface-2;

        Icon {
            x: 10px;
            y: (parent.height - self.size) / 2;
            size: 18px;
            glyph: Glyph.search;
            tint: Theme.fg-muted;
        }

        input := TextInput {
            x: 38px;
            y: 0px;
            width: parent.width - 38px;
            height: parent.height;
            font-size: 15px;
            color: Theme.fg;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.brand;
            selection-foreground-color: white;
            accepted => {
                let q = input.text;
                if (q != "") {
                    AppState.search-users(q);
                }
            }
        }
    }

    if AppState.search-results.length == 0 && AppState.add-status == "":
    Text {
        x: 16px;
        y: 110px;
        width: parent.width - 32px;
        text: @tr("Enter a username or a scanned Peer ID to look up a user on the server");
        font-size: 13px;
        color: Theme.fg-muted;
    }

    if AppState.add-status != "":
    Text {
        x: 16px;
        y: 110px;
        width: parent.width - 32px;
        text: AppState.add-status;
        font-size: 13px;
        color: Theme.success-deep;
    }

    Flickable {
        x: 0px;
        y: 132px;
        width: parent.width;
        height: parent.height - 132px - (AppState.is-mobile ? 58px : 0px);
        interactive: true;
        content-height: AppState.search-results.length * 132px;

        for r[i] in AppState.search-results: ResultRow {
            x: 0px;
            y: 132px * i;
            width: parent.width;
            height: 132px;
            name: r.name;
            username: r.username;
            peer_id: r.peer_id;
            is_local: r.username == "";
        }
    }
}
