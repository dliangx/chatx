import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import {
    AppState,
    ContactRow,
    GroupMemberRow,
} from "../components/app_state.slint";

export struct Row {
    peer_id: string,
    username: string,
}

export global AddGroupState {
    in property <[Row]> selected-rows;

    callback open-group-conversation();
    callback start-video-call();
    callback start-screen-share();
}

component MemberRow inherits Rectangle {
    in property <string> name;
    in property <image> image;
    in property <bool> is-self: false;

    background: Theme.surface;
    opacity: 0.85;

    Rectangle {
        x: 12px;
        y: (parent.height - 36px) / 2;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: Theme.surface-2;

        Image {
            source: root.image;
        }
    }

    Text {
        x: 60px;
        width: parent.width - 132px;
        text: root.name;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
        color: Theme.fg-muted;
        overflow: elide;
    }

    Text {
        x: parent.width - 72px;
        width: 60px;
        text: root.is-self ? @tr("You") : @tr("Member");
        font-size: 12px;
        color: Theme.fg-muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        x: 12px;
        y: 56px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

component CRow inherits Rectangle {
    in property <string> name;
    in property <image> image;
    in property <string> peer-id;
    in-out property <bool> checked: false;
    callback toggled(bool);

    background: Theme.surface;

    Rectangle {
        x: 12px;
        y: (parent.height - 36px) / 2;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: Theme.surface-2;

        Image {
            source: root.image;
        }
    }

    Text {
        x: 60px;
        width: parent.width - 116px;
        text: root.name;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
        color: Theme.fg;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 52px;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: root.checked ? Theme.brand : Theme.surface;
        border-width: 1px;
        border-color: root.checked ? Theme.brand : Theme.disabled;

        if root.checked:
        Icon {
            x: 3px;
            y: 2px;
            size: 16px;
            glyph: Glyph.selected;
            tint: white;
        }
    }

    TouchArea {
        x: 44px;
        y: 0px;
        width: parent.width - 44px;
        height: 100%;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        x: 12px;
        y: 56px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}

export component AddGroupView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    in property <int> group-type;
    in-out property <int> count: 0;

    out property <bool> has-selection: root.count > 0;
    out property <bool> is-add: group-type == 3;
    out property <length> existing-section-h:
        root.is-add ? 24px + AppState.existing-members.length * 48px + 16px : 0px;
    out property <length> contact-y: 84px + root.existing-section-h;

    if root.is-add:
    Header {
        name: @tr("Add members");
    }
    if !root.is-add && group-type == 0:
    Header {
        name: @tr("Add Group");
    }
    if !root.is-add && group-type == 1:
    Header {
        name: @tr("Start Meeting");
    }
    if !root.is-add && group-type == 2:
    Header {
        name: @tr("Screen Share");
    }

    // In add mode: "already in this group" section above the contact list so
    // the user can see existing members (with their icons) but they cannot be
    // re-selected.
    if root.is-add:
    Text {
        x: 16px;
        y: 74px;
        width: parent.width - 32px;
        text: @tr("Already in this group");
        font-size: 12px;
        color: Theme.fg-muted;
    }

    Rectangle {
        x: 0px;
        y: 98px;
        width: parent.width;
        height: AppState.existing-members.length * 48px;
        clip: true;

        for m[i] in AppState.existing-members: MemberRow {
            x: 0px;
            y: 48px * i;
            width: parent.width;
            height: 48px;
            name: m.name;
            image: m.image;
            is-self: m.is-self;
        }
    }

    if !root.is-add:
    Text {
        x: 16px;
        y: 58px;
        text: @tr("Select group members (multiple allowed)");
        font-size: 13px;
        color: Theme.fg-muted;
    }

    if !root.is-add && AppState.contacts.length == 0:
    Text {
        x: 0px;
        y: 240px;
        width: parent.width;
        text: @tr("No contacts yet. Add some before creating a group.");
        color: Theme.fg-muted;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if AppState.group-status != "":
    Rectangle {
        x: 8px;
        y: 84px;
        width: parent.width - 16px;
        height: 44px;
        border-radius: 8px;
        background: Theme.danger-soft;

        Text {
            x: 8px;
            y: 0;
            width: parent.width - 16px;
            height: 100%;
            text: AppState.group-status;
            font-size: 13px;
            color: Theme.danger;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    out property <length> row-h: 48px;

    Flickable {
        x: 0px;
        y: root.contact-y;
        width: parent.width;
        height: parent.height - root.contact-y - 64px;
        content-height: AppState.contacts.length * root.row-h;
        interactive: true;

        for row[i] in AppState.contacts: CRow {
            x: 0px;
            y: root.row-h * i;
            width: parent.width;
            height: root.row-h;
            name: row.name;
            image: row.image;
            peer-id: row.peer_id;
            toggled(sel) => {
                if sel {
                    AppState.pick-group-member(row.id);
                } else {
                    AppState.unpick-group-member(row.id);
                }
                root.count = sel ? root.count + 1 : root.count - 1;
            }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 64px;
        width: 100%;
        height: 64px;
        background: Theme.surface;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        Text {
            x: 16px;
            y: 0px;
            width: parent.width - 160px;
            height: 100%;
            text: root.has-selection ? @tr("Members selected") : @tr("No members selected yet");
            font-size: 14px;
            color: Theme.fg-muted;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 136px;
            y: 16px;
            width: 120px;
            height: 32px;
            border-radius: 6px;
            background: root.has-selection ? Theme.brand : Theme.brand-tint;

            Text {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;

                text: root.is-add ? @tr("Add to group")
                    : (group-type == 0 ? @tr("Create group")
                    : (group-type == 1 ? @tr("Video meeting")
                    : (group-type == 2 ? @tr("Screen sharing") : "")));
                font-size: 14px;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.has-selection;
                clicked => {
                    if root.is-add {
                        AppState.add-group-member();
                    } else {
                        AppState.create-group();
                    }
                }
            }
        }
    }
}
