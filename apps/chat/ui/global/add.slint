import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import {
    SubPageType,
    GlobalOverlayType,
    AppState,
} from "../components/app_state.slint";

component MenuRow inherits Rectangle {
    in property <Glyph> icon;
    in property <string> label;
    callback clicked();
    height: 44px;

    Icon {
        x: 12px;
        y: (parent.height - self.size) / 2;
        size: 18px;
        glyph: root.icon;
        tint: Theme.fg;
    }

    Text {
        x: 40px;
        width: parent.width - 52px;
        height: 100%;
        text: root.label;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component AddMenuView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;
    clip: true;

    function calcx() -> length {
        if AppState.add-menu-type == 1 {
            return AppState.xp - 176px - 8px;
        }
        return (AppState.is-mobile ? root.width : 340px) - 176px - 8px;
    }

    function calcHeight() -> int {
        if AppState.is-mobile {
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2 {
                return 3;
            } else if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2 {
                return 5;
            }
        } else {
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2 {
                return 2;
            } else if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2 {
                return 4;
            }
        }
        if AppState.add-menu-type == 1 {
            return 2;
        }
        return 0;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; }
    }

    Rectangle {
        width: 176px;
        height: calcHeight() * 44px + 8px;
        x: calcx();
        y: 56px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000033;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 4px;
            spacing: 0px;

            if AppState.is-mobile && AppState.add-menu-type == 0:
            MenuRow {
                icon: Glyph.scan;
                label: "扫描";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.QrScanner; }
            }

            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2:
            MenuRow {
                icon: Glyph.fill;
                label: "笔记";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddNote, 0); }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2:
            MenuRow {
                icon: Glyph.picture;
                label: "分享此刻";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddMoment, 0); }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.friends-add;
                label: "添加朋友";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddContact, 0); }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.add-circle;
                label: "新建群聊";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddGroup, 0); }
            }
            if  AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.video;
                label: "音/视频会议";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddGroup, 1); }
            }
            if  AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.meeting;
                label: "桌面共享";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddGroup, 2); }
            }
            if  AppState.add-menu-type == 1:
            MenuRow {
                icon: Glyph.video;
                label: "音/视频通话";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.VideoCall; }
            }
            if  AppState.add-menu-type == 1:
            MenuRow {
                icon: Glyph.meeting;
                label: "桌面共享";
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.ScreenShare; }
            }
        }
    }
}
