import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import {
    SubPageType,
    GlobalOverlayType,
    AppState,
} from "../components/app_state.slint";
import { ProfileState } from "../contacts/profile.slint";

component MenuRow inherits Rectangle {
    in property <Glyph> icon;
    in property <string> label;
    in-out property <bool> long-press: false;
    in-out property <duration> hold-ms: 3000ms;
    out property <bool> armed: false;
    out property <bool> suppress: false;
    callback clicked();
    callback long-pressed();
    height: 44px;

    Icon {
        x: 12px;
        y: (parent.height - self.size) / 2;
        size: 18px;
        glyph: root.icon;
        tint: root.armed ? Theme.brand : Theme.fg;
    }

    Text {
        x: 40px;
        width: parent.width - 52px;
        height: 100%;
        text: root.label;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (root.suppress) {
                root.suppress = false;
            } else {
                root.clicked();
            }
        }
        changed pressed => {
            if (!self.pressed) {
                root.armed = false;
            }
        }
    }

    Timer {
        interval: root.hold-ms;
        running: root.long-press && ta.pressed && !root.armed;
        triggered => {
            root.armed = true;
            root.suppress = true;
            root.long-pressed();
        }
    }
}

export component AddMenuView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;
    clip: true;

    function calcx() -> length {
        if AppState.add-menu-type == 1 {
            return AppState.xp - 176px - 8px;
        }
        return (AppState.is-mobile ? root.width : 340px) - 176px - 8px;
    }

    function calcHeight() -> int {
        if AppState.is-mobile {
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2 {
                return 3;
            } else if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2 {
                return 5;
            }
        } else {
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2 {
                return 2;
            } else if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2 {
                return 4;
            }
        }
        if AppState.add-menu-type == 1 {
            return 2;
        }
        return 0;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; }
    }

    Rectangle {
        width: 176px;
        height: calcHeight() * 44px + 8px;
        x: calcx();
        y: 56px;
        border-radius: 8px;
        background: Theme.surface;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.overlay;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 4px;
            spacing: 0px;

            if AppState.is-mobile && AppState.add-menu-type == 0:
            MenuRow {
                icon: Glyph.scan;
                label: @tr("Scan");
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.QrScanner; }
            }

            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2:
            MenuRow {
                icon: Glyph.fill;
                label: @tr("Note");
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddNote, 0); }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab == 2:
            MenuRow {
                icon: Glyph.picture;
                label: @tr("Share a moment");
                long-press: true;
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.Camera; }
                long-pressed => {
                    AppState.nav-state.global-overlay = GlobalOverlayType.None;
                    AppState.push-sub(SubPageType.AddMoment, 1);
                }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.friends-add;
                label: @tr("Add friend");
                clicked => {
                    AppState.nav-state.global-overlay = GlobalOverlayType.None;
                    AppState.push-sub(SubPageType.AddContact, 0);
                    AppState.add-status = "";
                    AppState.search-results = [];
                }
            }
            if AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.add-circle;
                label: @tr("New group");
                clicked => {
                    AppState.nav-state.global-overlay = GlobalOverlayType.None;
                    AppState.push-sub(SubPageType.AddGroup, 0);
                    AppState.group-picked = [];
                }
            }
            if  AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.video;
                label: @tr("Video meeting");
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddGroup, 1); }
            }
            if  AppState.add-menu-type == 0 && AppState.nav-state.active-tab < 2:
            MenuRow {
                icon: Glyph.meeting;
                label: @tr("Screen sharing");
                clicked => { AppState.nav-state.global-overlay = GlobalOverlayType.None; AppState.push-sub(SubPageType.AddGroup, 2); }
            }
            if  AppState.add-menu-type == 1:
            MenuRow {
                icon: Glyph.video;
                label: @tr("Audio/video call");
                clicked => {
                    AppState.nav-state.global-overlay = GlobalOverlayType.None;
                    if AppState.current-chat-peer-key != -1 {
                        ProfileState.start-video-call(AppState.current-chat-peer-key);
                    }
                }
            }
            if  AppState.add-menu-type == 1:
            MenuRow {
                icon: Glyph.meeting;
                label: @tr("Screen sharing");
                clicked => {
                    AppState.nav-state.global-overlay = GlobalOverlayType.None;
                    if AppState.current-chat-peer-key != -1 {
                        ProfileState.start-screen-share(AppState.current-chat-peer-key);
                    }
                }
            }
        }
    }
}
