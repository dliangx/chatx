import { GlobalOverlayType, AppState } from "../components/app_state.slint";
import { Icon, Glyph } from "../components/icon.slint";

export component ScanView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000;
    clip: true;

    in-out property <bool> bootstrapped: false;

    Timer {
        interval: 16ms;
        running: !root.bootstrapped;
        triggered => {
            if (!root.bootstrapped && !AppState.scan-found) {
                AppState.scanner-start();
            }
            root.bootstrapped = true;
            root.scan-line-pos = 232px;
        }
    }

    // Live camera preview. The black `background` behind it is the "no
    // camera / no preview frame yet" state.
    Image {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        source: AppState.scan-preview;
        image-fit: cover;
    }

    in-out property <length> scan-line-pos: 6px;

    Timer {
        interval: 2400ms;
        running: true;
        triggered => {
            root.scan-line-pos = root.scan-line-pos >= 232px ? 6px : 232px;
        }
    }

    Rectangle {
        x: 16px;
        y: 28px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: #ffffff2a;

        Icon {
            x: 7px;
            y: 7px;
            glyph: Glyph.close-circle;
            size: 18px;
            tint: #ffffff;
        }

        TouchArea {
            width: 32px;
            height: 32px;
            clicked => {
                AppState.scanner-stop();
                AppState.nav-state.global-overlay = GlobalOverlayType.None;
            }
        }
    }

    Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: 32px;
        text: @tr("Scan");
        font-size: 17px;
        font-weight: 600;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: (parent.width - 240px) / 2;
        y: (parent.height - 240px) / 2;
        width: 240px;
        height: 240px;
        visible: !AppState.scan-found;
        clip: true;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: 26px;
            background: #ffffff;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: 26px;
            height: 3px;
            background: #ffffff;
        }

        Rectangle {
            x: 237px;
            y: 0px;
            width: 3px;
            height: 26px;
            background: #ffffff;
        }

        Rectangle {
            x: 214px;
            y: 0px;
            width: 26px;
            height: 3px;
            background: #ffffff;
        }

        Rectangle {
            x: 0px;
            y: 214px;
            width: 3px;
            height: 26px;
            background: #ffffff;
        }

        Rectangle {
            x: 0px;
            y: 237px;
            width: 26px;
            height: 3px;
            background: #ffffff;
        }

        Rectangle {
            x: 237px;
            y: 214px;
            width: 3px;
            height: 26px;
            background: #ffffff;
        }

        Rectangle {
            x: 214px;
            y: 237px;
            width: 26px;
            height: 3px;
            background: #ffffff;
        }

        Rectangle {
            x: 6px;
            y: root.scan-line-pos;
            width: parent.width - 12px;
            height: 2px;
            background: #09bb07;
            animate y {
                duration: 2.4s;
                easing: ease-in-out;
            }
        }
    }

    if !AppState.scan-found:
    Text {
        x: 0px;
        y: (parent.height - 240px) / 2 + 270px;
        width: parent.width;
        text: AppState.scan-status;
        font-size: 14px;
        color: #ffffffcc;
        horizontal-alignment: center;
    }
}
