/// Single source of truth for the active call (audio / video / screen).
/// One active call per device.
export global CallState {
    in property <string> peer-base58: "";
    in property <string> peer-name: "";
    in property <string> status: "正在呼叫…";
    in property <bool> active: false;
    in property <bool> muted: false;
    /// Latest decoded peer camera frame (H.264 → RGBA8888), or empty.
    in property <image> remote-camera;
    /// Latest decoded peer screen frame (H.264 → RGBA8888), or empty.
    in property <image> remote-screen;
    /// Local camera preview (RGBA8888, mirror of "me"), or empty.
    in property <image> local-camera;
    /// Whether we have a local camera to preview (gates the PIP).
    in property <bool> has-local-camera: false;
    /// Start a call to the given contact key (the same `ContactRow.id`).
    callback start-call(int);
    /// Hang up the active call.
    callback end-call();
    /// Toggle local mic mute.
    callback toggle-mute();
}

export component AudioCallView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0b0e14;

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-top: 72px;
        padding-bottom: 72px;

        Rectangle {
            width: 96px;
            height: 96px;
            border-radius: 48px;
            background: #1e2530;
            Text {
                text: CallState.peer-name;
                font-size: 28px;
                color: #cfd8e3;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
                height: 100%;
            }
        }

        Text {
            text: CallState.peer-name;
            font-size: 22px;
            color: #f0f3f7;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 240px;
        }

        Text {
            text: CallState.status;
            font-size: 13px;
            color: #8b95a3;
            horizontal-alignment: center;
        }

        Text {
            text: "语音通话";
            font-size: 12px;
            color: #556070;
            horizontal-alignment: center;
        }

        Text {
            text: CallState.peer-base58;
            font-size: 10px;
            color: #4a5568;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 240px;
        }

        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: #ff4545;
            Text {
                text: "挂断";
                color: #ffffff;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            TouchArea {
                clicked => { CallState.end-call(); }
            }
        }

        Text {
            text: "点击红色按钮结束通话";
            font-size: 11px;
            color: #6b7280;
            horizontal-alignment: center;
        }
    }
}
