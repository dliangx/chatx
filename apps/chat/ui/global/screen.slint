import { GlobalOverlayType, AppState } from "../components/app_state.slint";
import { CallState } from "audio_call.slint";

/// Screen-share call overlay: shows the peer's screen full-size, with the
/// caller name and an "end share" button.
export component ScreenShareView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #0b0e14;

    // Far-end screen (full screen).
    Image {
        source: CallState.remote-screen;
        width: 100%;
        height: 100%;
    }

    // Centered vertical layout: caller label + "end" button.
    VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding-top: 200px;
        padding-bottom: 200px;
        Text {
            text: "屏幕共享 — " + CallState.peer-name;
            font-size: 18px;
            color: #f0f3f7;
            horizontal-alignment: center;
        }
        Rectangle {
            width: 88px;
            height: 46px;
            border-radius: 23px;
            background: #ff4545;
            Text {
                text: "结束共享";
                color: #ffffff;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            TouchArea {
                clicked => { CallState.end-call(); }
            }
        }
    }
}
