import { Icon, Glyph } from "../components/icon.slint";
export global CallState {
    in property <string> peer-base58: "";
    in property <string> peer-name: "";
    in property <string> status: @tr("Calling…");
    in property <string> error-message: "";
    in property <bool> active: false;
    /// True while an inbound offer is awaiting the user's Accept/Decline.
    /// Once the user accepts, `answer_offer` flips this to false and the
    /// call transitions to the connected / ringing (outbound) state.
    in property <bool> ringing: false;
    /// True once the peer has actually answered (WebRTC `Connected`). Before
    /// this the call is still in the ringing state — controls must stay visible so the
    /// caller can hang up.
    in property <bool> connected: false;
    /// True while the call is minimized into the top-right widget.
    in property <bool> minimized: false;

    // ── device state (local) ──────────────────────────────────────
    in property <bool> muted: false;      // my mic muted
    in property <bool> audio-muted: false; // my speaker muted (remote audio off)
    in property <bool> cam-on: false;     // my camera on
    in property <bool> scr-on: false;     // my screen on

    // ── four image sources (Rust sets these directly) ─────────────
    in property <image> my-cam;
    in property <image> my-scr;
    in property <image> remote-cam;
    in property <image> remote-scr;
    in property <bool> has-my-cam: false;
    in property <bool> has-my-scr: false;
    in property <bool> has-remote-cam: false;
    in property <bool> has-remote-scr: false;
    /// A↔B orientation. false → A=me, B=peer. true → A=peer, B=me.
    in property <bool> swapped: false;

    // ── minimized floating widget position (draggable) ─────────────
    /// Stored position of the minimized widget once the user has dragged it.
    in-out property <length> min-x: 16px;
    in-out property <length> min-y: 16px;
    /// False until first drag → the widget sits at the default top-right spot.
    in-out property <bool> min-pos-set: false;

    // ── bottom-control auto-hide ───────────────────────────────────
    /// True once the bottom control row has auto-hidden (3s after connect, or
    /// 3s after releasing image B). Holding image B (pointer down) keeps the
    /// row shown; a tap/hold on image B sets this false again to reveal it.
    in-out property <bool> controls-hidden: false;

    // ── callbacks ─────────────────────────────────────────────────
    callback end-call();
    callback toggle-mute();
    callback toggle-audio();
    callback toggle-cam();
    callback toggle-scr();
    callback swap-ab();
    callback toggle-minimize();
    /// Inbound only: user tapped ACCEPT. Rust calls `answer_offer`.
    callback accept-call();
    /// Inbound only: user tapped DECLINE. Rust sends a `Bye` frame and tears
    /// the call down.
    callback decline-call();
}

export component CallBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> on: false;
    in property <Glyph> glyph: Glyph.none;
    in property <Glyph> glyph-on: Glyph.none;
    in property <Glyph> glyph-off: Glyph.none;
    in property <brush> on-tint: #22c55e;
    in property <brush> off-tint: #eef1f5;
    in property <brush> bg: #2a3340;
    in property <brush> bg-on: #2a3340;
    callback clicked();

    function _glyph() -> Glyph {
        if (root.on) {
            if (root.glyph-on != Glyph.none) { return root.glyph-on; }
            return root.glyph;
        }
        if (root.glyph-off != Glyph.none) { return root.glyph-off; }
        return root.glyph;
    }

    width: 58px;
    height: 58px;
    border-radius: 29px;
    background: root.on ? root.bg-on : root.bg;
    clip: true;

    if root._glyph() != Glyph.none: Icon {
        x: 16px;
        y: 5px;
        size: 26px;
        glyph: root._glyph();
        tint: root.on ? root.on-tint : root.off-tint;
    }
    Text {
        x: 0px;
        y: 36px;
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.on ? root.on-tint : root.off-tint;
        font-size: 9px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: top;
        wrap: word-wrap;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Unified call overlay: A (small, top-left, tap to swap) + B (full screen),
/// the four always-on device buttons (MUTE / AUDIO / CAMERA / SCREEN), END,
/// and the minimize → maximize widget.
export component CallView inherits Rectangle {
    width: 100%;
    height: 100%;
    clip: true;
    background: CallState.minimized ? #00000000 : #0b0e14;

    // Which image each slot shows.
    function _my() -> image {
        return CallState.has-my-scr ? CallState.my-scr : CallState.my-cam;
    }
    function _peer() -> image {
        return CallState.has-remote-scr ? CallState.remote-scr : CallState.remote-cam;
    }
    function _me_present() -> bool {
        return CallState.has_my_cam || CallState.has_my_scr;
    }
    function _peer_present() -> bool {
        return CallState.has_remote_cam || CallState.has_remote_scr;
    }

    // A = small (top-left), B = full screen. When not swapped A=me / B=peer.
    property <bool> a-is-me: !CallState.swapped;

    // Internal drag tracking for the minimized floating widget.
    property <bool> min-drag: false;
    property <length> min-origin-x: 0px;
    property <length> min-origin-y: 0px;
    property <bool> pending-hide: false;
    property <bool> was-connected: false;

    // Reveal the bar + arm the 3s auto-hide once the call is CONNECTED
    // (peer answered). Stays visible while still calling (not connected).
    Timer {
        interval: 16ms;
        running: CallState.connected && !root.was-connected;
        triggered => {
            root.was-connected = true;
            CallState.controls-hidden = false;
            root.pending-hide = true;
        }
    }

    // Reset when the call ends.
    Timer {
        interval: 16ms;
        running: !CallState.active;
        triggered => {
            root.was-connected = false;
            root.pending-hide = false;
            CallState.controls-hidden = false;
        }
    }

    // 3s countdown → hide. Only counts while connected.
    Timer {
        interval: 3000ms;
        running: root.pending-hide && CallState.connected && !CallState.minimized;
        triggered => {
            root.pending-hide = false;
            CallState.controls-hidden = true;
        }
    }

    // Helper: the minimized widget's effective top-left. Default is the
    // top-right corner (computed against the window's physical width) until
    // the user drags it — then we use the stored CallState position.
    function _minx() -> length {
        if (CallState.min-pos-set) { return CallState.min-x; }
        return root.width - 172px - 16px;
    }
    function _miny() -> length {
        if (CallState.min-pos-set) { return CallState.min-y; }
        return 16px;
    }

    // ── B : full screen ────────────────────────────────────────────
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        clip: true;
        visible: !CallState.minimized;
        background: #0b0e14;
        Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.a-is-me ? _peer() : _my();
        }
        // Holding this surface reveals the bottom control row; on release
        // the 3s auto-hide timer re-arms.
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    CallState.controls-hidden = false;
                    root.pending-hide = false;
                } else if (e.kind == PointerEventKind.up
                    || e.kind == PointerEventKind.cancel) {
                    CallState.controls-hidden = false;
                    if (CallState.connected && !CallState.minimized) {
                        root.pending-hide = true;
                    }
                }
            }
        }
    }

    // ── A : small, top-left, tap to swap ───────────────────────────
    Rectangle {
        x: 18px;
        y: 96px;
        width: 150px;
        height: 94px;
        border-radius: 10px;
        background: #141821;
        clip: true;
        visible: !CallState.minimized && (root.a-is-me ? _me_present() : _peer_present());
        Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.a-is-me ? _my() : _peer();
        }

        TouchArea {
            clicked => { CallState.swap-ab(); }
        }
    }

    // ── HEADER ─────────────────────────────────────────────────────
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 92px;
        visible: !CallState.minimized;

        Text {
            x: 0px;
            y: 26px;
            width: 100%;
            text: CallState.peer-name;
            horizontal-alignment: center;
            font-size: 22px;
            font-weight: 600;
            color: #f0f3f7;
            wrap: word-wrap;
            max-width: 300px;
        }

        Text {
            x: 0px;
            y: 56px;
            width: 100%;
            text: CallState.ringing ? @tr("Incoming") : CallState.status;
            horizontal-alignment: center;
            font-size: 13px;
            color: #8b95a3;
        }

        // MINIMIZE (top-right)
        Rectangle {
            x: parent.width - 58px;
            y: 22px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #2a3340;
            visible: !CallState.ringing;
            Icon {
                x: 10px;
                y: 10px;
                size: 24px;
                glyph: Glyph.minimize;
                tint: #eaeef3;
            }

            TouchArea {
                clicked => { CallState.toggle-minimize(); }
            }
        }
    }

    // ── CONTROL BAR ────────────────────────────────────────────────
    // When `ringing` (inbound offer awaiting accept/decline), show the
    // two decision buttons instead of the live-call device controls.
    Rectangle {
        x: 0px;
        y: parent.height - 218px;
        width: 100%;
        height: 190px;
        visible: !CallState.minimized && !CallState.controls-hidden;

        // ── RINGING : ACCEPT + DECLINE ─────────────────────────────
        HorizontalLayout {
            y: 72px;
            alignment: center;
            spacing: 40px;
            visible: CallState.ringing;

            // DECLINE (red).
            Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: #ff4545;
                Icon {
                    x: 25px;
                    y: 25px;
                    size: 26px;
                    glyph: Glyph.close;
                    tint: #ffffff;
                }

                TouchArea {
                    clicked => { CallState.decline-call(); }
                }
            }

            // ACCEPT (green).
            Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: #22c55e;
                Icon {
                    x: 25px;
                    y: 25px;
                    size: 26px;
                    glyph: Glyph.call;
                    tint: #ffffff;
                }

                TouchArea {
                    clicked => { CallState.accept-call(); }
                }
            }
        }

        // ── LIVE : device buttons ───────────────────────────────────
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            visible: !CallState.ringing;

            // Four always-on device buttons.
            HorizontalLayout {
                y: 6px;
                alignment: center;
                spacing: 10px;

                CallBtn {
                    label: @tr("VOICE");
                    on: !CallState.muted;
                    glyph-on: Glyph.voice;
                    glyph-off: Glyph.voice-close;
                    clicked => { CallState.toggle-mute(); }
                }

                CallBtn {
                    label: @tr("AUDIO");
                    on: !CallState.audio-muted;
                    glyph-on: Glyph.volume;
                    glyph-off: Glyph.volume-close;
                    clicked => { CallState.toggle-audio(); }
                }

                CallBtn {
                    label: @tr("CAMERA");
                    on: CallState.cam-on;
                    glyph: Glyph.video;
                    clicked => { CallState.toggle-cam(); }
                }

                CallBtn {
                    label: @tr("SCREEN");
                    on: CallState.scr-on;
                    glyph: Glyph.meeting;
                    clicked => { CallState.toggle-scr(); }
                }
            }

            // END.
            Rectangle {
                x: (parent.width - 76px) / 2;
                y: 72px;
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: #ff4545;
                Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: @tr("END");
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { CallState.end-call(); }
                }
            }
        }
    }

    // ── ERROR ──────────────────────────────────────────────────────
    Text {
        x: 12px;
        y: 96px;
        width: parent.width - 24px;
        visible: CallState.error-message != "";
        text: CallState.error-message;
        horizontal-alignment: center;
        font-size: 11px;
        color: #ff8080;
    }

    // ── MINIMIZED WIDGET (draggable, floating over the main UI) ─────
    // A compact card: video thumbnail (left) + peer name (top-right) and
    // MAXIMIZE / END stacked vertically (bottom-right). Drag the card body
    // to reposition; MAXIMIZE restores the full overlay, END hangs up.
    Rectangle {
        x: _minx();
        y: _miny();
        width: 172px;
        height: 112px;
        border-radius: 16px;
        background: #2a3340;
        clip: true;
        z: 5;
        visible: CallState.minimized;

        // Video thumbnail (peer) — also the drag handle.
        Rectangle {
            x: 8px;
            y: 8px;
            width: 120px;
            height: 96px;
            border-radius: 8px;
            background: #0b0e14;
            clip: true;
            Image {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: _peer();
            }

            min-drag-ta := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.min-drag = true;
                        if (CallState.min-pos-set) {
                            root.min-origin-x = CallState.min-x;
                            root.min-origin-y = CallState.min-y;
                        } else {
                            // Fall back to the default top-right corner so
                            // the very first drag still anchors correctly.
                            root.min-origin-x = root.width - 172px - 16px;
                            root.min-origin-y = 16px;
                        }
                    } else if (e.kind == PointerEventKind.move) {
                        if (root.min-drag) {
                            CallState.min-pos-set = true;
                            CallState.min-x =
                                root.min-origin-x + (min-drag-ta.mouse-x - min-drag-ta.pressed-x);
                            CallState.min-y =
                                root.min-origin-y + (min-drag-ta.mouse-y - min-drag-ta.pressed-y);
                        }
                    } else if (e.kind == PointerEventKind.up
                        || e.kind == PointerEventKind.cancel) {
                        root.min-drag = false;
                    }
                }
            }
        }

        Text {
            x: 132px;
            y: 8px;
            width: 34px;
            text: CallState.peer-name;
            color: #f0f3f7;
            font-size: 10px;
            wrap: word-wrap;
            max-width: 34px;
        }

        // MAXIMIZE (restore) — top of the right-hand column.
        Rectangle {
            x: 134px;
            y: 34px;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: #3a4452;
            Icon {
                x: 6px;
                y: 6px;
                size: 18px;
                glyph: Glyph.fullscreen;
                tint: #eaeef3;
            }

            TouchArea {
                clicked => { CallState.toggle-minimize(); }
            }
        }

        // END (close call) — bottom of the right-hand column (directly under MAXIMIZE).
        Rectangle {
            x: 134px;
            y: 68px;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: #ff4545;
            TouchArea {
                clicked => { CallState.end-call(); }
            }
        }
    }
}
