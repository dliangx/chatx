import { Theme } from "../theme.slint";
import { AppState } from "../components/app_state.slint";

export component QrCodeView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000088;

    Rectangle {
        x: (parent.width - 240px) / 2;
        y: (parent.height - 300px) / 2;
        width: 240px;
        height: 300px;
        border-radius: 12px;
        background: #ffffff;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 16px;
            spacing: 8px;
            alignment: center;

            Text {
                width: 100%;
                text: "我的二维码";
                font-size: 16px;
                font-weight: 600;
                color: Theme.fg;
                horizontal-alignment: center;
            }

            Image {
                width: 200px;
                height: 200px;
                source: AppState.qr-image;
            }

            Text {
                width: 100%;
                text: AppState.qr-target-id != "" ? AppState.qr-target-id : AppState.peer-id;
                font-size: 11px;
                color: Theme.fg-muted;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { AppState.close-qr-code(); }
    }
}
