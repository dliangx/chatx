import { ChatListView } from "chats/chat_list.slint";
import { ContactListView } from "contacts/contacts.slint";
import { DiscoverView } from "discovery/discover.slint";
import { MeView } from "me/me.slint";
import { BottomNavBar } from "components/bottom_nav.slint";
import { LeftNavBar } from "components/left_nav.slint";
import { SubPageView } from "./subpage.slint";
import { AppHost, MiniAppOverlay } from "./x.slint";
export { AppHost } from "./x.slint";
import { PdfHost, PdfViewer } from "global/pdf.slint";
export { PdfHost } from "global/pdf.slint";
import { DocHost, DocViewer } from "global/doc.slint";
export { DocHost } from "global/doc.slint";
import { AuthView } from "components/auth.slint";
import { Theme } from "./theme.slint";
export { Theme } from "./theme.slint";
import {
    NavigationState,
    TabState,
    SubPageEntry,
    SubPageType,
    GlobalOverlayType,
    AppState,
} from "components/app_state.slint";
export {
    AppState,
} from "components/app_state.slint";
import { ProfileState } from "contacts/profile.slint";
export { ProfileState } from "contacts/profile.slint";
import { EditProfileState } from "me/edit.slint";
export { EditProfileState } from "me/edit.slint";
import { ChatSession } from "chats/chat.slint";
export { ChatSession } from "chats/chat.slint";
import { GroupState } from "chats/chat_setting.slint";
export { GroupState } from "chats/chat_setting.slint";
import { RecordState } from "global/record_state.slint";
export { RecordState } from "global/record_state.slint";
import { PostDetailState } from "discovery/discover_detail.slint";
export { PostDetailState } from "discovery/discover_detail.slint";
import { NoteState } from "discovery/note.slint";
export { NoteState } from "discovery/note.slint";
import { CameraView, CameraState } from "global/camera.slint";
export { CameraState } from "global/camera.slint";
import { ScanView } from "global/scan.slint";
import { ImageViewer } from "global/image.slint";
import { MomentState } from "discovery/moment.slint";
export { MomentState } from "discovery/moment.slint";
import { QrCodeView } from "global/qrcode.slint";
import { CallView, CallState } from "global/call.slint";
export { CallState } from "global/call.slint";
import { ErrorView } from "global/error.slint";
import { AddMenuView } from "global/add.slint";

export component MainWindow inherits Window {

    in property <bool> logged-in: false;

    function select_tab(i: int) {
        AppState.nav-state.active-tab = i;
        AppState.tab-changed(i);
    }

    preferred-height: AppState.is-mobile ? 844px : 768px;
    preferred-width: AppState.is-mobile ? 390px : 1024px;

    changed width => {
        AppState.xp = root.width;
    }

    // The tab bar lives inside the safe content area (above the home-indicator /
    // nav-bar inset). This strip fills that bottom inset band with the bar's
    // surface colour so the shelf reads as one continuous bar reaching the
    // physical edge — the native iOS/Android look. Mobile only; hidden while a
    // sub-page is open (sub-top < 0 means we're on the root tab where the bar
    // shows); zero-height (invisible) when there's no bottom inset / on desktop.
    if root.logged-in && AppState.is-mobile:
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.height - root.safe-area-insets.bottom;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        height: root.safe-area-insets.bottom;
        background: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top < 0
            ? Theme.surface
            : Theme.bg;
    }

    if root.logged-in && AppState.is-mobile:
    Rectangle {
        x: root.safe-area-insets.left;
        y: 0px;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        height: root.safe-area-insets.top;
        background: Theme.bg;
    }

    if !root.logged-in:
    AuthView {
        uid <=> AppState.user-id;
    }
    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        // Keep the bottom safe-area inset (home indicator / nav bar) OUT of the
        // content area so full-height pages (chat input, comment box, ...) never
        // slip under the gesture strip. The tab bar's same-colour strip (above)
        // covers that inset band so the bar reads as full-height and native.
        height: root.height - root.safe-area-insets.bottom - root.safe-area-insets.top;

        if root.logged-in && AppState.is-mobile:
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clip: true;

            if AppState.nav-state.active-tab >= 0:
            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 0px;

                Rectangle {
                    width: 100%;
                    background: Theme.surface;
                    clip: true;

                    ChatListView {
                        visible: AppState.nav-state.active-tab == 0;
                        width: 100%;
                        height: 100%;
                        rows: AppState.chats;
                        status: AppState.data-status;
                    }

                    ContactListView {
                        visible: AppState.nav-state.active-tab == 1;
                        width: 100%;
                        height: 100%;
                        rows: AppState.contacts;
                        letters: AppState.contact-letters;
                        requests: AppState.friend-requests;
                    }

                    DiscoverView {
                        visible: AppState.nav-state.active-tab == 2;
                        width: 100%;
                        height: 100%;
                        cards: AppState.discover;
                        like-toggled(id) => { AppState.toggle-like(id); }
                        recommend-toggled(id) => { AppState.toggle-recommend(id); }
                    }

                    MeView {
                        visible: AppState.nav-state.active-tab == 3;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
            BottomNavBar {
                y: parent.height - AppState.bottom-nav;
                content-height: AppState.bottom-nav;
                active-tab: AppState.nav-state.active-tab;
                tab-clicked(i) => { root.select_tab(i); }
            }

            if AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top >= 1:
            SubPageView {
                width: 100%;
                height: 100%;
                animate-in: false;
                page: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top - 1].page;
                payload: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top - 1].payload;
                z: 1;
            }

            if AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top >= 0:
            SubPageView {
                width: 100%;
                height: 100%;
                z: 2;
                page: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].page;
                payload: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].payload;
            }
        }

        if root.logged-in && !AppState.is-mobile:
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clip: true;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 0px;
                LeftNavBar {
                    width: 58px;
                    height: 100%;
                    active-tab: AppState.nav-state.active-tab;
                    tab-clicked(i) => { root.select_tab(i); }
                }

                Rectangle {
                    width: 280px;
                    height: 100%;
                    background: Theme.surface-2;
                    clip: true;

                    ChatListView {
                        visible: AppState.nav-state.active-tab == 0;
                        width: 100%;
                        height: 100%;
                        rows: AppState.chats;
                        status: AppState.data-status;
                    }

                    ContactListView {
                        visible: AppState.nav-state.active-tab == 1;
                        width: 100%;
                        height: 100%;
                        rows: AppState.contacts;
                        letters: AppState.contact-letters;
                        requests: AppState.friend-requests;
                    }

                    DiscoverView {
                        visible: AppState.nav-state.active-tab == 2;
                        width: 100%;
                        height: 100%;
                        cards: AppState.discover;
                        like-toggled(id) => { AppState.toggle-like(id); }
                        recommend-toggled(id) => { AppState.toggle-recommend(id); }
                    }

                    MeView {
                        visible: AppState.nav-state.active-tab == 3;
                        width: 100%;
                        height: 100%;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 100%;
                    background: Theme.border;
                }

                Rectangle {
                    background: Theme.surface-2;
                    clip: true;
                    width: root.width - 280px - 58px;
                    height: 100%;

                    if AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top >= 0:
                    SubPageView {
                        width: 100%;
                        height: 100%;
                        page: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].page;
                        payload: AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].payload;
                    }
                }
            }
        }
        if root.logged-in && !AppState.device-approved :
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 34px;
            background: Theme.warning-bg;

            Text {
                x: 12px;
                y: 0px;
                width: parent.width - 60px;
                height: parent.height;
                text: @tr("Device pending approval · have an approved device approve it to send/receive");
                font-size: 12px;
                color: Theme.warning-fg;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - 52px;
                y: 6px;
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: Theme.warning-fg;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("Approve");
                    font-size: 11px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        AppState.push-sub(SubPageType.MyDevices, 0);
                    }
                }
            }
        }
    }

    // The full-window overlays render at the window origin, so their top
    // chrome must clear the status bar itself. We hand them the window's
    // top safe-area inset (the same value the main content container above
    // already uses) — Slint keeps the binding live as the inset changes.
    if AppState.nav-state.global-overlay == GlobalOverlayType.ImageViewer: ImageViewer { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.QrScanner: ScanView { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.Camera: CameraView { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.AudioCall
        || AppState.nav-state.global-overlay == GlobalOverlayType.VideoCall
        || AppState.nav-state.global-overlay == GlobalOverlayType.ScreenShare: CallView { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.QrCode: QrCodeView { }
    if AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu: AddMenuView { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.Error: ErrorView { }
    if AppState.nav-state.global-overlay == GlobalOverlayType.MiniApp: MiniAppOverlay { safe-area-top: root.safe-area-insets.top;  }
    if AppState.nav-state.global-overlay == GlobalOverlayType.Pdf: PdfViewer { safe-area-top: root.safe-area-insets.top; }
    if AppState.nav-state.global-overlay == GlobalOverlayType.Doc: DocViewer { }
}
