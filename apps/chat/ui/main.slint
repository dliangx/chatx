import {
    NavigationState,
    TabState,
    SubPageEntry,
    SubPageType,
    GlobalOverlayType,
} from "components/nav_state.slint";
import { ChatListView } from "chats/chat_list.slint";
import { ContactListView } from "contacts/contacts.slint";
import { DiscoverView } from "discovery/discover.slint";
import { MeView } from "me/me.slint";
import { ImageViewer } from "components/image_view.slint";
import { BottomNavBar } from "components/bottom_nav.slint";
import { LeftNavBar } from "components/left_nav.slint";
import { SubPageView } from "./subpage.slint";
import { QrcodeView } from "components/qrcode.slint";
import { VideoCallView } from "components/video_call.slint";
import { AuthView } from "components/auth.slint";
import { Horizontal } from "../material-1.0/ui/components/horizontal.slint";

export component MainWindow inherits Window {
    // 1. 全局导航数据模型（只存历史，不存当前选中的索引）
    in-out property <NavigationState> state: { active-tab:0, tabs: [], global-overlay: GlobalOverlayType.None };

    // 2. 登录态（由 Rust 读写；false 时只显示登录页）
    in property <bool> logged-in: false;
    in property <bool> auth-busy: false;
    in property <string> auth-message: "";
    in-out property <string> user-id: "";

    // 端平台标识：Rust 侧用 cfg!(target_os = "android"/"ios") 注入
    in property <bool> is-mobile: true;

    // 登录/注册/退出：Slint 端只负责触发，真正校验走 p2pchat-core（Rust 侧实现）。
    callback login(string, string);
    callback register(string, string);
    callback logout();

    callback pop-sub-page(int);
    callback push-sub-page(int, SubPageType, int);

    function select_tab(i: int) {
        root.state.active-tab = i;
    }

    preferred-height: root.is-mobile ? 844px : 768px;
    preferred-width: root.is-mobile ? 390px : 1024px;

    if !root.logged-in:
    AuthView {
        message: root.auth-message;
        busy: root.auth-busy;
        uid <=> root.user-id;
        login(uid, pass) => { root.login(uid, pass); }
        register(uid, pass) => { root.register(uid, pass); }
    }

    if root.logged-in && root.is-mobile:
    Rectangle {
        width: 100%;
        height: 100%;

        if root.state.active-tab >= 0:
        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0px;

            Rectangle {
                width: 100%;
                background: #ffffff;
                clip: true;

                if root.state.active-tab == 0: ChatListView {
                    width: 100%;
                    height: 100%;
                }
                if root.state.active-tab == 1: ContactListView {
                    width: 100%;
                    height: 100%;
                }
                if root.state.active-tab == 2: DiscoverView {
                    width: 100%;
                    height: 100%;
                }
                if root.state.active-tab == 3: MeView {
                    width: 100%;
                    height: 100%;
                }
            }

            BottomNavBar {
                active-tab: root.state.active-tab;
                tab-clicked(i) => { root.select_tab(i); }
            }
        }
        if root.state.active-tab < 0: SubPageView { }
    }

    if root.logged-in && !root.is-mobile:
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        LeftNavBar {
            width: 58px;
            height: 100%;
            active-tab: root.state.active-tab;
            tab-clicked(i) => { root.select_tab(i); }
        }

        Rectangle {
            width: 280px;
            background: #e4e1e1;
            clip: true;

            if root.state.active-tab == 0: ChatListView {
                width: 100%;
                height: 100%;
            }
            if root.state.active-tab == 1: ContactListView {
                width: 100%;
                height: 100%;
            }
            if root.state.active-tab == 2: DiscoverView {
                width: 100%;
                height: 100%;
            }
            if root.state.active-tab == 3: MeView {
                width: 100%;
                height: 100%;
            }
        }

        SubPageView {
            page: SubPageType.ChatRoom;
            payload: 0;
        }
    }

    if root.state.global-overlay == GlobalOverlayType.ImageViewer: ImageViewer { }
    if root.state.global-overlay == GlobalOverlayType.QrScanner: QrcodeView { }
    if root.state.global-overlay == GlobalOverlayType.VideoCall: VideoCallView { }
}
