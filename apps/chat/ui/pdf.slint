import { AppState } from "components/app_state.slint";
import { Theme } from "./theme.slint";
import { Glyph, Icon } from "components/icon.slint";

export global PdfHost {
    in property <bool> running: false;
    in property <bool> failed: false;
    in property <string> status: "";
    // The committed canvas frame (device px); the UI scales it to the window.
    in property <image> frame;
    in property <int> page: 0;
    in property <int> page-count: 0;
    in property <int> mode: 1;
    // `touch` kind: 1 = down, 2 = move, 3 = up; x/y in logical canvas px (host scales to device px).
    callback touch(int, int, int);
    // Wheel / trackpad scroll: vertical delta (Slint: negative = scrolled down).
    callback scroll(float);
    // Toolbar → viewer: switch the rendered view mode (1 = width, 2 = height).
    callback set-mode(int);
    // Close destroys the instance; minimize only hides the overlay (it keeps running; PdfDock restores it).
    callback close();
    callback minimize();
    // Set while `PdfViewer` is hidden by a minimize; clears on close/restore.
    in property <bool> minimized: false;
    // Dock pill tapped: re-show the overlay (the instance keeps running).
    callback restore();
}

/// Floating pill shown while the viewer is minimized (instance keeps running); tap re-shows the overlay;
/// hidden whenever the overlay itself is up, so it never covers the close.
export component PdfDock inherits Rectangle {
    visible: PdfHost.running && PdfHost.minimized;
    width: 34px;
    height: 34px;
    background: transparent;
    z: 10;
    Rectangle {
        x: 0px;
        y: 0px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(16, 18, 24, 0.8);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: Glyph.fullscreen;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { PdfHost.restore(); }
        }
    }
}

// Full-screen PDF page: committed canvas frame + fit-width/height toggle, page counter,
// fatal status line, minimize, close.
export component PdfViewer inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #101218;
    clip: true;

    // Committed frame scaled to fill the window; rendered at the window's exact device px, so `fill` is 1:1 (no upscaling).
    Rectangle {
        visible: PdfHost.page-count > 0 && !PdfHost.failed;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: rgb(240, 242, 246);
        Image {
            width: 100%;
            height: 100%;
            source: PdfHost.frame;
            image-fit: fill;
        }
    }

    // 16 ms pump while the overlay is alive; stops on close (destroy) or failure.
    Timer {
        interval: 16ms;
        running: PdfHost.running && !PdfHost.failed;
        triggered => {
            AppState.pump-pdf();
        }
    }

    // Gesture surface (declared before the buttons so they sit on top): drag → continuous page strip,
    // tap → page-flip (left = prev, right = next); wheel / trackpad via `scroll-event`.
    ta := TouchArea {
        width: 100%;
        height: 100%;
        changed pressed => {
            if PdfHost.running && !PdfHost.failed {
                PdfHost.touch(ta.pressed ? 1 : 3, ta.mouse-x / 1px, ta.mouse-y / 1px);
            }
        }
        moved => {
            if ta.pressed && PdfHost.running && !PdfHost.failed {
                PdfHost.touch(2, ta.mouse-x / 1px, ta.mouse-y / 1px);
            }
        }
        scroll-event(event) => {
            if PdfHost.running && !PdfHost.failed && event.delta-y != 0 {
                PdfHost.scroll(event.delta-y / 1px);
                return accept;
            }
            reject
        }
    }

    // Fatal / no-document message, centred (shown once `failed` is set).
    Text {
        visible: PdfHost.failed;
        x: 24px;
        y: 0px;
        width: parent.width - 48px;
        height: 100%;
        vertical-alignment: center;
        horizontal-alignment: center;
        text: PdfHost.status;
        font-size: 13px;
        color: #e5484d;
    }

    // View-mode toggle (top-centre).
    Rectangle {
        visible: PdfHost.page-count > 0;
        x: (parent.width - 34px) / 2;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(16, 18, 24, 0.6);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: PdfHost.mode == 2 ? Glyph.fit-height : Glyph.fit-width;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { PdfHost.set-mode(PdfHost.mode == 1 ? 2 : 1); }
        }
    }

    // Page counter "n/m", on the same row, right of the mode pill.
    Text {
        visible: PdfHost.page-count > 0;
        x: (parent.width + 34px) / 2 + 12px;
        y: 10px;
        width: 64px;
        height: 34px;
        vertical-alignment: center;
        text: PdfHost.page-count > 0 ? "{PdfHost.page}/{PdfHost.page-count}" : "";
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
    }

    // Minimize (top-right, left of close): hide the overlay, keep the instance.
    Rectangle {
        x: parent.width - 92px;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(16, 18, 24, 0.6);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: Glyph.minimize;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { PdfHost.minimize(); }
        }
    }

    // Close (top-right corner): destroy the viewer + hide the overlay.
    Rectangle {
        x: parent.width - 48px;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(16, 18, 24, 0.6);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: Glyph.close;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { PdfHost.close(); }
        }
    }
}
