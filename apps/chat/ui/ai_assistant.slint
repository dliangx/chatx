import { Theme } from "theme.slint";
import { Header } from "components/header.slint";
import { Icon, Glyph } from "components/icon.slint";
import { AiAssistantState, AiMessageRow, AppState } from "components/app_state.slint";
import { ScrollView } from "std-widgets.slint";

export component AiAssistantView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> row-gap: 16px;
    out property <length> list-top: 48px;
    out property <length> bubble-pad: 12px;
    out property <length> bubble-min-h: 38px;
    out property <bool> can-send: !AiAssistantState.busy && AiAssistantState.draft != "";

    // ── scroll position restore (same pattern as chat.slint) ─────────────────
    in-out property <bool> requested: false;
    in-out property <int> my-token: 0;
    Timer {
        interval: 16ms;
        running: !root.requested;
        triggered => {
            root.requested = true;
            AiAssistantState.scroll-request();
        }
    }

    // ── long-press detection (same as chat.slint) ───────────────────────────
    // `lp-armed` is the index a pointer is currently pressing; after 1s it
    // becomes `lp-active`, which opens the bubble menu. `lp-text` holds the
    // pressed row's text for the copy / collect / forward actions; the `lp-*`
    // length fields are the pressed bubble's rect in *view* coordinates (used
    // to anchor the menu above/below the bubble, exactly like chat.slint).
    in-out property <int> lp-armed: -1;
    in-out property <duration> lp-elapsed: 0s;
    in-out property <int> lp-active: -1;
    in-out property <string> lp-text: "";
    in-out property <length> lp-cx: 0px;
    in-out property <length> lp-by: 0px;
    in-out property <length> lp-bw: 0px;
    in-out property <length> lp-bh: 0px;

    Timer {
        interval: 16ms;
        running: root.lp-armed >= 0 && root.lp-active < 0;
        triggered => {
            root.lp-elapsed += 16ms;
            if (root.lp-elapsed >= 1s) {
                root.lp-active = root.lp-armed;
                root.lp-armed = -1;
                root.lp-elapsed = 0s;
            }
        }
    }

    // ── input box sizing (grows with the draft, like `chat_input.slint`) ──
    // A hidden `imeasure` Text (same font/width/wrap as the input) measures the
    // draft's laid-out height; the box grows to fit it, clamped to [box-h-min,
    // box-h-max]. Past the cap the input scrolls internally (Flickable) instead
    // of growing the page.
    out property <length> in-pad: 10px;
    out property <length> box-top-pad: 6px;
    out property <length> box-bottom-pad: 8px;
    out property <length> box-h-min: 40px;
    out property <length> box-h-max: 168px;
    out property <length> box-w: root.width - 92px;
    out property <length> field-w: root.box-w - 2 * root.in-pad;
    out property <length> raw-h: imeasure.preferred-height;
    out property <length> box-h: min(root.box-h-max, max(root.box-h-min,
        root.raw-h + 2 * root.in-pad));
    out property <length> field-h: root.box-h - 2 * root.in-pad;
    out property <length> content-h: max(root.field-h, root.raw-h);
    out property <length> input-h: root.box-h + root.box-top-pad + root.box-bottom-pad;

    function send() {
        let t = AiAssistantState.draft;
        if (t != "" && !AiAssistantState.busy) {
            AiAssistantState.draft = "";
            AiAssistantState.error = "";
            AiAssistantState.busy = true;
            AiAssistantState.send(t);
        }
    }

    // Pump tokens from the actor thread while a turn is in flight
    // (the `pump-mini-app` pattern: a UI Timer drains the channel).
    Timer {
        interval: 30ms;
        running: AiAssistantState.busy;
        triggered => { AiAssistantState.pump(); }
    }

    Header {
        name: @tr("AI assistant");
        // Right zone (96px) holds two buttons: new-conversation (left) and the
        // download / model-picker (right), both on the title's baseline.
        // New conversation — archive the current one into history, start fresh.
        Rectangle {
            x: 4px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: transparent;
            Icon {
                x: (28px - 20px) / 2;
                y: (28px - 20px) / 2;
                size: 20px;
                glyph: Glyph.add;
                tint: Theme.fg;
            }
            TouchArea {
                width: 40px;
                height: 40px;
                x: -6px;
                y: -6px;
                clicked => { AiAssistantState.ai-new-chat(); }
            }
        }
        // Download / model-picker button in the header's right zone, on the
        // same baseline as the title.
        Rectangle {
            x: 56px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: AiAssistantState.model-open ? Theme.brand-soft-bg : transparent;
            Icon {
                x: (28px - 20px) / 2;
                y: (28px - 20px) / 2;
                size: 20px;
                glyph: Glyph.setting;
                tint: AiAssistantState.model-open ? Theme.brand : Theme.fg;
            }
            TouchArea {
                width: 40px;
                height: 40px;
                x: -6px;
                y: -6px;
                clicked => { AiAssistantState.model-open = !AiAssistantState.model-open; }
            }
        }
    }

    if AiAssistantState.messages.length == 0:
    Text {
        x: 0px;
        y: 180px;
        width: parent.width;
        height: 24px;
        text: @tr("Ask me anything");
        horizontal-alignment: center;
        font-size: 14px;
        color: Theme.fg-muted;
    }

    list := ScrollView {
        x: 0px;
        y: root.list-top;
        width: parent.width;
        height: parent.height - root.list-top - root.input-h;

        // While a turn is streaming, keep the newest bubble in view.
        Timer {
            interval: 40ms;
            running: AiAssistantState.busy;
            triggered => {
                list.content-y = min(0px, -(list.content-height - list.visible-height));
            }
        }

        scrolled => {
            // User released a drag: remember where it landed (bottom=0, top=max)
            // so re-entering the conversation restores the same position.
            AiAssistantState.scroll-save(
                (list.content-height - list.visible-height) + list.content-y);
            if (root.my-token != AiAssistantState.scroll-token) {
                root.my-token = AiAssistantState.scroll-token;
            }
        }

        // After a (re)load, restore the saved position (token bump → re-apply).
        Timer {
            interval: 16ms;
            running: root.my-token != AiAssistantState.scroll-token
                && list.visible-height > 0 && AiAssistantState.messages.length > 0;
            triggered => {
                root.my-token = AiAssistantState.scroll-token;
                let max = list.content-height - list.visible-height;
                list.content-y = (max > 0px) ? (AiAssistantState.scroll-dist - max) : 0px;
            }
        }

        VerticalLayout {
            width: 100%;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: root.row-gap;

            for row[i] in AiAssistantState.messages: card := Rectangle {
                in property <length> bubble-cap: parent.width * 0.8;
                // Measure at the bubble's ACTUAL text-area width
                // (`bubble-cap - 2*pad`), not `bubble-cap`: a wrapping bubble
                // renders at `bubble-cap - 2*pad`, so measuring the height at the
                // wider `bubble-cap` under-counts the line count and the last line
                // gets clipped. `preferred-width` is the full unwrapped width and
                // is independent of this binding, so the width logic below is
                // unchanged — one measurement yields the correct width *and* height.
                measure := TextInput {
                    read-only: true;
                    width: card.bubble-cap - 2 * root.bubble-pad;
                    text: row.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    visible: false;
                    line-height-factor: 1.5;
                    accessible-role: none;
                }

                out property <length> bubble-w:
                    max(2 * root.bubble-pad, min(measure.preferred-width + 2 * root.bubble-pad, card.bubble-cap));

                out property <length> bubble-h:
                    max(root.bubble-min-h, measure.preferred-height + 2 * root.bubble-pad);

                width: 100%;
                height: card.bubble-h;

                // user (side 0) → right + brand; assistant (side 1) → left + surface.
                bubble := Rectangle {
                    width: card.bubble-w;
                    height: parent.height;
                    x: row.side == 0 ? parent.width - 16px - self.width : 16px;
                    border-radius: 14px;
                    background: row.side == 0 ? Theme.brand : Theme.surface;
                    clip: true;

                    TextInput {
                        x: root.bubble-pad;
                        y: root.bubble-pad;
                        width: parent.width - 2 * root.bubble-pad;
                        height: parent.height - 2 * root.bubble-pad;
                        text: row.text;
                        wrap: word-wrap;
                        font-size: 14px;
                        color: row.side == 0 ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                        line-height-factor: 1.5;
                        selection-background-color: Theme.success;
                        private property <length> margin: 1rem;

                        cursor-position-changed(cursor-position) => {
                            if cursor-position.x + self.x < margin {
                                self.x = - cursor-position.x + margin;
                            } else if cursor-position.x + self.x > parent.width - margin - self.text-cursor-width {
                                self.x = parent.width - cursor-position.x - margin - self.text-cursor-width;
                            }
                        }
                    }

                    // Long-press to open the bubble menu (same effect as chat.slint).
                    // While armed, capture the bubble's rect in *view* coordinates
                    // (list origin + laid-out offsets, minus scroll) so the menu
                    // can be anchored directly above/below the pressed bubble.
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.lp-armed = i;
                                root.lp-elapsed = 0s;
                                root.lp-text = row.text;
                                root.lp-bw = bubble.width;
                                root.lp-bh = bubble.height;
                                root.lp-cx = card.x + bubble.x + bubble.width / 2;
                                root.lp-by = card.y + bubble.y;
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                if (root.lp-armed == i) {
                                    root.lp-armed = -1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── status line (last error, if any) ────────────────────────────────────
    if AiAssistantState.error != "":
    Text {
        x: 10px;
        y: parent.height - root.input-h - 22px;
        width: parent.width - 20px;
        height: 18px;
        text: AiAssistantState.error;
        font-size: 12px;
        color: Theme.danger;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // ── input bar ───────────────────────────────────────────────────────────
    Rectangle {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        background: Theme.bg;

        Rectangle {
            x: 0px; y: 0px; width: 100%; height: 1px; background: Theme.border;
        }

        // Measures the draft's laid-out height (same font/width/wrap as the
        // input). Drives `box-h` so the box grows with the text.
        imeasure := Text {
            width: root.field-w;
            text: AiAssistantState.draft;
            font-size: 14px;
            wrap: word-wrap;
            visible: false;
            accessible-role: none;
        }

        // input box (grows with the draft; leaves room for the send button).
        Rectangle {
            x: 10px;
            y: (parent.height - root.box-h) / 2;
            width: root.box-w;
            height: root.box-h;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            // Scrolls internally once the draft outgrows `box-h-max`.
            Flickable {
                x: root.in-pad;
                y: root.in-pad;
                width: root.field-w;
                height: root.field-h;
                content-height: root.content-h;
                interactive: true;

                input := TextInput {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: max(parent.height, root.raw-h);
                    vertical-alignment: top;
                    font-size: 14px;
                    color: Theme.fg;
                    single-line: false;
                    wrap: word-wrap;
                    text <=> AiAssistantState.draft;
                    text-cursor-width: 3px;
                    selection-background-color: Theme.brand;
                    selection-foreground-color: white;
                }

                placeholder := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 20px;
                    text: @tr("Ask me anything…");
                    font-size: 14px;
                    color: Theme.fg-muted;
                    visible: AiAssistantState.draft == "";
                    vertical-alignment: top;
                }
            }
        }

        // send button.
        Rectangle {
            x: parent.width - 70px;
            y: (parent.height - 40px) / 2;
            width: 56px;
            height: 40px;
            border-radius: 14px;
            background: Theme.brand;
            opacity: root.can-send ? 1.0 : 0.4;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: @tr("Send");
                font-size: 13px;
                color: Theme.fg-on-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.send(); }
            }
        }
    }

    // ── model picker (toggle by the header download button) ─────────────────
    if AiAssistantState.model-open:
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.overlay;
        clip: true;

        model-card := Rectangle {
            x: 12px;
            y: 56px;
            width: parent.width - 24px;
            height: min(64 * parent.width * 0.5, parent.height - 96px);
            background: Theme.surface;
            border-radius: 16px;
            clip: true;

            VerticalLayout {
                padding-top: 12px;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;

                // header row: title (stretches) + source toggle (HF / Mirror) + close
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Choose a model");
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    // source buttons (mutually exclusive): which host to download from
                    Rectangle {
                        width: 40px;
                        height: 28px;
                        border-radius: 8px;
                        background: !AiAssistantState.model-mirror ? Theme.brand : Theme.surface-2;
                        clip: true;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: @tr("HF");
                            font-size: 12px;
                            font-weight: 600;
                            color: !AiAssistantState.model-mirror ? Theme.fg-on-accent : Theme.fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                if (AiAssistantState.model-mirror) {
                                    AiAssistantState.model-mirror = false;
                                    AiAssistantState.model-source(false);
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 64px;
                        height: 28px;
                        border-radius: 8px;
                        background: AiAssistantState.model-mirror ? Theme.brand : Theme.surface-2;
                        clip: true;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: @tr("Mirror");
                            font-size: 12px;
                            font-weight: 600;
                            color: AiAssistantState.model-mirror ? Theme.fg-on-accent : Theme.fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                if (!AiAssistantState.model-mirror) {
                                    AiAssistantState.model-mirror = true;
                                    AiAssistantState.model-source(true);
                                }
                            }
                        }
                    }
                    Icon {
                        size: 20px;
                        glyph: Glyph.close;
                        tint: Theme.fg;
                        TouchArea {
                            width: 32px;
                            height: 32px;
                            clicked => { AiAssistantState.model-open = false; }
                        }
                    }
                }

                // current download source (shown under the header row)
                Text {
                    width: 100%;
                    height: 12px;
                    text: AiAssistantState.model-mirror
                        ? "https://hf-mirror.com"
                        : "https://huggingface.co";
                    font-size: 12px;
                    color: Theme.fg-muted;
                }

                // scrollable model list — rows stack in a layout (no absolute y)
                Flickable {
                    width: 100%;
                    content-height: AiAssistantState.models.length * 56px;
                    interactive: AiAssistantState.models.length * 56px > self.height;

                    VerticalLayout {
                        spacing: 0px;
                        padding-top: 20px;
                        for row in AiAssistantState.models: Rectangle {
                            width: 100%;
                            height: 56px;

                            // text block — relative layout (name / status / progress bar stack)
                            VerticalLayout {
                                x: 0;
                                width: parent.width - 116px;
                                spacing: 2px;
                                padding-top: 6px;
                                padding-bottom: 4px;

                                Text {
                                    width: 100%;
                                    height: 24px;
                                    text: row.name;
                                    font-size: 14px;
                                    color: Theme.fg;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 100%;
                                    height: 16px;
                                    font-size: 11px;
                                    color: row.status == "error" ? Theme.danger : Theme.fg-muted;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    text:
                                        row.status == "not-started" ? @tr("Not downloaded")
                                        : row.status == "downloading" ? @tr("Downloading…")
                                        : row.status == "paused" ? @tr("Paused")
                                        : row.status == "ready" ? (@tr("Ready") + (row.selected ? " · " + @tr("Selected") : ""))
                                        : row.error;
                                }
                                Rectangle {
                                    width: 100%;
                                    height: 3px;
                                    background: Theme.border;
                                    clip: true;
                                    Rectangle {
                                        width: parent.width * row.progress;
                                        height: 100%;
                                        background: row.selected ? Theme.success : Theme.brand;
                                    }
                                }
                            }

                            // action button — anchored to the row's right edge
                            Rectangle {
                                x: parent.width - 116px;
                                y: 14px;
                                width: 100px;
                                height: 28px;
                                border-radius: 14px;
                                background:
                                    row.status == "ready" ? Theme.brand
                                    : row.status == "downloading" ? Theme.surface-2
                                    : row.status == "paused" ? Theme.surface-2
                                    : row.status == "error" ? Theme.danger
                                    : Theme.brand;
                                opacity: (row.status == "ready" && row.selected) ? 0.5 : 1.0;
                                clip: true;
                                Text {
                                    width: 100%;
                                    height: 100%;
                                    font-size: 12px;
                                    color: (row.status == "ready" || row.status == "error")
                                        ? (row.status == "error" ? #ffffff : Theme.fg-on-accent)
                                        : Theme.fg;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    text:
                                        row.status == "not-started" ? @tr("Download")
                                        : row.status == "downloading" ? @tr("Cancel")
                                        : row.status == "paused" ? @tr("Resume")
                                        : row.status == "ready" ? @tr("Select")
                                        : @tr("Retry");
                                }
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    enabled: !(row.status == "ready" && row.selected);
                                    clicked => {
                                        if (row.status == "ready") {
                                            AiAssistantState.model-select(row.name);
                                            AiAssistantState.model-open = false;
                                        } else if (row.status == "downloading") {
                                            AiAssistantState.model-cancel(row.name);
                                        } else if (row.status == "paused") {
                                            AiAssistantState.model-pause(row.name);
                                        } else {
                                            AiAssistantState.model-download(row.name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── long-press bubble menu (same effect as chat.slint) ──────────────────
    // Dim overlay + tap-anywhere-to-close. Rendered last so it sits above the
    // list, input bar, and model picker; the menu is rendered after it so the
    // menu stays clickable on top.
    if root.lp-active >= 0:
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        clip: true;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.lp-active = -1; }
        }
    }

    if root.lp-active >= 0:
    menu := Rectangle {
        out property <length> menu-w: 168px;
        out property <length> menu-h: 50px;
        out property <length> slot-w: menu.menu-w / 3;
        // `lp-cx` / `lp-by` are the pressed bubble's center-x / top in *content*
        // coordinates. Adding `list.content-y` makes these LIVE bindings, so
        // the pill stays glued to the bubble while the list scrolls (it no
        // longer freezes at the position captured on press).
        out property <length> vp-top: root.list-top;
        out property <length> vp-bottom: root.height - root.input-h;
        out property <length> menu-x:
            max(6px, min(root.lp-cx - menu.menu-w / 2, root.width - menu.menu-w - 6px));
        out property <length> y-above: root.list-top + root.lp-by + list.content-y - menu.menu-h - 8px;
        out property <length> y-below: root.list-top + root.lp-by + list.content-y + root.lp-bh + 8px;
        x: menu.menu-x;
        y: max(menu.vp-top, min(
            menu.y-above >= menu.vp-top ? menu.y-above
                : (menu.y-below + menu.menu-h <= menu.vp-bottom ? menu.y-below : menu.y-above),
            menu.vp-bottom - menu.menu-h));
        width: menu.menu-w;
        height: menu.menu-h;
        border-radius: menu.menu-h / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea {
            width: root.width;
            height: root.height;
            clicked => { root.lp-active = -1; }
        }

        Icon {
            x: 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.copy;
            tint: Theme.fg;
        }
        TouchArea {
            x: 0px;
            width: menu.slot-w;
            height: 100%;
            clicked => { let t = root.lp-text; root.lp-active = -1; AppState.copy-note(t); }
        }

        Icon {
            x: menu.slot-w + 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.collection;
            tint: Theme.fg;
        }
        TouchArea {
            x: menu.slot-w;
            width: menu.slot-w;
            height: 100%;
            clicked => { let t = root.lp-text; root.lp-active = -1; AppState.save-note(t); }
        }

        Icon {
            x: menu.slot-w * 2 + 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.forward;
            tint: Theme.fg;
        }
        TouchArea {
            x: menu.slot-w * 2;
            width: menu.slot-w;
            height: 100%;
            clicked => {
                let t = root.lp-text;
                root.lp-active = -1;
                AppState.forward-target = t;
                AppState.nav-state = {
                    active-tab: 1,
                    tabs: AppState.nav-state.tabs,
                    global-overlay: AppState.nav-state.global-overlay,
                };
            }
        }
    }
}
