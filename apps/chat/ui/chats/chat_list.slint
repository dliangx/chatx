// 会话列表：1:1 会话 + 群，聚合自 Rust 侧。
import { SubPageType } from "../components/nav_state.slint";
import { ConversationRow } from "../components/app_state.slint";
import { AppState } from "../components/app_state.slint";
import { ChatListItem } from "../components/item.slint";
import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search.slint";

export component ChatListView inherits Rectangle {
    in property <[ConversationRow]> rows: [];
    in property <string> status: "";
    in-out property <int> selected-key: -1;

    width: 100%;
    height: 100%;
    background: Theme.bg;
    callback navigate-to(SubPageType, int);

    out property <length> row-h: 56px;
    out property <length> viewport-h: root.rows.length * root.row-h;

    SearchBar {
        y: 0px;
    }

    if root.status != "":
    Text {
        y: 48px;
        width: parent.width;
        height: 26px;
        text: root.status;
        color: #6b7280;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.rows.length == 0:
    Text {
        y: 180px;
        width: parent.width;
        text: "暂无会话，发消息后会出现在这里";
        color: #9aa0b4;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    Flickable {
        x: 0px;
        y: root.status == "" ? 48px : 74px;
        width: parent.width;
        height: root.status == "" ? (parent.height - 48px - (AppState.is-mobile ? 58px : 0px)) : (parent.height - 74px - (AppState.is-mobile ? 58px : 0px));
        content-height: root.viewport-h;
        interactive: true;

        for row[i] in root.rows: ChatListItem {
            x: 0px;
            y: root.row-h * i;
            width: parent.width;
            height: root.row-h;
            id: row.chat-id;
            title: row.title;
            content: row.preview;
            time: row.time-label;
            selected: row.chat-id == root.selected-key;
            clicked(id) => { root.selected-key = id; root.navigate-to(SubPageType.ChatRoom, id); }
        }
    }
}
