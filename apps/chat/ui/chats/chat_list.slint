// 会话列表：1:1 会话 + 群，聚合自 Rust 侧。
import { ScrollView, VerticalBox } from "std-widgets.slint";
import { Vertical } from "../../material-1.0/material.slint";

export struct ConversationRow {
    chat-id: string,
    title: string,
    preview: string,
    is-group: bool,
    time-label: string,
}

component MsgRow inherits Rectangle {
    in property <ConversationRow> data;
    callback clicked();

    width: 100%;
    height: 64px;
    background: #ffffff;

    Text {
        text: root.data.is-group ? "群 · " + root.data.title : root.data.title;
        x: 16px;
        y: 12px;
        width: parent.width - 100px;
        font-size: 16px;
        font-weight: 500;
        color: #1f2433;
        wrap: no-wrap;
    }

    Text {
        text: root.data.preview;
        x: 16px;
        y: 38px;
        width: parent.width - 110px;
        font-size: 13px;
        color: #6b7280;
        wrap: no-wrap;
    }

    Text {
        text: root.data.time-label;
        x: parent.width - 84px;
        y: 14px;
        width: 68px;
        font-size: 11px;
        color: #9aa0b4;
        horizontal-alignment: right;
    }

    // 分隔线
    Rectangle {
        x: 0;
        y: 63px;
        width: 100%;
        height: 1px;
        background: #f0f0f0;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component ChatListView inherits Rectangle {
    in property <[ConversationRow]> rows: [];
    in property <string> status: "";

    width: 100%;
    height: 100%;

    callback open-chat(ConversationRow);

    // 状态条
    if root.status != "":
    Text {

        height: 26px;
        text: root.status;
        color: #6b7280;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 空提示
    if root.rows.length == 0:
    Text {
        y: 180px;
        text: "暂无会话，发消息后会出现在这里";
        color: #9aa0b4;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    // 列表
    ScrollView {
        width: 100%;

        for row[i] in root.rows: MsgRow {
            data: row;
            clicked => { root.open-chat(row); }
        }
    }
}
