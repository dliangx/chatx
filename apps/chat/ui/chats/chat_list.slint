// Chat list: 1:1 threads + groups, aggregated on the Rust side.
import { ConversationRow } from "../components/app_state.slint";
import { SubPageType, AppState } from "../components/app_state.slint";
import { ChatListItem } from "../components/item.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { SearchBar } from "../components/search.slint";

export component ChatListView inherits Rectangle {
    in property <[ConversationRow]> rows: [];
    in property <string> status: "";
    in-out property <int> selected-key: -1;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> row-h: 56px;
    out property <length> viewport-h: root.rows.length * root.row-h;

    out property <bool> searching: AppState.search-q != "";

    SearchBar {
        y: 0px;
    }

    // AI assistant entry — pinned at the top of the chat list, above the
    // conversation rows. Tapping it opens the most-recent AI conversation
    // (key -1), or a fresh one when none exists yet.
    TouchArea {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: 52px;
        clicked => {
            AppState.open-ai-chat(-1);
            AppState.push-sub(SubPageType.AiAssistant, 0);
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg;
            Rectangle {
                x: 0px; y: 0px; width: 100%; height: 1px; background: Theme.border;
            }
            Icon {
                x: 14px;
                y: (parent.height - 24px) / 2;
                size: 24px;
                glyph: Glyph.siri;
                tint: Theme.brand;
            }
            Text {
                x: 48px;
                y: 0px;
                width: parent.width - 80px;
                height: 100%;
                text: @tr("AI assistant");
                font-size: 15px;
                font-weight: 600;
                color: Theme.fg;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    if root.rows.length == 0 && !root.searching && root.status == "":
    Text {
        y: 200px;
        width: parent.width;
        text: @tr("No conversations yet. Messages will appear here.");
        color: Theme.fg-muted;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.searching && root.rows.length == 0:
    Text {
        y: 200px;
        width: parent.width;
        text: @tr("No results");
        color: Theme.fg-muted;
        font-size: 14px;
        horizontal-alignment: center;
    }

    if root.status != "" && !root.searching:
    Text {
        y: 100px;
        width: parent.width;
        height: 26px;
        text: root.status;
        color: Theme.fg-muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Flickable {
        x: 0px;
        // The AI row (48..100) always sits under the search bar; the status
        // banner (when present) pushes the list down further.
        y: (root.status == "" || root.searching) ? 100px : 126px;
        width: parent.width;
        height: (root.status == "" || root.searching)
            ? (parent.height - 100px - (AppState.is-mobile ? AppState.bottom-nav : 0px))
            : (parent.height - 126px - (AppState.is-mobile ? AppState.bottom-nav : 0px));
        content-height: root.viewport-h;
        interactive: true;

        for row[i] in root.rows: ChatListItem {
            x: 0px;
            y: root.row-h * i;
            width: parent.width;
            height: root.row-h;
            id: row.chat-id;
            image: row.image;
            title: row.title;
            content: row.preview;
            time: row.time-label;
            selected: row.chat-id == root.selected-key;
            clicked(id) => {
                root.selected-key = id;
                if (row.conv-type == 2) {
                    AppState.open-ai-chat(id);
                    AppState.push-sub(SubPageType.AiAssistant, 0);
                } else {
                    AppState.push-sub(SubPageType.ChatRoom, id);
                }
            }
        }
    }
}
