import { Theme } from "../theme.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { RecordState } from "../global/record_state.slint";

export component ChatInputView inherits Rectangle {
    in property <string> placeholder-text: @tr("Type a message…");
    in property <int> chat-id: -1;
    in-out property <string> text: "";
    callback sent(string);
    /// The photo icon was tapped — Rust opens the system photo picker for
    /// `chat-id`, then sends the chosen photo to the peer.
    callback sent-image(int);
    /// The file icon was tapped — Rust opens the system file picker for
    /// `chat-id`, then sends the chosen document (pdf / docx / xlsx / pptx).
    callback sent-file(int);

    background: Theme.bg;

    // 1px top divider.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    // Recording status bar (elapsed + hint) above the box.
    if RecordState.state == "recording":
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 20px;
        background: Theme.bg;
        Text {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            text: RecordState.label;
            font-size: 11px;
            color: Theme.brand;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    out property <length> pad: 8px;
    out property <length> top-pad: 6px;
    out property <length> bottom-pad: 8px;
    out property <length> in-pad: 10px;
    out property <length> in-pad-x: 14px;
    out property <length> tail-w: 82px;
    out property <length> head-w: 84px;
    out property <length> btn-w: 68px;
    out property <length> btn-h: 32px;
    out property <length> box-w: root.width - 2 * root.pad;
    out property <length> field-w: root.box-w - root.in-pad-x - root.head-w - root.tail-w;
    out property <length> raw-h: imeasure.preferred-height;
    out property <length> box-h-min: max(24px, root.btn-h) + 2 * root.in-pad;
    out property <length> box-h-max: 168px;
    out property <length> box-h: min(root.box-h-max, max(root.box-h-min,
        root.raw-h + 2 * root.in-pad));
    out property <length> field-h: root.box-h - 2 * root.in-pad;
    out property <length> content-h: max(root.field-h, root.raw-h);
    out property <length> view-h: root.box-h + root.top-pad + root.bottom-pad;

    Rectangle {
        x: root.pad;
        y: root.top-pad;
        width: root.box-w;
        height: root.box-h;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        // Left icon row: voice-toggle then photo (pick + send) then file
        // (pick document + send), bottom-left.
        Rectangle {
            x: 0px;
            y: parent.height - root.btn-h - (root.in-pad / 2);
            width: root.head-w;
            height: root.btn-h;

            Icon {
                x: 3px;
                y: (root.btn-h - 22px) / 2;
                size: 22px;
                glyph: Glyph.voice;
                tint: RecordState.state == "recording" ? Theme.brand : Theme.fg-muted;
            }

            TouchArea {
                x: 0px;
                y: 0px;
                width: 28px;
                height: root.btn-h;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        RecordState.press-down(root.chat-id);
                    } else if (e.kind == PointerEventKind.up
                            || e.kind == PointerEventKind.cancel) {
                        // 松开 or 手势被中断 — 都结束录音
                        RecordState.press-up(root.chat-id);
                    }
                }
            }

            Icon {
                x: 31px;
                y: (root.btn-h - 22px) / 2;
                size: 22px;
                glyph: Glyph.photo;
                tint: Theme.fg-muted;
            }

            TouchArea {
                x: 28px;
                y: 0px;
                width: 28px;
                height: root.btn-h;
                clicked => {
                    root.sent-image(root.chat-id);
                }
            }

            Icon {
                x: 59px;
                y: (root.btn-h - 22px) / 2;
                size: 22px;
                glyph: Glyph.notes;
                tint: Theme.fg-muted;
            }

            TouchArea {
                x: 56px;
                y: 0px;
                width: 28px;
                height: root.btn-h;
                clicked => {
                    root.sent-file(root.chat-id);
                }
            }
        }

        imeasure := Text {
            x: root.in-pad-x + root.head-w;
            y: 0px;
            width: root.field-w;
            text: input.text;
            font-size: 15px;
            wrap: word-wrap;
            visible: false;
            accessible-role: none;
        }

        Flickable {
            x: root.in-pad-x + root.head-w;
            y: root.in-pad;
            width: root.field-w;
            height: root.field-h;
            content-height: root.content-h;
            interactive: true;

            input := TextInput {
                x: 0px;
                y: 0px;
                width: 100%;
                height: max(parent.height, root.raw-h);
                color: Theme.fg;
                font-size: 15px;
                vertical-alignment: top;
                wrap: word-wrap;
                single-line: false;
                text <=> root.text;
                selection-background-color: Theme.brand-soft;
                selection-foreground-color: Theme.brand;
                accepted => { send(input.text); }
            }

            placeholder := Text {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 20px;
                visible: root.text == "";
                text: root.placeholder-text;
                color: Theme.fg-muted;
                font-size: 15px;
                vertical-alignment: top;
            }
        }

        Rectangle {
            x: parent.width - root.btn-w - (root.tail-w - root.btn-w);
            y: parent.height - root.btn-h - root.in-pad;
            width: root.btn-w;
            height: root.btn-h;
            border-radius: root.btn-h / 2;
            background: input.text == "" ? Theme.disabled : Theme.brand;

            Text {
                width: 100%;
                height: 100%;
                text: @tr("Send");
                font-size: 13px;
                color: Theme.fg-on-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    send(input.text);
                }
            }
        }

        function send(text: string) {
            if (text == "") {
                return;
            }
            root.text = "";
            root.sent(text);
        }
    }
}
