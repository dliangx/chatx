import { Button } from "std-widgets.slint";
import { ChatInputView } from "chat_input.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { GlobalOverlayType, AppState } from "../components/app_state.slint";
import { Header } from "../components/header.slint";

export struct MessageData {
    bubble: image,
    width: length,
    height: length,
    is_self: bool,
    text: string,
    selected: bool,
    top: length,
    /// Empty for text rows; the local s16le clip path for voice rows.
    voice_path: string,
    /// Pre-formatted duration label ("M:SS") for voice rows.
    voice_label: string,
    /// Empty for text/voice rows; the local photo path for image rows.
    image_path: string,
    /// The decoded chat photo (set for image rows; the `Image` element shows it,
    /// capped to the preview box by `width`/`height`).
    image_img: image,
    /// Sender avatar (right for own voice bubble, left for theirs).
    avatar: image,
    /// Time label shown below the voice bubble body (e.g. "14:32").
    voice_time: string,
}

export global ChatSession {
    in property <bool> connect-status: false;
    in property <[MessageData]> messages: [];
    in property <string> send-status: "";
    in property <length> scroll-dist: 0px;
    in property <int> scroll-token: 0;
    in property <length> content-h: 0px;
    /// Index into `messages` of the currently-playing voice bubble; -1 = none.
    in property <int> playing-idx: -1;
    /// Continuous rotation angle (degrees) of the playing record icon.
    /// Advanced by one Timer while `playing-idx >= 0`; frozen otherwise.
    in-out property <angle> spin: 0deg;
    callback message-sent(int, string);
    callback update-scroll(int, length);
    callback scroll-request(int);
    /// User tapped a voice bubble — start playback (Rust sets `playing-idx`).
    callback play-voice(int);
    /// User tapped the currently-playing bubble — stop (Rust clears `playing-idx`).
    callback stop-play();
    /// User tapped the image icon in the input bar — open the system photo
    /// picker for chat `key`, then send the chosen photo.
    callback sent-image(int);
    /// User tapped a photo bubble — open the full-screen viewer on `idx`.
    callback open-image(int);
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    callback open-setting();
    callback press(int);
    callback release(int);
    callback copy-text(string);

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> msg-row-h: 56px;
    out property <length> input-h: input-bar.view-h;
    out property <length> status-h: ChatSession.send-status != "" ? 20px : 0px;
    out property <length> _bottom: root.status-h + root.input-h;

    // Single Timer that advances the record icon's rotation angle while a clip
    // is playing. `rotation-angle` is a basic `Path` property (no effects), so
    // we just keep adding degrees — no pre-baked frames or reset logic needed.
    // ~3.4deg per 16ms tick → ~60fps, ~1.05s per full turn.
    Timer {
        interval: 16ms;
        running: ChatSession.playing-idx >= 0;
        triggered => { ChatSession.spin += 3deg; }
    }

    Header {
        name: @tr("chat");

        Icon {
            width: 32px;
            height: 32px;
            size: 18px;
            glyph: Glyph.call;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => {
                    AppState.add-menu-type = 1;
                    AppState.nav-state.global-overlay = AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu
                        ? GlobalOverlayType.None
                        : GlobalOverlayType.AddMenu;
                }
            }
        }
    }

    input-bar := ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        chat-id: root.chat-id;
        sent(t) => { ChatSession.message-sent(root.chat-id, t); }
        sent-image(id) => { ChatSession.sent-image(id); }
    }

    if ChatSession.send-status != "":
    Text {
        x: 0px;
        y: parent.height - root.input-h - 20px;
        width: parent.width;
        height: 20px;
        text: ChatSession.send-status;
        color: Theme.fg-muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    in-out property <bool> scrolled: false;
    in-out property <bool> scroll-guard: false;
    in-out property <bool> requested: false;
    in-out property <length> last-reported: -1px;
    in-out property <int> my-token: 0;

    Timer {
        interval: 16ms;
        running: !root.requested;
        triggered => {
            root.requested = true;
            ChatSession.scroll-request(root.chat-id);
        }
    }

    fk := Flickable {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - root._bottom - 48px;
        content-height: ChatSession.content-h;
        interactive: ChatSession.messages.length > 0;

        // User-initiated drag cancels any pending programmatic scroll request
        // — once they take the wheel, the saved position (kept fresh by the
        // position-report timer) wins over a stale restore request.
        flicked => {
            if (root.my-token != ChatSession.scroll-token) {
                root.my-token = ChatSession.scroll-token;
            }
        }

        // Apply the requested scroll position whenever `scroll-token` bumps
        // from Rust (on entry or after a message is sent). One-shot per token:
        // we commit `my-token` inside `triggered`, otherwise this timer stays
        // "running" and re-applies `content-y` every 16ms forever — each
        // application re-triggers the position-report timer (below, whose ±1px
        // window is crossed by the sub-pixel drift), which bumps the scroll
        // token back from Rust, and the two fight each other: the visible
        // symptom is a stutter view that snaps back to the saved position.
        Timer {
            interval: 16ms;
            running: root.my-token != ChatSession.scroll-token
                && fk.height > 0 && ChatSession.messages.length > 0;
            triggered => {
                root.my-token = ChatSession.scroll-token;
                let max = fk.content-height - fk.height;
                fk.content-y = (max > 0px) ? (ChatSession.scroll-dist - max) : 0px;
                root.last-reported = ChatSession.scroll-dist;
                root.scrolled = true;
                root.scroll-guard = true;
            }
        }

        Timer {
            interval: 16ms;
            running: root.scroll-guard;
            triggered => { root.scroll-guard = false; }
        }

        Timer {
            interval: 16ms;
            running: root.scrolled && !root.scroll-guard
                && fk.interactive && (fk.content-height > fk.height);
            triggered => {
                let d = (fk.content-height - fk.height) + fk.content-y;
                if (d < root.last-reported - 1px || d > root.last-reported + 1px) {
                    root.last-reported = d;
                    ChatSession.update-scroll(root.chat-id, d);
                }
            }
        }

        for msg[i] in ChatSession.messages: Rectangle {
            x: 0px;
            y: msg.top;
            width: parent.width;
            height: msg.height;

            // ── voice bubble (matching text-bubble proportions) ──────────
            // Row geometry (logical px, scale=1):
            //   avatar  = 36×36  (theme.avatar_size; same as text bubbles)
            //   body    = 36px tall, 72px wide (8 pad + 24 icon + 4 + 34 dur)
            //   time    = 11px font, 14px tall, directly below the body
            //   gap     = 8px, edge = 6px  (same as text bubbles)
            //   row     = avatar/body (36) + 4 gap + time (14) = 54 ≈ text height
            // Own:   [body 72][gap][avatar 36]  → right edge
            // Other: [avatar 36][gap][body 72]  → left edge
            if msg.voice_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // ── avatar (36×36, same size as the text-bubble avatar) ──
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self
                        ? parent.width - 6px - 36px
                        : 6px;
                    source: msg.avatar;
                }

                // ── bubble body (mic icon + duration, tap to play) ─────
                Rectangle {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 0px;
                    width: 72px;
                    height: 36px;
                    border-radius: 12px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    // record icon: 24×24, rotates (rotation-angle) while this row
                    // is playing, frozen at current angle otherwise.
                    Icon {
                        x: 4px; y: 6px;
                        size: 24px;
                        glyph: Glyph.record;
                        tint: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        transform-rotation: ChatSession.playing-idx == i ? ChatSession.spin : 0deg;
                    }

                    Text {
                        x: 36px; y: 0px;
                        width: 36px;
                        height: 100%;
                        text: msg.voice_label;
                        font-size: 12px;
                        color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (ChatSession.playing-idx == i) {
                                ChatSession.stop-play();
                            } else {
                                ChatSession.play-voice(i);
                            }
                        }
                    }
                }

                // ── send time (same muted 11px style as text bubbles) ───
                Text {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 40px;
                    width: 72px;
                    height: 14px;
                    text: msg.voice_time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }
            }

            // ── image bubble (only for image rows) ───────────────────────
            if msg.image_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // Avatar (36×36) sits on the outer edge, matching voice bubbles.
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self ? parent.width - 6px - 36px : 6px;
                    source: msg.avatar;
                }

                TouchArea {
                    x: msg.is_self ? parent.width - 6px - 36px - 8px - msg.width : 6px + 36px + 8px;
                    y: 0px;
                    width: msg.width;
                    height: msg.height;
                    clicked => { ChatSession.open-image(i); }

                    Image {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        source: msg.image_img;
                        image-fit: contain;
                    }
                }
            }

            // ── text bubble (existing path, only for non-voice, non-image rows) ─
            if msg.voice_path == "" && msg.image_path == "":
            TouchArea {
                x: msg.is_self ? parent.width - msg.width - 6px : 6px;
                y: 0px;
                width: msg.width;
                height: msg.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.press(i);
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.release(i);
                    }
                }
                Image {
                    source: msg.bubble;
                    width: msg.width;
                    height: msg.height;
                }
            }

            if msg.selected && msg.image_path == "": Button {
                text: @tr("Copy");
                x: msg.is_self ? parent.width - msg.width - 6px - 64px : 6px + msg.width + 8px;
                y: 0px;
                width: 56px;
                height: 28px;
                clicked => { root.copy-text(msg.text); }
            }
        }
    }
}
