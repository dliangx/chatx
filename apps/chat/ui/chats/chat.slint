import { Button } from "std-widgets.slint";
import { ChatInputView } from "chat_input.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../components/app_state.slint";
import { Header } from "../components/header.slint";

export struct MessageData {
    bubble: image,
    width: length,
    height: length,
    is_self: bool,
    text: string,
    selected: bool,
}

// 聊天会话状态：本页面私有。Rust 侧收到 opened(chat-id) 后按 chat-id 查询并填充 messages。
export global ChatState {
    in property <int> chat-key: -1;
    in property <[MessageData]> messages: [];
    in property <string> send-status: "";
    callback message-sent(int, string);
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    callback on-back();
    callback open-setting();
    callback press(int);
    callback release(int);
    callback copy-text(string);

    width: 100%;
    height: 100%;
    background: #f5f5f5;

    out property <length> msg-row-h: 56px;
    out property <length> input-h: 52px;
    out property <length> status-h: ChatState.send-status != "" ? 20px : 0px;
    out property <length> _bottom: root.status-h + root.input-h;

    Header {
        name: "chat";
        on-back => { root.on-back() }
    }

    ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        sent(t) => { ChatState.message-sent(root.chat-id, t); }
    }

    // 发送状态提示（位于输入区上方）
    if ChatState.send-status != "":
    Text {
        x: 0px;
        y: parent.height - root.input-h - 20px;
        width: parent.width;
        height: 20px;
        text: ChatState.send-status;
        color: #6b7280;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 消息列表
    Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - root._bottom;
        viewport-height: 12px + ChatState.messages.length * root.msg-row-h;
        interactive: ChatState.messages.length > 0;

        for msg[i] in ChatState.messages: Rectangle {
            x: 0px;
            y: 12px + i * root.msg-row-h;
            width: parent.width;
            height: root.msg-row-h;

            TouchArea {
                x: msg.is-self ? parent.width - msg.width - 6px : 6px;
                y: 4px;
                width: msg.width;
                height: msg.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.press(i);
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.release(i);
                    }
                }
                Image {
                    source: msg.bubble;
                    width: msg.width;
                    height: msg.height;
                }
            }

            if msg.selected: Button {
                text: "复制";
                x: msg.is-self ? parent.width - msg.width - 6px - 64px : 6px + msg.width + 8px;
                y: 4px;
                width: 56px;
                height: 28px;
                clicked => { root.copy-text(msg.text); }
            }
        }
    }
}
