import { Button, Spinner, ScrollView } from "std-widgets.slint";
import { ChatInputView } from "chat_input.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import {
    GlobalOverlayType,
    AppState,
    SubPageType,
} from "../components/app_state.slint";
import { Header } from "../components/header.slint";

export struct MessageData {
    width: length,
    height: length,
    is_self: bool,
    text: string,
    /// Sender name (group "other" rows); empty for DMs / own rows. Drawn as a
    /// native `Text` above the bubble.
    name: string,
    /// Body as native Slint rich text (colored + underlined + tappable links),
    /// replacing the old rasterised `bubble` bitmap.
    rich: styled-text,
    selected: bool,
    top: length,
    /// Empty for text rows; the local s16le clip path for voice rows.
    voice_path: string,
    /// Pre-formatted duration label ("M:SS") for voice rows.
    voice_label: string,
    /// Empty except for file rows; the local document path (pdf / docx / …) — tapping a PDF opens the in-app viewer.
    file_path: string,
    /// The sender's basename for file rows (shown on the file bubble).
    file_name: string,
    /// File rows only: which document icon to draw — 0 Word (.docx) · 1 Excel (.xlsx)
    /// · 2 PowerPoint (.pptx) · 3 PDF (anything else / -1 = the generic file glyph).
    file_kind: int,
    /// Empty for text/voice rows; the local photo path for image rows.
    image_path: string,
    /// The decoded chat photo (set for image rows; the `Image` element shows it,
    /// capped to the preview box by `width`/`height`).
    image_img: image,
    /// Sender avatar (right for own voice bubble, left for theirs).
    avatar: image,
    /// Time label shown below the voice bubble body (e.g. "14:32").
    voice_time: string,
    /// Image-row send badge: 0 none · 1 sending · 2 sent (✓) · 3 failed (!).
    /// Shown bottom-right over OWN image bubbles so a send reads as sending /
    /// sent / failed without a global spinner.
    send_state: int,
    /// Empty unless the row's text contains a link (http / https / www.);
    /// the first detected URL — tapping the bubble opens it in the browser.
    link: string,
    /// Empty unless the translate button is on and the row's text was
    /// auto-translated into the app's language. Drawn below the original
    /// text in the bubble. Own rows and same-language rows stay empty.
    translation: string,
}

export global ChatSession {
    in property <bool> connect-status: false;
    in property <[MessageData]> messages: [];
    /// True while a message is being sent: the chat shows a spinner over the input.
    in property <bool> send-busy: false;
    /// Current link state of the counterparty in the open DM chat:
    ///   ""         offline / not applicable (hide dot)
    ///   "dialing"  connecting / hole-punching in flight (grey + pulsing)
    ///   "direct"   direct QUIC/TCP transport (green)
    ///   "relay"    connected via a relay circuit (yellow)
    /// Groups keep this "" (no dot). The chat header draws the dot itself
    /// based on this value, so `header.slint` stays generic.
    in property <string> conn: "";

    in property <length> scroll-dist: 0px;
    in property <int> scroll-token: 0;
    /// True while the header translate button is "on". When on, incoming
    /// (non-self) text rows whose language differs from the app's are
    /// auto-translated by the local AI and shown under the original. Own rows
    /// and same-language rows are left untouched.
    in-out property <bool> translate-enabled: false;
    /// Fired whenever the translate button is toggled. Rust re-renders the
    /// current chat: on → run the auto-translation pass; off → clear the
    /// existing translations.
    callback translate-toggled();
    /// Index into `messages` of the currently-playing voice bubble; -1 = none.
    in property <int> playing-idx: -1;
    /// Continuous rotation angle (degrees) of the playing record icon.
    /// Advanced by one Timer while `playing-idx >= 0`; frozen otherwise.
    in-out property <angle> spin: 0deg;
    callback message-sent(int, string);
    /// Draft text changed (user is typing). Rust persists to `conversations.draft`
    /// for the given chat key so it survives ChatInputView destruction.
    callback draft-changed(int, string);
    callback update-scroll(int, length);
    callback scroll-request(int);
    /// User tapped a voice bubble — start playback (Rust sets `playing-idx`).
    callback play-voice(int);
    /// User tapped the currently-playing bubble — stop (Rust clears `playing-idx`).
    callback stop-play();
    /// User tapped the image icon in the input bar — open the system photo
    /// picker for chat `key`, then send the chosen photo.
    callback sent-image(int);
    /// File icon tapped — open the file picker for chat `key`, then send the chosen document.
    callback sent-file(int);
    /// User tapped a photo bubble — open the full-screen viewer on `idx`.
    callback open-image(int);
    /// File bubble tapped — open the document (PDFs in the native in-app viewer).
    callback open-file(int);
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    callback open-setting();
    callback copy-text(string);

    width: 100%;
    height: 100%;
    background: Theme.bg;

    // ── long-press detection ───────────────────────────────────────────────
    in-out property <int> lp-armed: -1;
    in-out property <duration> lp-elapsed: 0s;
    in-out property <int> lp-active: -1;
    // Pressed bubble's rect in *content* coordinates (captured on pointer-down),
    // used to anchor the long-press menu above/below the bubble (ai_assistant pattern).
    in-out property <length> lp-cx: 0px;
    in-out property <length> lp-by: 0px;
    in-out property <length> lp-bw: 0px;
    in-out property <length> lp-bh: 0px;

    Timer {
        interval: 16ms;
        running: root.lp-armed >= 0 && root.lp-active < 0;
        triggered => {
            root.lp-elapsed += 16ms;
            if (root.lp-elapsed >= 1s) {
                root.lp-active = root.lp-armed;
                root.lp-armed = -1;
                root.lp-elapsed = 0s;
            }
        }
    }

    out property <length> msg-row-h: 56px;
    out property <length> row-h: 54px;
    out property <length> input-h: input-bar.view-h;
    out property <length> _bottom: root.input-h;

    Timer {
        interval: 16ms;
        running: ChatSession.playing-idx >= 0;
        triggered => { ChatSession.spin += 3deg; }
    }

    Header {
        name: @tr("chat");

        if AppState.current-chat-key >= 0 && AppState.current-chat-is-group:

        Icon {
            x: 12px;
            y: 0px;
            width: 48px;
            height: 48px;
            size: 18px;
            glyph: Glyph.setting;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => { AppState.push-sub(SubPageType.ChatSetting, AppState.current-chat-key); }
            }
        }

        Icon {
            x: 48px;
            y: 0px;
            width: 48px;
            height: 48px;
            size: 18px;
            glyph: Glyph.call;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => {
                    AppState.add-menu-type = 1;
                    AppState.nav-state.global-overlay = AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu
                        ? GlobalOverlayType.None
                        : GlobalOverlayType.AddMenu;
                }
            }
        }
    }

    // Translate toggle — top-level (above the list), sitting in the header's
    // right zone beside the DM connection dot / the group setting icon and the
    // call icon. Off by default; tapping flips `ChatSession.translate-enabled`
    // and the icon's colours (grey glyph on transparent → white glyph on the
    // brand chip), the requested "background + foreground change".
    //
    // Position: for a DM the only right-zone element is the connection dot
    // (parent.width-60), so the button sits flush left of it (parent.width-108
    // → spans to parent.width-60). For a group the right zone is empty (the
    // setting / call icons are on the left), so the button sits flush against
    // the right edge (parent.width-60).
    Icon {
        x: AppState.current-chat-is-group
            ? parent.width - 64px
            : parent.width - 102px;
        y: 10px;
        width: 30px;
        height: 30px;
        size: 18px;
        glyph: Glyph.translate;
        background: ChatSession.translate-enabled ? Theme.brand : transparent;
        tint: ChatSession.translate-enabled ? Theme.fg-on-accent : Theme.fg;
        TouchArea {
            width: 18px;
            height: 18px;
            clicked => {
                ChatSession.translate-enabled = !ChatSession.translate-enabled;
                ChatSession.translate-toggled();
            }
        }
    }

    // DM connection status dot (6px / 3px radius), drawn in the header's right
    // zone beside the call/add icon, vertically centred on the 48px bar.
    //   red      "offline"  — not connected yet (baseline)
    //   yellow   "relay"    — connected via a relay circuit
    //   green    "direct"   — direct QUIC/TCP transport
    //   pulsing  "dialing"  — connecting / hole-punch in flight
    //
    // `dialing` deliberately uses a **neutral grey + pulse** (opacity toggled
    // by a 1 Hz Timer) rather than a "success-ish" green/yellow: a peer whose
    // every candidate address is failing (offline) would otherwise look
    // "connected" for 5–60s at a time — the "red→green→red on switch chat"
    // confusion. Grey + motion is the universal "pending / in progress" cue
    // and is never mistaken for an established link.
    // DM only; the dot is a top-level absolute element so it does not get
    // reflowed by the Header (a VerticalLayout) like children do.
    if !AppState.current-chat-is-group:
    Rectangle {
        x: parent.width - 60px;
        y: 21px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        in-out property <bool> blink: true; // true = opaque, false = dim
        Timer {
            interval: 500ms;
            running: ChatSession.conn == "dialing";
            triggered => { blink = !blink; }
        }

        background:
            ChatSession.conn == "dialing" ? (blink? Theme.fg-muted:Theme.fg-strong)
          : ChatSession.conn == "direct"  ? Theme.success
           : ChatSession.conn == "relay"   ?Theme.info
          : Theme.danger;
    }

    input-bar := ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        chat-id: root.chat-id;
        sent(t) => { ChatSession.message-sent(root.chat-id, t); }
        draft-changed(t) => { ChatSession.draft-changed(root.chat-id, t); }
        sent-image(id) => { ChatSession.sent-image(id); }
        sent-file(id) => { ChatSession.sent-file(id); }
    }

    // "Sending…" indicator (transient, shown only while a send is in flight) —
    // replaces the old always-present status text above the input. Failures
    // surface elsewhere as a transient toast (not pinned here).
    if ChatSession.send-busy:
    Spinner {
        x: (parent.width - 22px) / 2;
        y: parent.height - root.input-h - 32px;
        width: 22px;
        height: 22px;
    }
    in-out property <bool> requested: false;
    in-out property <int> my-token: 0;

    Timer {
        interval: 16ms;
        running: !root.requested;
        triggered => {
            root.requested = true;
            ChatSession.scroll-request(root.chat-id);
        }
    }

    // Rows stack in a Slint `VerticalLayout` inside a `ScrollView` (like
    // ai_assistant.slint) — `content-height` is derived from the laid-out rows,
    // so there is no Rust `msg.top` / `ChatSession.content-h` anymore.
    fk := ScrollView {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - root._bottom - 48px;

        scrolled => {
            // User released a drag: remember where it landed (bottom=0, top=max).
            // Persisting only on real user drags keeps the "stuck to bottom"
            // memory intact across new messages.
            ChatSession.update-scroll(
                root.chat-id,
                (fk.content-height - fk.visible-height) + fk.content-y);
            if (root.my-token != ChatSession.scroll-token) {
                root.my-token = ChatSession.scroll-token;
            }
        }

        Timer {
            interval: 16ms;
            running: root.my-token != ChatSession.scroll-token
                && fk.visible-height > 0 && ChatSession.messages.length > 0;
            triggered => {
                root.my-token = ChatSession.scroll-token;
                let max = fk.content-height - fk.visible-height;
                fk.content-y = (max > 0px) ? (ChatSession.scroll-dist - max) : 0px;
            }
        }

        VerticalLayout {
            width: 100%;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 16px;

            for msg[i] in ChatSession.messages: card := Rectangle {
                out property <bool> is-text:
                    msg.voice_path == "" && msg.image_path == "" && msg.file_path == "";
                out property <length> name-h: msg.name != "" ? 14px : 0px;
                out property <length> bubble-pad: 12px;
                out property <length> bubble-min-h: 38px;
                out property <length> bubble-cap: parent.width * 0.8;
                measure := Text {
                    width: card.bubble-cap - 2 * card.bubble-pad;
                    text: msg.translation != "" ? msg.text + "\n" + msg.translation : msg.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    visible: false;
                    line-height-factor: 1.5;
                    accessible-role: none;
                }

                out property <length> bubble-w:
                    max(2 * card.bubble-pad, min(measure.preferred-width + 2 * card.bubble-pad, card.bubble-cap));

                out property <length> bubble-h:
                    max(card.bubble-min-h, measure.preferred-height + 2 * card.bubble-pad);

                width: 100%;
                height: card.is-text
                    ? (card.name-h + card.bubble-h)
                    : (msg.image_path != "" ? msg.height : root.row-h);

            // ── voice bubble (matching text-bubble proportions) ──────────
            if msg.voice_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // ── avatar (36×36, same size as the text-bubble avatar) ──
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self
                        ? parent.width - 6px - 36px
                        : 6px;
                    source: msg.avatar;
                }

                // ── bubble body (mic icon + duration, tap to play) ─────
                Rectangle {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 0px;
                    width: 72px;
                    height: 36px;
                    border-radius: 8px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    // record icon: 24×24, rotates (rotation-angle) while this row
                    // is playing, frozen at current angle otherwise.
                    Icon {
                        x: 4px;
                        y: 6px;
                        size: 24px;
                        glyph: Glyph.record;
                        tint: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        transform-rotation: ChatSession.playing-idx == i ? ChatSession.spin : 0deg;
                    }

                    Text {
                        x: 36px;
                        y: 0px;
                        width: 36px;
                        height: 100%;
                        text: msg.voice_label;
                        font-size: 12px;
                        color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (ChatSession.playing-idx == i) {
                                ChatSession.stop-play();
                            } else {
                                ChatSession.play-voice(i);
                            }
                        }
                    }
                }

                // ── send time (same muted 11px style as text bubbles) ───
                Text {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 40px;
                    width: 72px;
                    height: 14px;
                    text: msg.voice_time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }
            }

            if msg.file_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self ? parent.width - 6px - 36px : 6px;
                    source: msg.avatar;
                }

                bubble := Rectangle {
                    y: 0px;
                    in property <length> cap-w: min(260px, parent.width - 54px);
                    width: min(max(43px + filename.preferred-width, 78px), cap-w);
                    x: msg.is_self ? parent.width - 50px - self.width : 50px;
                    height: 36px;
                    border-radius: 8px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    Icon {
                        x: 5px;
                        y: 6px;
                        size: 24px;
                        glyph: msg.file_kind == 0 ? Glyph.file-word
                            : msg.file_kind == 1 ? Glyph.file-excel
                            : msg.file_kind == 2 ? Glyph.file-ppt
                            : msg.file_kind == 3 ? Glyph.file-pdf
                            : Glyph.file;
                        tint: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                    }

                    filename := Text {
                        x: 35px;
                        y: 0px;
                        width: parent.width - 43px;
                        height: 100%;
                        text: msg.file_name;
                        font-size: 12px;
                        overflow: elide;
                        color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { ChatSession.open-file(i); }
                    }
                }

                Text {
                    x: msg.is_self ? parent.width - 50px - bubble.width : 50px;
                    y: 40px;
                    width: bubble.width;
                    height: 14px;
                    text: msg.voice_time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }
            }

            // ── image bubble (only for image rows) ───────────────────────
            if msg.image_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // Avatar (36×36) sits on the outer edge, matching voice bubbles.
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self ? parent.width - 6px - 36px : 6px;
                    source: msg.avatar;
                }

                TouchArea {
                    x: msg.is_self ? parent.width - 6px - 36px - 8px - msg.width : 6px + 36px + 8px;
                    y: 0px;
                    width: msg.width;
                    height: msg.height;
                    clicked => { ChatSession.open-image(i); }

                    Image {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        source: msg.image_img;
                        image-fit: contain;
                    }
                }

                if msg.is_self && msg.send_state >= 1:
                Rectangle {
                    out property <length> bsz: 22px;
                    width: bsz;
                    height: bsz;
                    x: parent.width - 6px - 36px - 8px - bsz - 4px;
                    y: msg.height - bsz - 4px;
                    border-radius: 8px;
                    // "sent" (2): white chip with a dark check ·
                    // "sending" (1): same chip, faded to read as in-flight ·
                    // "failed" (3): dark chip with a red "!".
                    background: msg.send_state == 3 ? Theme.bg : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: msg.send_state == 1 ? 0.55 : 1.0;

                    if msg.send_state == 3:
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "!";
                        color: Theme.danger;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if msg.send_state != 3:
                    Icon {
                        width: bsz;
                        height: bsz;
                        size: bsz - 8px;
                        glyph: Glyph.finish;
                        tint: Theme.fg;
                    }
                }
            }

            // ── text bubble (only for non-voice / non-image / non-file rows) ─
            // Same structure as ai_assistant.slint: sender name (group rows)
            // above a rounded `StyledText` bubble, plus the avatar on the outer
            // edge. Bubble size comes straight from the single `measure` on the
            // enclosing `card`.
            if msg.voice_path == "" && msg.image_path == "" && msg.file_path == "":
            row := Rectangle {
                width: parent.width;
                height: parent.height;

                // Avatar (36×36) on the outer edge, bottom-aligned.
                Image {
                    width: 36px;
                    height: 36px;
                    x: msg.is_self ? row.width - 6px - 36px : 6px;
                    y: row.height - 6px - 36px;
                    source: msg.avatar;
                }

                // Group-chat sender name (other rows; empty for DMs / own) — above
                // the bubble.
                if msg.name != "":
                Text {
                    x: msg.is_self ? row.width - 46px - 160px : 46px;
                    y: 0px;
                    width: 160px;
                    height: 14px;
                    text: msg.name + "/" + msg.voice-time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }

                // Rounded bubble body. Sized by the card's measure (which is
                // already at the real text width `bubble-cap - 2*pad`).
                tbubble := Rectangle {
                    width: card.bubble-w;
                    height: card.bubble-h;
                    x: msg.is_self ? row.width - 46px - tbubble.width : 46px;
                    y: card.name-h;
                    border-radius: 14px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    VerticalLayout {
                        x: card.bubble-pad;
                        y: card.bubble-pad;
                        width: parent.width - 2 * card.bubble-pad;
                        height: parent.height - 2 * card.bubble-pad;
                        spacing: 4px;

                        Text {
                            text: msg.text;
                            wrap: word-wrap;
                            overflow: clip;
                            font-size: 14px;
                            color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            line-height-factor: 1.5;
                        }

                        // Auto-translation (when the header translate button is
                        // on): shown under the original in a muted, slightly
                        // smaller type so the original stays primary.
                        if msg.translation != "":
                        Text {
                            text: msg.translation;
                            wrap: word-wrap;
                            overflow: clip;
                            font-size: 12px;
                            color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            line-height-factor: 1.4;
                        }
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (msg.link != "") {
                                AppState.open-link(msg.link);
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.lp-armed = i;
                                root.lp-elapsed = 0s;
                                root.lp-cx = card.x + tbubble.x + tbubble.width / 2;
                                root.lp-by = card.y + tbubble.y;
                                root.lp-bw = tbubble.width;
                                root.lp-bh = tbubble.height;
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                if (root.lp-armed == i) {
                                    root.lp-armed = -1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // Dimming overlay + tap-anywhere-to-close. Top-level (above the list),
    // rendered AFTER the rows so it sits on top; the menu is rendered after it
    // so the menu stays clickable on top.
    if root.lp-active >= 0:
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        clip: true;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.lp-active = -1; }
        }
    }

    // Long-press icon menu. Top-level (above list + overlay), anchored from the
    // pressed bubble's captured content-coord rect (lp-cx/lp-by/lp-bw/lp-bh),
    // the same ai_assistant pattern as chat's old absolute layout.
    if root.lp-active >= 0:
    menu := Rectangle {
        out property <length> menu-w: 168px;
        out property <length> menu-h: 50px;
        out property <length> slot-w: menu.menu-w / 3;
        in property <MessageData> msg: ChatSession.messages[root.lp-active];
        out property <length> menu-x:
            max(6px, min(root.lp-cx - menu.menu-w / 2, root.width - menu.menu-w - 6px));
        x: menu.menu-x;

        out property <length> vp-top: 48px;
        out property <length> vp-bottom: root.height - root.input-h;
        out property <length> y-above: 48px + root.lp-by + fk.content-y - menu.menu-h - 8px;
        out property <length> y-below: 48px + root.lp-by + fk.content-y + root.lp-bh + 8px;
        y: max(menu.vp-top, min(
            (menu.y-above >= menu.vp-top)
            ? menu.y-above
            : (menu.y-below + menu.menu-h <= menu.vp-bottom ? menu.y-below : menu.y-above),
            menu.vp-bottom - menu.menu-h));
        width: menu.menu-w;
        height: menu.menu-h;
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea {
            width: root.width;
            height: root.height;
            clicked => { root.lp-active = -1; }
        }

        Icon {
            x: 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.copy;
            tint: Theme.fg;
        }

        TouchArea {
            x: 0px;
            width: menu.slot-w;
            height: 100%;
            // Read the row's text BEFORE closing the menu: `menu.msg` is bound
            // to `ChatSession.messages[root.lp-active]`, so setting lp-active
            // to -1 first would re-resolve it to an out-of-bounds (empty) row.
            clicked => { let t = menu.msg.text; root.lp-active = -1; AppState.copy-note(t); }
        }

        Icon {
            x: menu.slot-w + 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.collection;
            tint: Theme.fg;
        }

        TouchArea {
            x: menu.slot-w;
            width: menu.slot-w;
            height: 100%;
            // Read the row's text BEFORE closing the menu (same reason as copy).
            clicked => { let t = menu.msg.text; root.lp-active = -1; AppState.save-note(t); }
        }

        Icon {
            x: menu.slot-w * 2 + 12px;
            y: (menu.menu-h - 26px) / 2;
            size: 26px;
            glyph: Glyph.forward;
            tint: Theme.fg;
        }

        TouchArea {
            x: menu.slot-w * 2;
            width: menu.slot-w;
            height: 100%;
            clicked => {
                // Read the row's text BEFORE closing the menu (same reason as copy).
                let t = menu.msg.text;
                root.lp-active = -1;
                AppState.forward-target = t;
                AppState.nav-state = {
                    active-tab: 1,
                    tabs: AppState.nav-state.tabs,
                    global-overlay: AppState.nav-state.global-overlay,
                };
            }
        }
    }
}
