import { Button } from "std-widgets.slint";
import { ChatInputView } from "chat_input.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { GlobalOverlayType, AppState } from "../components/app_state.slint";
import { Header } from "../components/header.slint";

export struct MessageData {
    bubble: image,
    width: length,
    height: length,
    is_self: bool,
    text: string,
    selected: bool,
    top: length,
}

export global ChatSession {
    in property <bool> connect-status: false;
    in property <[MessageData]> messages: [];
    in property <string> send-status: "";
    in property <length> scroll-dist: 0px;
    in property <int> scroll-token: 0;
    in property <length> content-h: 0px;
    callback message-sent(int, string);
    callback update-scroll(int, length);
    callback scroll-request(int);
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    callback open-setting();
    callback press(int);
    callback release(int);
    callback copy-text(string);

    width: 100%;
    height: 100%;
    background: #f5f5f5;

    out property <length> msg-row-h: 56px;
    out property <length> input-h: 52px;
    out property <length> status-h: ChatSession.send-status != "" ? 20px : 0px;
    out property <length> _bottom: root.status-h + root.input-h;
    Header {
        name: "chat";

        Icon {
            width: 32px;
            height: 32px;
            size: 18px;
            glyph: Glyph.share;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => {
                    AppState.add-menu-type = 1;
                    AppState.nav-state.global-overlay = AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu
                        ? GlobalOverlayType.None
                        : GlobalOverlayType.AddMenu;
                }
            }
        }
    }

    ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        sent(t) => { ChatSession.message-sent(root.chat-id, t); }
    }

    if ChatSession.send-status != "":
    Text {
        x: 0px;
        y: parent.height - root.input-h - 20px;
        width: parent.width;
        height: 20px;
        text: ChatSession.send-status;
        color: #6b7280;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    in-out property <bool> scrolled: false;
    in-out property <bool> scroll-guard: false;
    in-out property <bool> requested: false;
    in-out property <length> last-reported: -1px;
    in-out property <int> my-token: 0;

    Timer {
        interval: 16ms;
        running: !root.requested;
        triggered => {
            root.requested = true;
            ChatSession.scroll-request(root.chat-id);
        }
    }

    fk := Flickable {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - root._bottom - 48px;
        content-height: ChatSession.content-h;
        interactive: ChatSession.messages.length > 0;

        Timer {
            interval: 16ms;
            running: root.my-token != ChatSession.scroll-token
                && fk.height > 0 && ChatSession.messages.length > 0;
            triggered => {
                root.my-token = ChatSession.scroll-token;
                let max = fk.content-height - fk.height;
                fk.content-y = (max > 0px) ? (ChatSession.scroll-dist - max) : 0px;
                root.last-reported = ChatSession.scroll-dist;
                root.scrolled = true;
                root.scroll-guard = true;
            }
        }

        Timer {
            interval: 16ms;
            running: root.scroll-guard;
            triggered => { root.scroll-guard = false; }
        }

        Timer {
            interval: 16ms;
            running: root.scrolled && !root.scroll-guard
                && fk.interactive && (fk.content-height > fk.height);
            triggered => {
                let d = (fk.content-height - fk.height) + fk.content-y;
                if (d < root.last-reported - 1px || d > root.last-reported + 1px) {
                    root.last-reported = d;
                    ChatSession.update-scroll(root.chat-id, d);
                }
            }
        }

        for msg[i] in ChatSession.messages: Rectangle {
            x: 0px;
            y: msg.top;
            width: parent.width;
            height: msg.height;

            TouchArea {
                x: msg.is-self ? parent.width - msg.width - 6px : 6px;
                y: 0px;
                width: msg.width;
                height: msg.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.press(i);
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.release(i);
                    }
                }
                Image {
                    source: msg.bubble;
                    width: msg.width;
                    height: msg.height;
                }
            }

            if msg.selected: Button {
                text: "复制";
                x: msg.is-self ? parent.width - msg.width - 6px - 64px : 6px + msg.width + 8px;
                y: 0px;
                width: 56px;
                height: 28px;
                clicked => { root.copy-text(msg.text); }
            }
        }
    }
}
