import { Button, Spinner } from "std-widgets.slint";
import { ChatInputView } from "chat_input.slint";
import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import {
    GlobalOverlayType,
    AppState,
    SubPageType,
} from "../components/app_state.slint";
import { Header } from "../components/header.slint";

export struct MessageData {
    bubble: image,
    width: length,
    height: length,
    is_self: bool,
    text: string,
    selected: bool,
    top: length,
    /// Empty for text rows; the local s16le clip path for voice rows.
    voice_path: string,
    /// Pre-formatted duration label ("M:SS") for voice rows.
    voice_label: string,
    /// Empty except for file rows; the local document path (pdf / docx / …) — tapping a PDF opens the in-app viewer.
    file_path: string,
    /// The sender's basename for file rows (shown on the file bubble).
    file_name: string,
    /// File rows only: which document icon to draw — 0 Word (.docx) · 1 Excel (.xlsx)
    /// · 2 PowerPoint (.pptx) · 3 PDF (anything else / -1 = the generic file glyph).
    file_kind: int,
    /// Empty for text/voice rows; the local photo path for image rows.
    image_path: string,
    /// The decoded chat photo (set for image rows; the `Image` element shows it,
    /// capped to the preview box by `width`/`height`).
    image_img: image,
    /// Sender avatar (right for own voice bubble, left for theirs).
    avatar: image,
    /// Time label shown below the voice bubble body (e.g. "14:32").
    voice_time: string,
    /// Image-row send badge: 0 none · 1 sending · 2 sent (✓) · 3 failed (!).
    /// Shown bottom-right over OWN image bubbles so a send reads as sending /
    /// sent / failed without a global spinner.
    send_state: int,
}

export global ChatSession {
    in property <bool> connect-status: false;
    in property <[MessageData]> messages: [];
    /// True while a message is being sent: the chat shows a spinner over the input.
    in property <bool> send-busy: false;
    /// Current link state of the counterparty in the open DM chat:
    ///   ""         offline / not applicable (hide dot)
    ///   "dialing"  connecting / hole-punching in flight (yellow-green)
    ///   "direct"   direct QUIC/TCP transport (green)
    ///   "relay"    connected via a relay circuit (yellow)
    /// Groups keep this "" (no dot). The chat header draws the dot itself
    /// based on this value, so `header.slint` stays generic.
    in property <string> conn: "";

    in property <length> scroll-dist: 0px;
    in property <int> scroll-token: 0;
    in property <length> content-h: 0px;
    /// Index into `messages` of the currently-playing voice bubble; -1 = none.
    in property <int> playing-idx: -1;
    /// Continuous rotation angle (degrees) of the playing record icon.
    /// Advanced by one Timer while `playing-idx >= 0`; frozen otherwise.
    in-out property <angle> spin: 0deg;
    callback message-sent(int, string);
    callback update-scroll(int, length);
    callback scroll-request(int);
    /// User tapped a voice bubble — start playback (Rust sets `playing-idx`).
    callback play-voice(int);
    /// User tapped the currently-playing bubble — stop (Rust clears `playing-idx`).
    callback stop-play();
    /// User tapped the image icon in the input bar — open the system photo
    /// picker for chat `key`, then send the chosen photo.
    callback sent-image(int);
    /// File icon tapped — open the file picker for chat `key`, then send the chosen document.
    callback sent-file(int);
    /// User tapped a photo bubble — open the full-screen viewer on `idx`.
    callback open-image(int);
    /// File bubble tapped — open the document (PDFs in the native in-app viewer).
    callback open-file(int);
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    callback open-setting();
    callback copy-text(string);

    width: 100%;
    height: 100%;
    background: Theme.bg;

    // ── long-press detection ───────────────────────────────────────────────
    in-out property <int> lp-armed: -1;
    in-out property <duration> lp-elapsed: 0s;
    in-out property <int> lp-active: -1;

    Timer {
        interval: 16ms;
        running: root.lp-armed >= 0 && root.lp-active < 0;
        triggered => {
            root.lp-elapsed += 16ms;
            if (root.lp-elapsed >= 1s) {
                root.lp-active = root.lp-armed;
                root.lp-armed = -1;
                root.lp-elapsed = 0s;
            }
        }
    }

    out property <length> msg-row-h: 56px;
    out property <length> input-h: input-bar.view-h;
    out property <length> _bottom: root.input-h;

    Timer {
        interval: 16ms;
        running: ChatSession.playing-idx >= 0;
        triggered => { ChatSession.spin += 3deg; }
    }

    Header {
        name: @tr("chat");

        // DM connection status dot (6px / 3px radius), placed in the header's
        // right zone (no impact on title centering):
        //   red          "offline"  — no link yet (baseline)
        //   yellow       "relay"    — connected via a relay circuit
        //   green        "direct"   — direct QUIC/TCP
        //   yellow-green "dialing"  — connecting / hole-punch in flight
        // Groups have no single peer, so this is DM-only.
        if !AppState.current-chat-is-group:
        Rectangle {
            x: 72px;
            y: (parent.height - 6px) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background:
                ChatSession.conn == "direct"  ? Theme.success
              : ChatSession.conn == "relay"   ? Theme.warning
              : ChatSession.conn == "dialing" ? #9ac457
              : Theme.danger;
        }

        if AppState.current-chat-key >= 0 && AppState.current-chat-is-group:

        Icon {
            x: 12px;
            y: 0px;
            width: 48px;
            height: 48px;
            size: 18px;
            glyph: Glyph.setting;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => { AppState.push-sub(SubPageType.ChatSetting, AppState.current-chat-key); }
            }
        }

        Icon {
            x: 48px;
            y: 0px;
            width: 48px;
            height: 48px;
            size: 18px;
            glyph: Glyph.call;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => {
                    AppState.add-menu-type = 1;
                    AppState.nav-state.global-overlay = AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu
                        ? GlobalOverlayType.None
                        : GlobalOverlayType.AddMenu;
                }
            }
        }
    }

    input-bar := ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        chat-id: root.chat-id;
        sent(t) => { ChatSession.message-sent(root.chat-id, t); }
        sent-image(id) => { ChatSession.sent-image(id); }
        sent-file(id) => { ChatSession.sent-file(id); }
    }

    // "Sending…" indicator (transient, shown only while a send is in flight) —
    // replaces the old always-present status text above the input. Failures
    // surface elsewhere as a transient toast (not pinned here).
    if ChatSession.send-busy:
    Spinner {
        x: (parent.width - 22px) / 2;
        y: parent.height - root.input-h - 32px;
        width: 22px;
        height: 22px;
    }
    in-out property <bool> requested: false;
    in-out property <int> my-token: 0;

    Timer {
        interval: 16ms;
        running: !root.requested;
        triggered => {
            root.requested = true;
            ChatSession.scroll-request(root.chat-id);
        }
    }

    fk := Flickable {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - root._bottom - 48px;
        content-height: ChatSession.content-h;
        interactive: ChatSession.messages.length > 0;

        flicked => {
            // User released a drag: remember where it landed (bottom=0, top=max).
            // Persisting only on real user drags keeps the "stuck to bottom"
            // memory intact across new messages, which the old per-frame report
            // used to clobber mid-re-layout and stall auto-scroll.
            ChatSession.update-scroll(
                root.chat-id,
                (fk.content-height - fk.height) + fk.content-y);
            if (root.my-token != ChatSession.scroll-token) {
                root.my-token = ChatSession.scroll-token;
            }
        }

        Timer {
            interval: 16ms;
            running: root.my-token != ChatSession.scroll-token
                && fk.height > 0 && ChatSession.messages.length > 0;
            triggered => {
                root.my-token = ChatSession.scroll-token;
                let max = fk.content-height - fk.height;
                fk.content-y = (max > 0px) ? (ChatSession.scroll-dist - max) : 0px;
            }
        }

        if root.lp-active >= 0:
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            clip: true;
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.lp-active = -1; }
            }
        }

        for msg[i] in ChatSession.messages: Rectangle {
            x: 0px;
            y: msg.top;
            width: parent.width;
            height: msg.height;

            // ── voice bubble (matching text-bubble proportions) ──────────
            if msg.voice_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // ── avatar (36×36, same size as the text-bubble avatar) ──
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self
                        ? parent.width - 6px - 36px
                        : 6px;
                    source: msg.avatar;
                }

                // ── bubble body (mic icon + duration, tap to play) ─────
                Rectangle {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 0px;
                    width: 72px;
                    height: 36px;
                    border-radius: 12px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    // record icon: 24×24, rotates (rotation-angle) while this row
                    // is playing, frozen at current angle otherwise.
                    Icon {
                        x: 4px;
                        y: 6px;
                        size: 24px;
                        glyph: Glyph.record;
                        tint: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        transform-rotation: ChatSession.playing-idx == i ? ChatSession.spin : 0deg;
                    }

                    Text {
                        x: 36px;
                        y: 0px;
                        width: 36px;
                        height: 100%;
                        text: msg.voice_label;
                        font-size: 12px;
                        color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if (ChatSession.playing-idx == i) {
                                ChatSession.stop-play();
                            } else {
                                ChatSession.play-voice(i);
                            }
                        }
                    }
                }

                // ── send time (same muted 11px style as text bubbles) ───
                Text {
                    x: msg.is_self
                        ? parent.width - 6px - 36px - 8px - 72px
                        : 6px + 36px + 8px;
                    y: 40px;
                    width: 72px;
                    height: 14px;
                    text: msg.voice_time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }
            }

            if msg.file_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self ? parent.width - 6px - 36px : 6px;
                    source: msg.avatar;
                }

                bubble := Rectangle {
                    y: 0px;
                    in property <length> cap-w: min(260px, parent.width - 54px);
                    width: min(max(43px + filename.preferred-width, 78px), cap-w);
                    x: msg.is_self ? parent.width - 50px - self.width : 50px;
                    height: 36px;
                    border-radius: 12px;
                    background: msg.is_self ? Theme.brand : Theme.surface;
                    clip: true;

                    Icon {
                        x: 5px;
                        y: 6px;
                        size: 24px;
                        glyph: msg.file_kind == 0 ? Glyph.file-word
                            : msg.file_kind == 1 ? Glyph.file-excel
                            : msg.file_kind == 2 ? Glyph.file-ppt
                            : msg.file_kind == 3 ? Glyph.file-pdf
                            : Glyph.file;
                        tint: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                    }

                    filename := Text {
                        x: 35px;
                        y: 0px;
                        width: parent.width - 43px;
                        height: 100%;
                        text: msg.file_name;
                        font-size: 12px;
                        overflow: elide;
                        color: msg.is_self ? Theme.fg-on-accent : Theme.fg;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => { ChatSession.open-file(i); }
                    }
                }

                Text {
                    x: msg.is_self ? parent.width - 50px - bubble.width : 50px;
                    y: 40px;
                    width: bubble.width;
                    height: 14px;
                    text: msg.voice_time;
                    font-size: 11px;
                    color: Theme.fg-muted;
                    horizontal-alignment: msg.is_self ? right : left;
                    vertical-alignment: center;
                }
            }

            // ── image bubble (only for image rows) ───────────────────────
            if msg.image_path != "":
            Rectangle {
                width: 100%;
                height: parent.height;

                // Avatar (36×36) sits on the outer edge, matching voice bubbles.
                Image {
                    width: 36px;
                    height: 36px;
                    y: 0px;
                    x: msg.is_self ? parent.width - 6px - 36px : 6px;
                    source: msg.avatar;
                }

                TouchArea {
                    x: msg.is_self ? parent.width - 6px - 36px - 8px - msg.width : 6px + 36px + 8px;
                    y: 0px;
                    width: msg.width;
                    height: msg.height;
                    clicked => { ChatSession.open-image(i); }

                    Image {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        source: msg.image_img;
                        image-fit: contain;
                    }
                }

                if msg.is_self && msg.send_state >= 1:
                Rectangle {
                    out property <length> bsz: 22px;
                    width: bsz;
                    height: bsz;
                    x: parent.width - 6px - 36px - 8px - bsz - 4px;
                    y: msg.height - bsz - 4px;
                    border-radius: bsz / 2;
                    // "sent" (2): white chip with a dark check ·
                    // "sending" (1): same chip, faded to read as in-flight ·
                    // "failed" (3): dark chip with a red "!".
                    background: msg.send_state == 3 ? Theme.bg : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    opacity: msg.send_state == 1 ? 0.55 : 1.0;

                    if msg.send_state == 3:
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "!";
                        color: Theme.danger;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if msg.send_state != 3:
                    Icon {
                        width: bsz;
                        height: bsz;
                        size: bsz - 8px;
                        glyph: Glyph.finish;
                        tint: Theme.fg;
                    }
                }
            }

            // ── text bubble (only for non-voice / non-image / non-file rows) ─
            if msg.voice_path == "" && msg.image_path == "" && msg.file_path == "":
            TouchArea {
                x: msg.is_self ? parent.width - msg.width - 6px : 6px;
                y: 0px;
                width: msg.width;
                height: msg.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.lp-armed = i;
                        root.lp-elapsed = 0s;
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        if (root.lp-armed == i) {
                            root.lp-armed = -1;
                        }
                    }
                }
                Image {
                    source: msg.bubble;
                    width: msg.width;
                    height: msg.height;
                }
            }
        }

        // Long-press icon menu. Rendered as the last child of the Flickable
        // (i.e. on top of every message row) so adjacent bubbles can never
        // cover it; positioned from the active row's geometry in content
        // coordinates.
        if root.lp-active >= 0:
        menu := Rectangle {
            out property <length> menu-w: 168px;
            out property <length> menu-h: 50px;
            out property <length> slot-w: menu.menu-w / 3;
            in property <MessageData> msg: ChatSession.messages[root.lp-active];
            out property <length> center-x:
                menu.msg.is_self ? parent.width - 6px - menu.msg.width / 2 : 6px + menu.msg.width / 2;
            out property <length> menu-x:
                max(6px, min(menu.center-x - menu.menu-w / 2, parent.width - menu.menu-w - 6px));
            x: menu.menu-x;
            // Placement in content coordinates: prefer above the bubble; if
            // that would clip at the viewport top, try below; if neither
            // fits (bubble at the very bottom), clamp so the menu stays
            // fully inside the visible viewport.
            out property <length> vp-top: fk.content-y;
            out property <length> vp-bottom: fk.content-y + fk.height;
            out property <length> y-above: menu.msg.top - menu.menu-h - 8px;
            out property <length> y-below: menu.msg.top + menu.msg.height + 8px;
            y: max(menu.vp-top, min(
                (menu.y-above >= menu.vp-top)
                ? menu.y-above
                : (menu.y-below + menu.menu-h <= menu.vp-bottom ? menu.y-below : menu.y-above),
                menu.vp-bottom - menu.menu-h));
            width: menu.menu-w;
            height: menu.menu-h;
            border-radius: menu.menu-h / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.lp-active = -1; }
            }

            Icon {
                x: 12px;
                y: (menu.menu-h - 26px) / 2;
                size: 26px;
                glyph: Glyph.copy;
                tint: Theme.fg;
            }

            TouchArea {
                x: 0px;
                width: menu.slot-w;
                height: 100%;
                // Read the row's text BEFORE closing the menu: `menu.msg` is bound
                // to `ChatSession.messages[root.lp-active]`, so setting lp-active
                // to -1 first would re-resolve it to an out-of-bounds (empty) row.
                clicked => { let t = menu.msg.text; root.lp-active = -1; AppState.copy-note(t); }
            }

            Icon {
                x: menu.slot-w + 12px;
                y: (menu.menu-h - 26px) / 2;
                size: 26px;
                glyph: Glyph.collection;
                tint: Theme.fg;
            }

            TouchArea {
                x: menu.slot-w;
                width: menu.slot-w;
                height: 100%;
                // Read the row's text BEFORE closing the menu (same reason as copy).
                clicked => { let t = menu.msg.text; root.lp-active = -1; AppState.save-note(t); }
            }

            Icon {
                x: menu.slot-w * 2 + 12px;
                y: (menu.menu-h - 26px) / 2;
                size: 26px;
                glyph: Glyph.forward;
                tint: Theme.fg;
            }

            TouchArea {
                x: menu.slot-w * 2;
                width: menu.slot-w;
                height: 100%;
                clicked => {
                    // Read the row's text BEFORE closing the menu (same reason as copy).
                    let t = menu.msg.text;
                    root.lp-active = -1;
                    AppState.forward-target = t;
                    AppState.nav-state = {
                        active-tab: 1,
                        tabs: AppState.nav-state.tabs,
                        global-overlay: AppState.nav-state.global-overlay,
                    };
                }
            }
        }
    }
}
