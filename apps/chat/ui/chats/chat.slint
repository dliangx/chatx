import {
    ScrollView,
    VerticalBox,
    HorizontalBox,
    Button,
} from "std-widgets.slint";

export struct MessageData {
    bubble: image,
    width: length,
    height: length,
    is_self: bool,
    text: string,
    selected: bool,
}

export component ChatView inherits Rectangle {
    in property <int> chat-id;
    in property <[MessageData]> messages;
    callback on-back();
    callback open-setting();
    callback press(int);
    callback release(int);
    callback copy-text(string);
    preferred-height: 932px;
    preferred-width: 440px;
    background: #e5e5e5;

    VerticalBox {

        ScrollView {
            VerticalBox {
                width: parent.width;
                alignment: start;
                padding: 0px;

                for msg[i] in messages: Rectangle {
                    width: parent.width;
                    height: msg.height + 24px;

                    TouchArea {
                        x: msg.is_self ? parent.width - msg.width - 6px : 6px;
                        y: 4px;
                        width: msg.width;
                        height: msg.height;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.press(i);
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                root.release(i);
                            }
                        }
                        Image {
                            source: msg.bubble;
                            width: msg.width;
                            height: msg.height;
                        }
                    }

                    if msg.selected: Button {
                        text: "复制";
                        x: msg.is_self ? parent.width - msg.width - 6px - 64px : 6px + msg.width + 8px;
                        y: 4px;
                        width: 56px;
                        height: 28px;
                        clicked => { root.copy-text(msg.text); }
                    }
                }
            }
        }
    }
}
