
export global Theme {
    in property <brush> fg: #333333;        // 主文本 / 主图标
    in property <brush> fg-muted: #9aa0b4;  // 次要文本
    in property <brush> brand: #7d54cd;       // 品牌主色（选中态文字）
    in property <brush> brand-soft: #f1ebfa;  // 品牌色高亮背景（选中态衬底）
    in property <brush> bg: #f5f5f5;        // 背景
    in property <brush> border: #ececec;    // 分隔线
}
