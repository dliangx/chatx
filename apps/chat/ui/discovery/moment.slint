import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { AppState } from "../components/app_state.slint";
import { ScrollView } from "std-widgets.slint";

/// Draft state for the moment (publish) page. Driven by Slint inputs and
/// committed by Rust when the publish button is pressed (persists to sqlite, then pops).
export global MomentState {
    in-out property <string> title: "";
    in-out property <string> content: "";
    in property <[image]> media: [];
    in property <string> status: "";
    in property <bool> publishing: false;

    callback pick-photos();
    callback remove-photo(int);
    callback publish();
}

export component AddMomentView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> gap: 10px;
    // Image grid: 2-col, 4:3 cells at the same size as the discover feed.
    out property <int> media-cols: 3;
    out property <length> media-pad: 8px;
    out property <length> grid-gap: 8px;
    out property <length> card-w: root.width - 16px;
    out property <length> tile-w: (root.card-w - 2 * root.media-pad - (root.media-cols + 1) * root.grid-gap) / root.media-cols;
    out property <length> tile-h: root.tile-w * 4 / 3;
    out property <bool> add-vis: MomentState.media.length < 9;
    out property <int> total-slots: MomentState.media.length + (root.add-vis ? 1 : 0);
    out property <int> media-rows:
        root.total-slots > 0
        ? floor((root.total-slots + root.media-cols - 1) / root.media-cols)
        : 1;
    out property <length> card-h:
        2 * root.media-pad
        + root.media-rows * root.tile-h
        + (root.media-rows - 1) * root.grid-gap;
    out property <length> editor-h: 220px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;

        Header {
            name: "Share a moment";
            back-vis: true;
        }

        // Scrollable body: image grid + content entry. When there are many
        // photos the grid grows past the viewport, so it lives in a ScrollView
        // instead of a fixed layout; header + publish footer stay pinned.
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: 100%;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                // Image grid (top): covers in a grid box + an "add from album" tile.
                Rectangle {
                    width: 100%;
                    height: root.card-h;
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    for m[i] in MomentState.media: Rectangle {
                        x: root.media-pad + (root.tile-w + root.grid-gap) * Math.mod(i, root.media-cols);
                        y: root.media-pad + (root.tile-h + root.grid-gap) * floor(i / root.media-cols);
                        width: root.tile-w;
                        height: root.tile-h;
                        border-radius: 8px;
                        clip: true;
                        background: #111111;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: m;
                            image-fit: cover;
                        }

                        // Remove (top-right).
                        Rectangle {
                            x: root.tile-w - 24px;
                            y: 2px;
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #000000aa;

                            Icon {
                                x: (parent.width - self.size) / 2;
                                y: (parent.height - self.size) / 2;
                                glyph: Glyph.close;
                                size: 13px;
                                tint: #ffffff;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => { MomentState.remove-photo(i); }
                            }
                        }
                    }

                    // Add-from-album tile (only while < 9 photos to keep the grid tidy).
                    if root.add-vis:
                    Rectangle {
                        x: root.media-pad + (root.tile-w + root.grid-gap) * Math.mod(
                                MomentState.media.length, root.media-cols);
                        y: root.media-pad + (root.tile-h + root.grid-gap) * floor(
                                MomentState.media.length / root.media-cols);
                        width: root.tile-w;
                        height: root.tile-h;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.brand-soft;

                        Icon {
                            x: (parent.width - self.size) / 2;
                            y: (parent.height - self.size) / 2;
                            glyph: Glyph.picture;
                            size: 28px;
                            tint: Theme.brand;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { MomentState.pick-photos(); }
                        }
                    }
                }

                // Content entry card (below the images).
                Rectangle {
                    width: 100%;
                    height: root.editor-h;
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    Flickable {
                        x: 1px;
                        y: 1px;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        interactive: true;

                        ph-content := Text {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            visible: MomentState.content == "";
                            text: "Your thoughts on this moment…";
                            font-size: 15px;
                            color: Theme.fg-muted;
                            vertical-alignment: top;
                        }

                        TextInput {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            min-height: parent.height - 24px;
                            text <=> MomentState.content;
                            font-size: 15px;
                            color: Theme.fg;
                            vertical-alignment: top;
                            wrap: word-wrap;
                            single-line: false;
                            selection-background-color: Theme.brand-soft;
                            selection-foreground-color: Theme.brand;
                        }
                    }
                }
            }
        }

        // Footer: status + publish button.
        if MomentState.status != "":
        Text {
            width: 100%;
            height: 20px;
            text: MomentState.status;
            font-size: 12px;
            color: #6b7280;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 48px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: Theme.border;

            Rectangle {
                x: parent.width - 128px;
                y: 8px;
                width: 112px;
                height: 32px;
                border-radius: 16px;
                background: MomentState.publishing
                    ? #c9c9c9
                    : ((MomentState.content != "" || MomentState.media.length > 0)
                    ? Theme.brand
                    : #c9c9c9);

                Text {
                    width: 100%;
                    height: 100%;
                    text: MomentState.publishing ? "Publishing…" : "Publish";
                    font-size: 14px;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if !MomentState.publishing { MomentState.publish(); }
                    }
                }
            }
        }
    }
}
