import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { ChatInputView } from "../chats/chat_input.slint";
import { SubPageType, AppState } from "../components/app_state.slint";

export struct CommentRow {
    name: string,
    text: string,
    is-mine: bool,
    time-label: string,
}

export global PostDetailState {
    in property <int> key: -1;
    in property <string> title;
    in property <string> author;
    in property <string> liked-by;
    in property <string> time;
    in property <bool> liked: false;
    in property <int> likes: 0;
    in property <int> comments: 0;
    in property <[image]> media: [];
    in property <[CommentRow]> comment-list: [];
    in property <string> status;

    callback request-load(int);
    callback toggle-like(int);
    callback add-comment(int, string);
}

export component DiscoverDetailView inherits Rectangle {
    in property <int> key;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> input-h: 52px;
    out property <length> status-h: PostDetailState.status != "" ? 20px : 0px;
    out property <length> bottom: root.status-h + root.input-h;
    out property <length> row-h: 64px;
    out property <length> like-by-h: PostDetailState.liked-by != "" ? 24px : 0px;

    // Image grid: same size + layout as the discover feed (2 cols, 4:3).
    out property <length> grid-gap: 8px;
    out property <int> n-cols: 3;
    out property <length> tile-w: (root.width - (root.n-cols + 1) * root.grid-gap) / root.n-cols;
    out property <length> tile-h: root.tile-w * 4 / 3;
    out property <int> media-rows: PostDetailState.media.length > 0
        ? floor((PostDetailState.media.length + root.n-cols - 1) / root.n-cols)
        : 0;
    out property <length> media-h: root.media-rows > 0
        ? root.media-rows * root.tile-h + (root.media-rows - 1) * root.grid-gap
        : 0px;

    // Body text sits below the image grid (no separate title).
    out property <length> content-h: PostDetailState.title != "" ? 56px : 0px;

    out property <length> media-y: 10px;
    out property <length> content-y: root.media-y + root.media-h + (root.media-h > 0 ? 8px : 0px);
    out property <length> author-y: root.content-y + root.content-h + (root.content-h > 0 ? 8px : 0px);
    out property <length> like-y: root.author-y + 20px + 8px;

    out property <length> top-h:
        root.like-y + 30px + root.like-by-h + 10px + 1px + 28px;
    out property <length> view-h: root.top-h + PostDetailState.comment-list.length * root.row-h + 48px;

    Timer {
        interval: 40ms;
        running: root.visible && PostDetailState.key != root.key;
        triggered => {
            PostDetailState.request-load(root.key);
        }
    }

    Header {
        name: "discover";
        back-vis: back-vis();
    }

    function back-vis() -> bool {
        if AppState.nav-state.active-tab == 3 && AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].page == SubPageType.DiscoverDetail {
            return true;
        } else {
            return false;
        }
    }
    if PostDetailState.status != "":
    Text {
        x: 0px;
        y: parent.height - root.bottom - 20px;
        width: parent.width;
        height: 20px;
        text: PostDetailState.status;
        color: #6b7280;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ChatInputView {
        x: 0px;
        y: parent.height - root.input-h;
        width: parent.width;
        height: root.input-h;
        placeholder-text: "Write a comment…";
        sent(t) => { PostDetailState.add-comment(root.key, t); }
    }

    Flickable {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - root.bottom - 48px;
        content-height: root.view-h;
        interactive: root.view-h > parent.height - root.bottom - 48px;

        for m[i] in PostDetailState.media: Rectangle {
            x: root.grid-gap + (root.tile-w + root.grid-gap) * Math.mod(i, root.n-cols);
            y: root.media-y + (root.tile-h + root.grid-gap) * floor(i / root.n-cols);
            width: root.tile-w;
            height: root.tile-h;
            border-radius: 8px;
            clip: true;
            background: #111;
            Image {
                width: 100%;
                height: 100%;
                source: m;
                image-fit: cover;
            }
        }

        if PostDetailState.title != "":
        Text {
            x: 16px;
            y: root.content-y;
            width: parent.width - 32px;
            height: 56px;
            text: PostDetailState.title;
            font-size: 17px;
            font-weight: 700;
            color: Theme.fg;
            wrap: word-wrap;
            overflow: elide;
        }

        Text {
            x: 16px;
            y: root.author-y;
            width: parent.width - 32px;
            height: 20px;
            text: (PostDetailState.author != "" ? PostDetailState.author + "   ·   " : "") + PostDetailState.time;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.fg-muted;
        }

        Icon {
            x: 18px;
            y: root.like-y + 4px;
            size: 22px;
            glyph: Glyph.heart;
            tint: PostDetailState.liked ? #ff2442 : Theme.fg-muted;
        }

        Text {
            x: 46px;
            y: root.like-y;
            width: 120px;
            height: 22px;
            text: PostDetailState.likes;
            font-size: 13px;
            vertical-alignment: center;
            color: PostDetailState.liked ? #ff2442 : Theme.fg-muted;
        }

        Text {
            x: parent.width - 160px;
            y: root.like-y;
            width: 140px;
            height: 22px;
            text: PostDetailState.comments + " comments";
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Theme.fg-muted;
        }

        TouchArea {
            x: 12px;
            y: root.like-y - 2px;
            width: 150px;
            height: 28px;
            clicked => { PostDetailState.toggle-like(root.key); }
        }

        if PostDetailState.liked-by != "":
        Text {
            x: 16px;
            y: root.like-y + 26px;
            width: parent.width - 32px;
            height: 18px;
            text: PostDetailState.liked-by;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            color: #ff2442;
        }

        Rectangle {
            x: 0px;
            y: root.like-y + 30px + root.like-by-h;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        Text {
            x: 16px;
            y: root.like-y + 31px + root.like-by-h;
            width: parent.width - 32px;
            height: 26px;
            text: PostDetailState.comment-list.length > 0 ? ("Total " + PostDetailState.comment-list.length + " comments") : "Comments";
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: Theme.fg;
        }

        if PostDetailState.comment-list.length == 0:
        Text {
            x: 0px;
            y: root.top-h + 16px;
            width: parent.width;
            height: 28px;
            text: "No comments yet. Write the first one.";
            font-size: 13px;
            horizontal-alignment: center;
            color: Theme.fg-muted;
        }

        for c[i] in PostDetailState.comment-list: Rectangle {
            x: 0px;
            y: root.top-h + i * root.row-h;
            width: parent.width;
            height: root.row-h;
            background: c.is-mine ? Theme.brand-soft : Colors.transparent;

            Rectangle {
                x: 16px;
                y: 8px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: c.is-mine ? Theme.brand : #a0aec0;
            }

            Text {
                x: 62px;
                y: 6px;
                width: parent.width - 70px;
                height: 18px;
                text: c.name;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                color: c.is-mine ? Theme.brand : Theme.fg-muted;
            }

            Text {
                x: 62px;
                y: 26px;
                width: parent.width - 70px;
                height: 30px;
                text: c.text;
                font-size: 14px;
                wrap: word-wrap;
                overflow: elide;
                color: Theme.fg;
            }
        }
    }
}
