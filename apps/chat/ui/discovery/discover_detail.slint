import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { SubPageType, AppState } from "../components/app_state.slint";

export struct CommentRow {
    name: string,
    text: string,
    is-mine: bool,
    time-label: string,
}

export global PostDetailState {
    in property <int> key: -1;
    in property <string> title;
    in property <string> author;
    in property <string> liked-by;
    in property <string> time;
    in property <bool> liked: false;
    in property <int> likes: 0;
    in property <int> comments: 0;
    in property <[image]> media: [];
    in property <[CommentRow]> comment-list: [];
    in property <string> status;

    callback request-load(int);
    callback toggle-like(int);
    callback add-comment(int, string);
    callback clear-comment();
    // Tapping a media tile opens the full-screen image viewer on this index
    // (kept here, next to `media`, so `ImageViewer` can snapshot both on mount).
    in-out property <int> image-index: 0;
}

// The detail page is a single scrolling column (media / body / like row), with
// the comment section in its own fixed-height Flickable and the comment input
// pinned to the bottom — so no `for`-loop cells ever need to feed the page's
// auto content-height (see slint #407), and the page never grows past its
// viewport.
export component DiscoverDetailView inherits Rectangle {
    in property <int> key;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> status-h: PostDetailState.status != "" ? 20px : 0px;

    // Image grid — 3-column, 4:3 tiles (identical to the discover feed).
    out property <length> grid-gap: 8px;
    out property <int> n-cols: 3;
    out property <length> tile-w: (root.width - (root.n-cols + 1) * root.grid-gap) / root.n-cols;
    out property <length> tile-h: root.tile-w * 4 / 3;
    out property <int> media-rows: PostDetailState.media.length > 0
        ? floor((PostDetailState.media.length + root.n-cols - 1) / root.n-cols)
        : 0;
    out property <length> media-h: root.media-rows > 0
        ? root.media-rows * root.tile-h + (root.media-rows - 1) * root.grid-gap
        : 0px;

    // Comment input box (pinned to the bottom). It grows with the text (measured
    // by a hidden `measure` Text, since a `TextInput` reports no natural height)
    // up to `input-h-max`, after which it scrolls inside.
    out property <length> input-h-min: 88px;
    out property <length> input-h-max: 240px;
    out property <length> input-pad: 10px;
    out property <length> input-field-w: root.width - 24px - 28px;
    out property <length> input-raw-h: imeasure.preferred-height;
    out property <length> input-h: min(root.input-h-max, max(root.input-h-min,
        root.input-raw-h + 2 * root.input-pad));
    out property <length> input-view-h: root.input-h - 2 * root.input-pad;
    out property <length> input-content-h: max(root.input-view-h, root.input-raw-h);

    Header {
        name: @tr("discover");
        back-vis: back-vis();
    }

    function back-vis() -> bool {
        if AppState.nav-state.active-tab == 3 && AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-history[
                    AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top].page == SubPageType.DiscoverDetail {
            return true;
        } else {
            return false;
        }
    }

    // Load the post once this page is shown for a given key. (The old second
    // `Timer` that asked Rust to re-measure body/comment heights is gone — the
    // layout now self-sizes, so no Rust `relayout` is needed.)
    Timer {
        interval: 40ms;
        running: root.visible && PostDetailState.key != root.key;
        triggered => {
            PostDetailState.request-load(root.key);
        }
    }

    if PostDetailState.status != "":
    Text {
        x: 0px;
        y: parent.width == 0 ? 0px : parent.height - 20px;
        width: parent.width;
        height: 20px;
        text: PostDetailState.status;
        color: Theme.brand;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Flickable {
        x: 0px;
        y: 48px;
        width: parent.width;
        height: parent.height - 48px - root.input-h - root.status-h - 12px;
        interactive: true;

        VerticalLayout {
            width: 100%;
            spacing: 8px;
            padding-top: 10px;
            padding-bottom: 12px;
            padding-left: 16px;
            padding-right: 16px;

            // 1) Media grid (fixed tile height).
            if root.media-h > 0px:
            Rectangle {
                width: 100%;
                height: root.media-h;
                border-radius: 8px;
                clip: true;

                for m[i] in PostDetailState.media: Rectangle {
                    x: root.grid-gap + (root.tile-w + root.grid-gap) * Math.mod(i, root.n-cols);
                    y: (root.tile-h + root.grid-gap) * floor(i / root.n-cols);
                    width: root.tile-w;
                    height: root.tile-h;
                    border-radius: 8px;
                    clip: true;
                    background: #111;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: m;
                        image-fit: cover;
                    }

                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            PostDetailState.image-index = i;
                            AppState.open-image-viewer();
                        }
                    }
                }
            }

            // 2) Post body — auto height (wraps, never clipped).
            if PostDetailState.title != "":
            Text {
                text: PostDetailState.title;
                font-size: 17px;
                font-weight: 500;
                color: Theme.fg;
                wrap: word-wrap;
                vertical-alignment: top;
            }

            // 3) Author + time (one line).
            Text {
                height: 20px;
                text: (PostDetailState.author != "" ? PostDetailState.author + "   ·   " : "") + PostDetailState.time;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                color: Theme.fg-muted;
            }

            // 4) Like row.
            HorizontalLayout {
                alignment: start;
                spacing: 8px;

                Icon {
                    size: 22px;
                    glyph: Glyph.heart;
                    tint: PostDetailState.liked ? Theme.like : Theme.fg-muted;
                }

                Text {
                    width: 120px;
                    text: PostDetailState.likes;
                    font-size: 13px;
                    vertical-alignment: center;
                    color: PostDetailState.liked ? #ff2442 : Theme.fg-muted;
                }

                TouchArea {
                    horizontal-stretch: 1;
                    clicked => { PostDetailState.toggle-like(root.key); }
                }

                Text {
                    text: @tr("{} comments", PostDetailState.comments);
                    font-size: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.fg-muted;
                }
            }

            // 5) Liked-by (optional).
            if PostDetailState.liked-by != "":
            Text {
                height: 18px;
                text: PostDetailState.liked-by;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                color: Theme.like;
            }

            // 6) Divider + section header.
            Rectangle {
                width: 100%;
                height: 1px;
                background: Theme.border;
            }

            Text {
                height: 24px;
                text: PostDetailState.comment-list.length > 0
                    ? @tr("Total {} comments", PostDetailState.comment-list.length)
                    : @tr("Comments");
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                color: Theme.fg;
            }

            // 7) Empty state — a plain layout row shown right after the header,
            //    so it's visible without scrolling (not buried in a tall Flickable).
            if PostDetailState.comment-list.length == 0:
            Text {
                width: 100%;
                height: 28px;
                text: @tr("No comments yet. Write the first one.");
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.fg-muted;
            }

            // 8) Comment list — one cell per row. Each cell's body height is
            // measured by a hidden `Text` (same font/width/wrap as the visible
            // body) so Slint does the text layout; the outer VerticalLayout
            // then accumulates each cell's `min-height` into its own, which
            // the outer Flickable reads via `min-height`. No Rust-computed
            // absolute y/h / content-height.
            if PostDetailState.comment-list.length > 0:
            VerticalLayout {
                width: 100%;
                spacing: 8px;

                for c[i] in PostDetailState.comment-list: card := Rectangle {
                    width: 100%;
                    background: c.is-mine ? Theme.surface : Colors.transparent;
                    border-radius: 8px;
                    clip: true;

                    // Measures the body's true laid-out height in this column
                    // width (no manual wrap_lines / per-line math).
                    measure := Text {
                        width: parent.width - 16px;
                        text: c.text;
                        font-size: 14px;
                        wrap: word-wrap;
                        visible: false;
                        accessible-role: none;
                    }
                    out property <length> body-h: max(measure.preferred-height, 16px);
                    height: 46px + card.body-h + 8px;

                    // Header row: avatar + name.
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: c.is-mine ? Theme.brand : Theme.mute;
                    }

                    Text {
                        x: 46px;
                        y: 8px;
                        width: parent.width - 54px;
                        height: 30px;
                        text: c.name;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                        color: c.is-mine ? Theme.brand : Theme.fg-muted;
                    }

                    // Body — full text; height derived from the measured
                    // `body-h` above so the cell's `min-height` is exact.
                    Text {
                        x: 8px;
                        y: 46px;
                        width: parent.width - 16px;
                        height: card.body-h;
                        text: c.text;
                        font-size: 14px;
                        color: Theme.fg;
                        wrap: word-wrap;
                        overflow: clip;
                        vertical-alignment: top;
                    }
                }
            }
        }
    }

    // Comment input pinned to the bottom (never scrolled away). Long text
    // scrolls inside the box.
    Rectangle {
        x: 16px;
        y: root.status-h == 0px ? parent.height - 12px - root.input-h
            : parent.height - root.status-h - root.input-h;
        width: parent.width - 32px;
        height: root.input-h;
        border-radius: 10px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        // Measures the text's natural height; drives the box height so it grows
        // with the content (a `TextInput` reports no natural height).
        imeasure := Text {
            x: 0px;
            y: 0px;
            width: root.input-field-w;
            text: cedit.text;
            font-size: 15px;
            wrap: word-wrap;
            visible: false;
            accessible-role: none;
        }

        Flickable {
            x: 14px;
            y: root.input-pad;
            width: root.input-field-w;
            height: root.input-view-h;
            content-height: root.input-content-h;
            interactive: true;

            cedit := TextInput {
                x: 0px;
                y: 0px;
                width: 100%;
                height: max(root.input-view-h, root.input-raw-h);
                font-size: 15px;
                color: Theme.fg;
                vertical-alignment: top;
                wrap: word-wrap;
                single-line: false;
                selection-background-color: Theme.brand-soft;
                selection-foreground-color: Theme.brand;
            }

            placeholder := Text {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 20px;
                text: @tr("Write a comment…");
                color: Theme.fg-muted;
                font-size: 15px;
                vertical-alignment: top;
                visible: cedit.text == "";
                accessible-role: none;
            }
        }

        Rectangle {
            x: parent.width - 78px;
            y: parent.height - 48px;
            width: 68px;
            height: 32px;
            border-radius: 16px;
            background: cedit.text == "" ? Theme.disabled : Theme.brand;

            Text {
                width: 100%;
                height: 100%;
                text: @tr("Send");
                font-size: 13px;
                color: Theme.fg-on-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    if (cedit.text != "") {
                        PostDetailState.add-comment(root.key, cedit.text);
                        cedit.text = "";
                    }
                }
            }
        }
    }
}
