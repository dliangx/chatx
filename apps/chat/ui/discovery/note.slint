import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { Header } from "../components/header.slint";
import { AppState } from "../components/app_state.slint";

export global NoteState {
    in-out property <string> draft: "";

    callback note-saved(string);
}

export component AddNoteView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> footer-h: 64px;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 0px;
        padding-bottom: 0px;
        spacing: 8px;

        Header {
            name: @tr("note");
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                interactive: true;

                TextInput {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    min-height: parent.height - 24px;
                    text <=> NoteState.draft;
                    font-size: 15px;
                    color: Theme.fg;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    single-line: false;
                    text-cursor-width: 3px;
                    selection-background-color: Theme.brand;
                    selection-foreground-color: white;
                }
            }
        }

        Rectangle {
            height: root.footer-h;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;

            Rectangle {
                x: parent.width - 128px;
                y: (root.footer-h - 32px) / 2;
                width: 112px;
                height: 32px;
                border-radius: 16px;
                background: NoteState.draft != "" ? Theme.brand : Theme.disabled;

                Text {
                    width: 100%;
                    height: 100%;
                    text: @tr("Save");
                    font-size: 14px;
                    color: Theme.fg-on-accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if NoteState.draft != "" {
                            NoteState.note-saved(NoteState.draft);
                            NoteState.draft = "";
                            AppState.pop-sub();
                        }
                    }
                }
            }
        }
    }
}
