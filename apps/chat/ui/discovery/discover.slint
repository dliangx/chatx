import { CardView } from "../components/card.slint";
import { Theme } from "../theme.slint";
import { SubPageType } from "../components/nav_state.slint";
import { DiscoverCard } from "../components/app_state.slint";

export component DiscoverView inherits Rectangle {
    in property <[DiscoverCard]> cards: [];
    callback navigate-to(SubPageType, int);
    callback like-toggled(int);

    width: 100%;
    height: 100%;
    background: Theme.bg;

    out property <length> gap: 8px;
    out property <length> col-w: (root.width - 3 * root.gap) / 2;   // 单列卡片宽
    out property <length> card-h: root.col-w * 4 / 3 + 90px;        // 卡片高（与 CardView.content-h 一致）
    out property <length> viewport-h: root.gap + root.cards.length * (root.card-h + root.gap) / 2;

    if root.cards.length == 0:
    Text {
        y: 180px;
        text: "暂无内容";
        horizontal-alignment: center;
        font-size: 14px;
        color: Theme.fg-muted;
    }

    Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewport-height: root.viewport-h;
        interactive: true;

        for card[i] in root.cards: CardView {
            x: root.gap + (root.col-w + root.gap) * Math.mod(i, 2);
            y: root.gap + (root.card-h + root.gap) * floor(i / 2);
            width: root.col-w;
            title: card.title;
            user: card.user;
            is-liked: card.liked;
            likes: card.likes;
            id: card.id;
            clicked(id) => { root.navigate-to(SubPageType.DiscoverDetail, id); }
            like-toggled => { root.like-toggled(card.id); }
        }
    }
}
