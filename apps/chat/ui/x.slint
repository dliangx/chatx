import { AppState } from "components/app_state.slint";
import { Theme } from "./theme.slint";
import { Glyph, Icon } from "components/icon.slint";

// Backing state for the mini-app (wasm plugin) overlay. The Rust side
// (apps/chat/src/xhost.rs) fills `frame` from `PluginInstance::take_frame()`
// on every 16 ms `pump-mini-app` tick and flips `failed` when the instance
// dies before first paint.
export global AppHost {
    in property <image> frame;
    in property <bool> running: false;
    in property <bool> failed: false;
    // View-state the pdfview plugin reports through `x_view_state`; the pump
    // mirrors it here so the top-bar (mode icons + page counter) always
    // reflects the plugin's active page / count / mode.
    in property <int> page: 0;
    in property <int> page-count: 0;
    // Active view mode: 1 = fit-width, 2 = fit-height (the wasmhost
    // `VIEW_MODE_*` codes, shared with appsdk).
    in property <int> mode: 1;
    // Input → plugin. `touch` kinds (appsdk EV_* codes): 1 = down, 2 = move,
    // 3 = up; x/y are logical canvas px (the host scales to device px).
    callback touch(int, int, int);
    // Wheel / trackpad scroll: vertical delta in logical px from the
    // TouchArea's `scroll-event` (Slint convention: negative = the user
    // scrolled down, toward later content). The host scales to device px
    // and forwards it to the plugin as an `EV_SCROLL` event.
    callback scroll(float);
    // Toolbar → plugin: switch the rendered view mode (1 = fit-width,
    // 2 = fit-height). The plugin honours it over its input channel and
    // reports the new mode back on its next frame.
    callback set-mode(int);
    // Close = destroy the plugin instance + hide the overlay.
    callback close();
    // Minimize = hide the overlay only; the instance keeps running and the
    // "open sandbox app" entry brings it back (no restart).
    callback minimize();
    // Minimized (docked): the overlay is hidden but the instance is still
    // running — main.slint then shows the floating dock pill (MiniAppDock)
    // in the corner. A click on it restores the overlay; press-and-drag
    // repositions it.
    in property <bool> minimized: false;
    // Dock pill position in logical px (set by MiniAppDock while dragging).
    // Persisted on the global instead of the dock component so the
    // user-placed position survives minimize → restore → minimize cycles
    // (the dock component is destroyed while the overlay is shown).
    in-out property <length> dock-x: 0px;
    in-out property <length> dock-y: 0px;
    // False until the user dragged the pill once: while false the dock sits
    // at its default top-right corner.
    in-out property <bool> dock-set: false;
    // Dock pill clicked (a tap, not a drag): re-show the mini-app overlay.
    callback restore();
}

// ── Minimized mini-app dock pill ──────────────────────────────────────────
// Shown by main.slint while a mini-app is minimized: a floating 44×44 pill,
// at the top-right corner by default. A short click (press + release within
// ~6 px) calls AppHost.restore() to bring the overlay back; press-and-drag
// repositions the pill anywhere inside the window (clamped to its edges).
// The placed position is stored on AppHost so it is remembered across
// restore cycles. `win-w`/`win-h` are the current window size, passed in by
// main.slint (`.slint` has no `window()` accessor).
export component MiniAppDock inherits Rectangle {
    in property <length> win-w: 0px;
    in property <length> win-h: 0px;
    width: 44px;
    height: 44px;
    // Default slot: top-right corner with a 12 px margin. The x/y bindings
    // clamp the stored position to the window, which also keeps a
    // user-placed pill on-screen if the window later shrinks.
    x: AppHost.dock-set
        ? min(max(AppHost.dock-x, 0px), max(win-w - self.width, 0px))
        : min(max(win-w - self.width - 12px, 0px), max(win-w - self.width, 0px));
    y: AppHost.dock-set
        ? min(max(AppHost.dock-y, 0px), max(win-h - self.height, 0px))
        : 16px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(16, 18, 24, 0.6);

    Icon {
        x: 11px;
        y: 11px;
        size: 22px;
        glyph: Glyph.app;
        tint: #ffffff;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        // Position of the *pill* when the press started (so the release
        // handler can tell a click from a drag) and the grab offset in
        // pill coordinates (so the drag follows the pointer without
        // jumping).
        in-out property <length> start-x: 0px;
        in-out property <length> start-y: 0px;
        in-out property <length> grab-dx: 0px;
        in-out property <length> grab-dy: 0px;

        changed pressed => {
            if ta.pressed {
                ta.start-x = parent.x;
                ta.start-y = parent.y;
                ta.grab-dx = ta.mouse-x - parent.x;
                ta.grab-dy = ta.mouse-y - parent.y;
                return;
            }
            if abs(parent.x - ta.start-x) < 6px
                && abs(parent.y - ta.start-y) < 6px {
                // A tap → restore the overlay.
                AppHost.restore();
            } else {
                // A drag → persist the final position (the pill's x/y are
                // clamped bindings, so this is always on-screen).
                AppHost.dock-x = parent.x;
                AppHost.dock-y = parent.y;
                AppHost.dock-set = true;
            }
        }
        moved => {
            if !ta.pressed {
                return;
            }
            // Raw pointer position; the pill's x/y bindings clamp to the
            // window on the fly while the drag is in progress.
            AppHost.dock-x = ta.mouse-x - ta.grab-dx;
            AppHost.dock-y = ta.mouse-y - ta.grab-dy;
            AppHost.dock-set = true;
        }
    }
}

// Full-screen mini-app page: one live wasm plugin rendered as a
// committed-frame image, with minimize/close controls top-right.
export component MiniAppOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #101218;
    clip: true;

    // Plugin canvas: the plugin draws RGBA8 into its own linear memory and
    // commits via `x_frame_commit`; this image shows the last committed frame.
    Image {
        width: 100%;
        height: 100%;
        source: AppHost.frame;
        image-fit: contain;
    }

    // Frame pump: pull the latest committed frame into the global while this
    // overlay is alive. Stopped automatically when it is closed/minimized
    // (component destroyed, or `running`/`failed` flip).
    Timer {
        interval: 16ms;
        running: AppHost.running && !AppHost.failed;
        triggered => {
            AppState.pump-mini-app();
        }
    }

    // P0: press/release go to the sandbox input queue as EV_TOUCH_* (1/3).
    // P1 drag: `moved` (Slint only fires it while the mouse is also pressed,
    // the same pattern as its own ScrollView) streams EV_TOUCH_MOVE (2),
    // which the pdfview viewer turns into drag-to-scroll. Wheel / trackpad
    // two-finger scrolling arrives via `scroll-event` → EV_SCROLL. Declared
    // before the buttons so the buttons get the clicks above it.
    ta := TouchArea {
        width: 100%;
        height: 100%;
        changed pressed => {
            if AppHost.running {
                AppHost.touch(ta.pressed ? 1 : 3, ta.mouse-x / 1px, ta.mouse-y / 1px);
            }
        }
        moved => {
            if ta.pressed && AppHost.running {
                AppHost.touch(2, ta.mouse-x / 1px, ta.mouse-y / 1px);
            }
        }
        scroll-event(event) => {
            if event.delta-y != 0 {
                AppHost.scroll(event.delta-y / 1px);
                return accept;
            }
            reject
        }
    }

    // View-mode toggle (top-centre, fixed position): one 34×34 round pill that
    // switches the plugin between fit-width (mode 1) and fit-height (mode 2).
    // Both modes share the same spot — the icon swaps with the active mode
    // and tapping flips the state, so the position never moves. Same pill
    // style as minimize/close. Declared after the full-canvas TouchArea so
    // its clicks take priority over the page-flip taps.
    Rectangle {
        x: (parent.width - 34px) / 2;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        // Dark translucent pill + light icon: readable over a *white* PDF as
        // well as a dark canvas.
        background: rgba(16, 18, 24, 0.6);

        // Icon mirrors the plugin's active mode; the plugin reports the mode
        // back (x_view_state → AppHost.mode) after each switch. The two
        // variants stack in the same slot — exactly one is visible at a time.
        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: AppHost.mode == 2 ? Glyph.fit-height : Glyph.fit-width;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { AppHost.set-mode(AppHost.mode == 1 ? 2 : 1); }
        }
    }

    // Page counter "n/m": on the same top row, to the right of the mode
    // toggle and to the left of the minimize/close cluster, vertically
    // centred on the pill row. Hidden until the plugin reports a document.
    Text {
        x: (parent.width + 34px) / 2 + 12px;
        y: 10px;
        width: 64px;
        height: 34px;
        vertical-alignment: center;
        text: AppHost.page > 0
            ? "{AppHost.page}/{AppHost.page-count}" : "";
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
    }

    // Minimize (top-right, left of close): hide the overlay, keep the instance.
    Rectangle {
        x: parent.width - 92px;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        // Dark translucent pill + light icon: readable over a *white* PDF as
        // well as a dark canvas (a white-on-white pill used to vanish).
        background: rgba(16, 18, 24, 0.6);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: Glyph.minimize;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { AppHost.minimize(); }
        }
    }

    // Close (top-right corner): destroy the instance + hide the overlay.
    Rectangle {
        x: parent.width - 48px;
        y: 10px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.45);
        background: rgba(16, 18, 24, 0.6);

        Icon {
            x: 8px;
            y: 8px;
            size: 18px;
            glyph: Glyph.close;
            tint: #ffffff;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { AppHost.close(); }
        }
    }
}
