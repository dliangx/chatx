import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../components/app_state.slint";

export component Header inherits VerticalLayout {
    in property <string> name;
    width: 100%;

    Rectangle {
        width: 100%;
        height: 48px;
        if AppState.is-mobile:
            Icon {
            x: 8px;
            y: (parent.height - self.size) / 2;
            size: 22px;
            glyph: Glyph.left;
            tint: Theme.fg;
            TouchArea {
                width: 48px;
                height: 48px;
                clicked => { AppState.pop-sub(); }
            }
        }

        Text {
            x: 60px;
            y: 0px;
            width: parent.width - 120px;
            height: 48px;
            text: root.name;
            font-size: 16px;
            font-weight: 600;
            color: Theme.fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 48px;
            width: 48px;
            height: 48px;
            @children
        }
    }

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.border;
    }
}
