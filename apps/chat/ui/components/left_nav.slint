// 左侧导航栏：4 个 Tab（聊天 / 联系人 / 发现 / 我的），图标取自 icon/*.svg。
// 选中项高亮，点击通过 tab-clicked(int) 向外抛出目标索引。
// 图标从上到下纵向排列，无文字，各 Tab 不强制均分高度。

component NavTab inherits Rectangle {
    in property <int> index;
    in property <int> active-tab;
    in property <image> icon-source;     // 未选中：原色
    in property <image> active-icon;    // 选中：主色
    callback clicked(int);

    height: 52px;
    background: transparent;

    // 选中背景：整格浅蓝，增强选中态
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: root.index == root.active-tab ? #eef3ff : #00000000;
        visible: root.index == root.active-tab;
    }

    // 左侧主色指示条：选中时出现
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: 100%;
        background: #2f6bff;
        visible: root.index == root.active-tab;
    }

    // 图标：水平居中，竖直居中
    Image {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        source: root.index == root.active-tab ? root.active-icon : root.icon-source;
        image-fit: contain;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.index); }
    }
}

export component LeftNavBar inherits Rectangle {
    in property <int> active-tab;
    callback tab-clicked(int);

    width: 58px;
    height: 100%;
    background: #ffffff;

    // 右侧分隔线（左侧栏位于屏幕左缘，分隔线在其右）
    Rectangle {
        x: 57px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: #ececec;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 0px;
        padding-right: 0px;

        NavTab {
            width: 100%;
            height: 52px;
            index: 0;
            icon-source: @image-url("../../icon/chat.svg");
            active-icon: @image-url("../../icon/active/chat.svg");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
        NavTab {
            width: 100%;
            height: 52px;
            index: 1;
            icon-source: @image-url("../../icon/contact.svg");
            active-icon: @image-url("../../icon/active/contact.svg");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
        NavTab {
            width: 100%;
            height: 52px;
            index: 2;
            icon-source: @image-url("../../icon/app.svg");
            active-icon: @image-url("../../icon/active/app.svg");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
        NavTab {
            width: 100%;
            height: 52px;
            index: 3;
            icon-source: @image-url("../../icon/me.svg");
            active-icon: @image-url("../../icon/active/me.svg");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
    }
}
