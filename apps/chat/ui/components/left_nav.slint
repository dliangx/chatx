import { Icon, Glyph, Variant } from "./icon.slint";
import { Theme } from "../theme.slint";

component NavTab inherits Rectangle {
    in property <int> index;
    in property <int> active-tab;
    in property <Glyph> glyph;
    callback clicked(int);

    height: 52px;
    background: transparent;

    // 未选中：Raw 原始；选中：Filled 实心
    Icon {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        size: 24px;
        glyph: root.glyph;
        variant: root.index == root.active-tab ? Variant.filled : Variant.raw;
        tint: root.index == root.active-tab ? Theme.brand : Theme.fg-muted;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.index); }
    }
}

export component LeftNavBar inherits Rectangle {
    in property <int> active-tab;
    callback tab-clicked(int);

    width: 58px;
    height: 100%;
    background: #ffffff;

    // 右侧分隔线（左侧栏位于屏幕左缘，分隔线在其右）
    Rectangle {
        x: 57px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: #ececec;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 0px;
        padding-right: 0px;

        NavTab {
            width: 100%;
            height: 52px;
            index: 0;
            glyph: Glyph.chat;
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 100%;
            height: 52px;
            index: 1;
            glyph: Glyph.contact;
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 100%;
            height: 52px;
            index: 2;
            glyph: Glyph.app;
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 100%;
            height: 52px;
            index: 3;
            glyph: Glyph.me;
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
    }
}
