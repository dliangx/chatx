
export enum PageType {
    Chat,
    Contact,
    Discover,
    Me,
}

// User-chosen appearance preference. The inline wheel in Settings maps index
// 0/1/2 to these variants in this order; the Rust handler persists them as
// "light" / "dark" / "system" and resolves `system` against the live OS
// signal on every UI tick.
export enum ThemeMode {
    Light,
    Dark,
    System,
}

export enum SubPageType {
    ChatRoom,
    ChatSetting,
    AddGroup,
    GroupProfile,
    ContactProfile,
    AddContact,
    AddMoment,
    AddNote,
    DiscoverDetail,
    PomegranateSeed,
    Settings,
    MyNote,
    MyDevices,
    EditProfile,
}

export enum GlobalOverlayType {
    None,
    ImageViewer,
    QrScanner,
    Camera,
    AudioCall,
    VideoCall,
    ScreenShare,
    QrCode,
    AddMenu,
    Error,
}

export struct SubPageEntry {
    page: SubPageType,
    payload: int,
}

export struct TabState {
    sub-history: [SubPageEntry],
    sub-top: int,
}

export struct NavigationState {
    active-tab: int,
    tabs: [TabState],
    global-overlay: GlobalOverlayType,
}

export struct ConversationRow {
    chat-id: int,
    title: string,
    preview: string,
    is-group: bool,
    time-label: string,
    image: image,
    is-pinned: bool,
}

export struct ContactRow {
    id: int,
    image: image,
    peer_id: string,
    name: string,
}

export struct LetterEntry {
    letter: string,
    target: int,
}

export struct DiscoverCard {
    id: int,
    title: string,
    user: string,
    likes: int,
    liked: bool,
    recommends: int,
    recommended: bool,
    image: image,
}

export struct NoteRow {
    id: int,
    content: string,
    created-label: string,
}

export struct SearchUser {
    name: string,
    username: string,
    peer_id: string,
    image: image,
}

export struct FriendRequestRow {
    key: int,
    peer_id: string,
    name: string,
    time-label: string,
}

export struct MyDevice {
    peer_id: string,
    label: string,
    online: bool,
    approved: bool,
    self_device: bool,
}


export struct GroupMemberRow {
    name: string,
    image: image,
    is-self: bool,
    // The libp2p base58 peer id behind this member. Used for identity (e.g.
    // "is-self"), matching contacts (avatars), and dedup in the inline
    // add-candidate list.
    peer: string,
}

export global AppState {
    in-out property <NavigationState> nav-state: { active-tab:0, tabs: [], global-overlay: GlobalOverlayType.None };
    callback push-sub(SubPageType, int);
    callback pop-sub();
    callback clear();
    callback login(string, string);
    callback register(string, string);
    callback logout();
    /// Wipes the currently-bound user's local data before switching to sign-up.
    callback clear-user-data();
    /// Fired whenever the active tab changes. Backends use this (and the
    /// new index) to trigger tab-specific work without a separate UI hook
    /// (e.g. the moment sync loop kicks off when the user enters Discover).
    callback tab-changed(int);
    in-out property <bool> auth-busy: false;
    in-out property <string> auth-message: "";
    in-out property <bool> auth-register: false;
    in-out property <bool> auth-uid-locked: false;
    in-out property <bool> is-mobile: true;
    in-out property <bool> search-active: false;
    /// Current text in the active tab's search bar (all three boxes bind to
    /// this single shared box; the handler dispatches by active tab).
    in-out property <string> search-q: "";
    /// Fired from the shared SearchBar on every keystroke (incl. clears);
    /// an empty string restores each tab's full list.
    callback local-search(string);
    in-out property <string> user-id: "";
    in-out property <string> nickname: "";
    in-out property <string> peer-id: "";
    /// Own-user profile fields (displayed in the Me tab ProfileItem).
    in property <string> own-bio: "";
    in property <string> own-research: "";
    in property <image> own-avatar;

    in-out property <string> add-status: "";
    in-out property <[SearchUser]> search-results: [];
    in-out property <[int]> group-picked: [];
    callback search-users(string);
    callback add-contact(string, string);

    // Incoming friend requests awaiting a decision (shown at the top of Contacts).
    in-out property <[FriendRequestRow]> friend-requests: [];
    callback accept-friend-request(int);
    callback reject-friend-request(int);
    callback select-language(string);
    callback select-theme(ThemeMode);
    in property <image> qr-image;
    in property <string> qr-target-id: "";
    callback open-image-viewer();
    callback close-image-viewer();
    in-out property <string> lang: "en";
    in property <string> font;
    in property <int> font-size: 16;
    in property <string> theme: "light";

    // Device approval
    in property <bool> device-approved: true;
    in property <[MyDevice]> my-devices: [];
    callback refresh-devices();
    callback approve-device(string);
    callback revoke-device(string);

    // Top notification banner (server-publishable). Empty string hides the banner.
    in property <string> notice-text: "";

    in property <[ConversationRow]> chats: [];
    in property <[ContactRow]> contacts: [];
    in property <[LetterEntry]> contact-letters: [];
    in property <[DiscoverCard]> discover: [];
    // How many discover rows are currently published to the view (pagination).
    // Starts at the initial page; the discover view bumps this in batches of 2
    // as the user scrolls toward the bottom, until all rows are shown.
    in-out property <int> discover-shown: 8;
    in-out property <bool> discover-has-more: false;
    callback discover-load-more();
    in property <[NoteRow]> my_notes: [];
    in property <string> data-status: "";
    in property <string> group-status: "";
    in-out property <string> error-message: "";
    in-out property <bool> error-is-success: false;
    in property <int> add-menu-type:0;
    in-out property <length> xp: 0px;

    callback toggle-like(int);
    callback toggle-recommend(int);
    callback delete-note(int);
    callback copy-note(string);
    callback delete-contact(int);
    callback delete-chat(int);
    callback show-qr-code(string);
    callback close-qr-code();
    callback start-screen-share();
    callback stop-screen-share();
    callback start-meeting();
    // Contact-list key of the peer behind the currently open 1:1 chat; used
    // by the chat add-menu (type 1) so the audio / video call and screen-share entries can reuse the
    // ProfileState call callbacks. -1 when the peer is not a known contact.
    in-out property <int> current-chat-peer-key: -1;
    // Forward flow: chat bubble long-press "forward" arms the picker; the
    // contacts tab shows a "forward to" banner until forwarded or cancelled.
    in-out property <string> forward-target: "";
    callback forward-text(string, int);
    callback cancel-forward();
    // Chat bubble long-press "favorite" → save the text into the user's notes.
    callback save-note(string);
    callback pick-group-member(int);
    callback unpick-group-member(int);
    callback create-group();

    // ── Chat settings (group chat) ─────────────────────────────────────────
    in-out property <int> current-chat-key: -1;
    in-out property <bool> current-chat-is-group: false;
    in property <[GroupMemberRow]> existing-members: [];
    in property <[string]> existing-member-peers: [];
    callback add-group-member();

    // QR scanner (camera overlay)
    in property <bool> scan-found: false;
    in property <string> scan-status: "";
    in property <image> scan-preview;
    callback scanner-start();
    callback scanner-stop();
}
