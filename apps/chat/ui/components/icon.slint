import { Theme } from "../theme.slint";

export enum Glyph {
    none,
    add,
    add-circle,
    app,
    call,
    chat,
    close,
    close-circle,
    collection,
    configuration,
    contact,
    copy,
    device,
    delete,
    edit,
    file,
    fill,
    fit-height,
    fit-width,
    finish,
    forward,
    fullscreen,
    friends-add,
    good,
    heart,
    left,
    me,
    meeting,
    minimize,
    notes,
    picture,
    photo,
    qrcode,
    right,
    record,
    scan,
    search,
    selected,
    setting,
    share,
    siri,
    under,
    up,
    video,
    voice,
    voice-close,
    volume,
    volume-close,
}

export enum Variant {
    raw,
    stroked,
    filled,
}

export component Outline inherits Path {
    in property <length> size: 24px;
    in property <brush> tint: Theme.fg;
    in property <Variant> variant: Variant.raw;
    in property <float> weight: 56;
    width: root.size;
    height: root.size;
    viewbox-width: 1024;
    viewbox-height: 1024;
    fill: root.variant == Variant.stroked ? Colors.transparent : root.tint;
    stroke: root.variant == Variant.stroked ? root.tint : Colors.transparent;
    stroke-width: root.size * root.weight / 1024;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component Filled inherits Path {
    in property <length> size: 24px;
    in property <brush> tint: Theme.fg;
    width: root.size;
    height: root.size;
    viewbox-width: 1024;
    viewbox-height: 1024;
    fill: root.tint;
}

