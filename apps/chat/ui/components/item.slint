import { Icon, Glyph, Variant } from "./icon.slint";
import { Theme } from "../theme.slint";
import { AppState } from "./app_state.slint";

export component ProfileItem inherits Rectangle {
    in property <image> image;
    in property <string> name;
    in property <string> nickname;
    in property <string> peer-id;
    callback show-qr(string);
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100px;
        padding: 16px;
        spacing: 12px;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 4px;
            background: #e4e4e4;

            Image {
                width: 40px;
                height: 40px;
                source: root.image;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Text {
                width: 100%;
                text: root.name;
                font-size: 18px;
                font-weight: 800;
                color: Theme.fg;
                overflow: elide;
            }

            Text {
                width: 100%;
                text: root.nickname;
                font-size: 14px;
                color: Theme.fg-muted;
                overflow: elide;
            }

            HorizontalLayout {
                width: 100%;
                spacing: 4px;

                Text {
                    horizontal-stretch: 1;
                    text: root.peer-id;
                    font-size: 12px;
                    color: Theme.fg-muted;
                    overflow: elide;
                }

                Icon {
                    size: 16px;
                    glyph: Glyph.qrcode;
                    tint: Theme.fg-muted;
                    TouchArea {
                        width: 24px;
                        height: 24px;
                        clicked => { root.show-qr(root.peer-id); }
                    }
                }
            }
        }
    }
}

export component ChatListItem inherits Rectangle {
    in property <int> id;
    in property <image> image;
    in property <string> title;
    in property <string> time;
    in property <string> content;
    in property <bool> selected: false;
    callback clicked(int);

    out property <length> swipe: 0px;
    animate swipe {
        duration: 180ms;
        easing: ease-in-out;
    }

    out property <bool> revealed: root.swipe >= 80px;
    in-out property <bool> moved: false;
    in-out property <bool> hit-btn: false;

    background: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand : Theme.bg;
    clip: true;

    HorizontalLayout {
        x: -root.swipe;
        width: 100%;
        height: 100%;
        padding: 4px;
        padding-left: 8px;
        padding-right: 12px;
        spacing: 10px;

        Rectangle {
            width: parent.height - 8px;
            height: parent.height - 8px;
            border-radius: 8px;
            background: #e4e4e4;

            Image {
                source: root.image;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            Text {
                width: 100%;
                height: 24px;
                text: root.title;
                font-size: 14px;
                font-weight: 800;
                color: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg;
                overflow: elide;
                vertical-alignment: bottom;
            }

            Text {
                width: 100%;
                height: 24px;
                text: root.content;
                font-size: 12px;
                color: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg-muted;
                overflow: elide;
                vertical-alignment: top;
            }
        }

        Text {
            width: 80px;
            text: root.time;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg-muted;
        }
    }

    Rectangle {
        x: parent.width - 80px;
        y: 0px;
        width: 80px;
        height: 100%;
        background: #e03131;
        opacity: root.swipe / 80px;

        Text {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            text: "删除";
            font-size: 14px;
            font-weight: 800;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 56px;
        y: root.height;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved = false;
                root.hit-btn = root.revealed && ta.mouse-x >= parent.width - 80px;
            } else if (e.kind == PointerEventKind.move) {
                if (!root.revealed) {
                    if (ta.pressed-x - ta.mouse-x > 5px) {
                        root.moved = true;
                    }
                    if (ta.pressed-x - ta.mouse-x < 0px) {
                        root.swipe = 0px;
                    } else if (ta.pressed-x - ta.mouse-x > 80px) {
                        root.swipe = 80px;
                    } else {
                        root.swipe = ta.pressed-x - ta.mouse-x;
                    }
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.revealed) {
                    if (root.hit-btn) {
                        AppState.delete-chat(root.id);
                    } else {
                        root.swipe = 0px;
                    }
                } else if (root.moved) {
                    if (root.swipe > 40px) {
                        root.swipe = 80px;
                    } else {
                        root.swipe = 0px;
                    }
                } else {
                    root.clicked(root.id);
                }
            }
        }
    }
}

export component ContactListItem inherits Rectangle {
    in property <int> id;
    in property <image> image;
    in property <string> peer_id;
    in property <string> title;
    in property <bool> selected: false;
    callback clicked();

    out property <length> swipe: 0px;
    animate swipe {
        duration: 180ms;
        easing: ease-in-out;
    }

    out property <bool> revealed: root.swipe >= 80px;
    in-out property <bool> moved: false;
    in-out property <bool> hit-btn: false;

    background: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand : Theme.bg;
    clip: true;

    HorizontalLayout {
        x: -root.swipe;
        width: 100%;
        height: 100%;
        padding: 4px;
        padding-left: 8px;
        spacing: 10px;

        Rectangle {
            width: parent.height - 8px;
            height: parent.height - 8px;
            border-radius: 8px;
            background: #e4e4e4;

            Image {
                source: root.image;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: 14px;
            font-weight: 800;
            color: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: parent.width - 80px;
        y: 0px;
        width: 80px;
        height: 100%;
        background: #e03131;
        opacity: root.swipe / 80px;

        Text {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            text: "删除";
            font-size: 14px;
            font-weight: 800;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved = false;
                root.hit-btn = root.revealed && ta.mouse-x >= parent.width - 80px;
            } else if (e.kind == PointerEventKind.move) {
                if (!root.revealed) {
                    if (ta.pressed-x - ta.mouse-x > 5px) {
                        root.moved = true;
                    }
                    if (ta.pressed-x - ta.mouse-x < 0px) {
                        root.swipe = 0px;
                    } else if (ta.pressed-x - ta.mouse-x > 80px) {
                        root.swipe = 80px;
                    } else {
                        root.swipe = ta.pressed-x - ta.mouse-x;
                    }
                }
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                if (root.revealed) {
                    if (root.hit-btn) {
                        AppState.delete-contact(root.id);
                    } else {
                        root.swipe = 0px;
                    }
                } else if (root.moved) {
                    if (root.swipe > 40px) {
                        root.swipe = 80px;
                    } else {
                        root.swipe = 0px;
                    }
                } else {
                    root.clicked();
                }
            }
        }
    }
}

export component SettingItem inherits Rectangle {
    in property <int> id;
    in property <Glyph> icon;
    in property <string> title;
    in property <bool> selected: false;
    in property <bool> show-left: true;
    callback clicked(int);
    height: 48px;
    background: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand : transparent;

    Icon {
        x: 8px;
        y: (parent.height - self.size) / 2;
        size: 24px;
        glyph: root.icon;
        variant: Variant.raw;
        tint: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg;
    }

    Text {
        x: 40px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        vertical-alignment: center;
        text: root.title;
        font-size: 14px;
        color: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg;
    }

    if AppState.is-mobile && show-left:
    Icon {
        x: parent.width - 24px;
        y: (parent.height - self.size) / 2;
        size: 20px;
        glyph: Glyph.right;
        variant: Variant.raw;
        tint: (!AppState.is-mobile && (ta.pressed || root.selected)) ? Theme.brand-soft : Theme.fg;
    }

    Rectangle {
        x: 40px;
        y: 48px;
        width: 100%;
        height: 1px;
        background: #ececec;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.id); }
    }
}

export component PlantItem inherits Rectangle {
    in property <string> key;
    in property <string> value;
    height: 48px;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width / 4;
        height: parent.height;
        text: root.key;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }

    Text {
        x: parent.width / 4;
        y: 0px;
        width: parent.width * 3 / 4;
        height: parent.height;
        text: root.value;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }
}
