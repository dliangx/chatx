import { Icon, Glyph, Variant } from "./icon.slint";
import { Theme } from "../theme.slint";

export component ChatListItem inherits Rectangle {
    in property <int> id;
    in property <image> image;
    in property <string> title;
    in property <string> time;
    in property <string> content;
    callback clicked(int);

    background: transparent;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        Image {
            width: 40px;
            height: 40px;
            source: root.image;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;

            Text {
                width: 100%;
                height: 24px;
                text: root.title;
                font-size: 14px;
                font-weight: 800;
                color: Theme.fg;
                overflow: elide;
                vertical-alignment: bottom;
            }

            Text {
                width: 100%;
                height: 24px;
                text: root.content;
                font-size: 12px;
                color: Theme.fg-muted;
                overflow: elide;
                vertical-alignment: top;
            }
        }

        Text {
            width: 80px;
            text: root.time;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Theme.fg-muted;
        }
    }

    Rectangle {
        x: 56px;
        y: root.height;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.id); }
    }
}

export component ContactListItem inherits Rectangle {
    in property <int> id;
    in property <image> image;
    in property <string> peer_id;
    in property <string> title;
    callback clicked();

    background: transparent;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        Image {
            width: 40px;
            height: 40px;
            source: root.image;
        }

        Text {
            horizontal-stretch: 1;
            text: root.title;
            font-size: 14px;
            font-weight: 800;
            color: Theme.fg;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component SettingItem inherits Rectangle {
    in property <int> id;
    in property <Glyph> icon;
    in property <string> title;
    callback clicked(int);
    height: 48px;

    Icon {
        x: 0px;
        y: (parent.height - self.size) / 2;
        size: 24px;
        glyph: root.icon;
        variant: Variant.raw;
        tint: Theme.fg;
    }

    Text {
        x: 32px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        vertical-alignment: center;
        text: root.title;
        font-size: 14px;
        color: Theme.fg;
    }

    Icon {
        x: parent.width - 24px;
        y: (parent.height - self.size) / 2;
        size: 20px;
        glyph: Glyph.right;
        variant: Variant.raw;
        tint: Theme.fg;
    }

    Rectangle {
        x: 32px;
        y: 48px;
        width: 100%;
        height: 1px;
        background: #ececec;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.id); }
    }
}

export component PlantItem inherits Rectangle {
    in property <string> key;
    in property <string> value;
    height: 48px;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width / 4;
        height: parent.height;
        text: root.key;
        font-size: 14px;
        color: Theme.fg;
    }

    Text {
        x: parent.width / 4;
        y: 0px;
        width: parent.width * 3 / 4;
        height: parent.height;
        text: root.value;
        font-size: 14px;
        color: Theme.fg;
    }
}
