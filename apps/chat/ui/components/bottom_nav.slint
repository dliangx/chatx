component NavTab inherits Rectangle {
    in property <int> index;
    in property <int> active-tab;
    in property <image> icon-source;
    in property <image> active-icon;
    in property <string> label;
    callback clicked(int);

    background: transparent;

    Image {
        x: (parent.width - 24px) / 2;
        y: 6px;
        width: 24px;
        height: 24px;
        source: root.index == root.active-tab ? root.active-icon : root.icon-source;
        image-fit: contain;
    }

    Text {
        x: 0;
        y: 34px;
        width: 100%;
        height: 14px;
        text: root.label;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.index == root.active-tab ? #2f6bff : #9aa0b4;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.index); }
    }
}

export component BottomNavBar inherits Rectangle {
    in property <int> active-tab;
    callback tab-clicked(int);

    width: 100%;
    height: 58px;
    background: #ffffff;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: #ececec;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        alignment: center;

        NavTab {
            width: 25%;
            height: 100%;
            index: 0;
            icon-source: @image-url("../../icon/chat.svg");
            active-icon: @image-url("../../icon/active/chat.svg");
            label: "聊天";
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 1;
            icon-source: @image-url("../../icon/contact.svg");
            active-icon: @image-url("../../icon/active/contact.svg");
            label: "联系人";
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 2;
            icon-source: @image-url("../../icon/app.svg");
            active-icon: @image-url("../../icon/active/app.svg");
            label: "发现";
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 3;
            icon-source: @image-url("../../icon/me.svg");
            active-icon: @image-url("../../icon/active/me.svg");
            label: "我的";
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
    }
}
