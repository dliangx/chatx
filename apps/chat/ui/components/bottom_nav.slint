import { Icon, Glyph, Variant } from "./icon.slint";
import { Theme } from "../theme.slint";

component NavTab inherits Rectangle {
    in property <int> index;
    in property <int> active-tab;
    in property <Glyph> glyph;
    in property <string> label;
    callback clicked(int);

    background: transparent;

    // Top padding for the icon+caption block. The same-colour home-indicator /
    // nav-bar band (painted by main.slint) sits directly below the bar, so the
    // block is anchored with a generous top margin rather than centred in the
    // thin content band — otherwise the icon+caption read as "hugging the
    // top" with the empty shelf hanging below. Kept small enough that the
    // 40px icon+caption still clears the 49px iOS content band (no clip).
    out property <length> top-pad: 8px;
    Icon {
        x: (parent.width - 24px) / 2;
        y: root.top-pad;
        size: 24px;
        glyph: root.glyph;
        variant: root.index == root.active-tab ? Variant.filled : Variant.raw;
        tint: root.index == root.active-tab ? Theme.brand : Theme.fg-muted;
    }

    Text {
        x: 0;
        y: root.top-pad + 27px;
        width: 100%;
        height: 14px;
        text: root.label;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.index == root.active-tab ? Theme.brand : Theme.fg-muted;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.index); }
    }
}

export component BottomNavBar inherits Rectangle {
    in property <int> active-tab;
    /// Standard content band height (icon + caption) for this platform. Caller
    /// sets this from `AppState.bottom-nav` — 49pt on iOS, 56dp on Android. The
    /// same-colour strip in the home-indicator / nav-bar inset zone (see
    /// main.slint) sits directly below this so the combined shelf reads as one
    /// native full-height bar reaching the physical screen edge.
    in property <length> content-height: 56px;
    callback tab-clicked(int);

    width: 100%;
    height: root.content-height;
    background: Theme.surface;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.content-height;
        spacing: 0px;
        alignment: center;

        NavTab {
            width: 25%;
            height: 100%;
            index: 0;
            glyph: Glyph.chat;
            label: @tr("Chats");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 1;
            glyph: Glyph.contact;
            label: @tr("Contacts");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 2;
            glyph: Glyph.app;
            label: @tr("Discover");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 3;
            glyph: Glyph.me;
            label: @tr("Me");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
    }
}
