import { Icon, Glyph, Variant } from "./icon.slint";
import { Theme } from "../theme.slint";

component NavTab inherits Rectangle {
    in property <int> index;
    in property <int> active-tab;
    in property <Glyph> glyph;
    in property <string> label;
    callback clicked(int);

    background: transparent;

    Icon {
        x: (parent.width - 24px) / 2;
        y: 6px;
        size: 24px;
        glyph: root.glyph;
        variant: root.index == root.active-tab ? Variant.filled : Variant.raw;
        tint: root.index == root.active-tab ? Theme.brand : Theme.fg-muted;
    }

    Text {
        x: 0;
        y: 34px;
        width: 100%;
        height: 14px;
        text: root.label;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.index == root.active-tab ? Theme.brand : Theme.fg-muted;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(root.index); }
    }
}

export component BottomNavBar inherits Rectangle {
    in property <int> active-tab;
    callback tab-clicked(int);

    width: 100%;
    height: 58px;
    background: Theme.surface;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        alignment: center;

        NavTab {
            width: 25%;
            height: 100%;
            index: 0;
            glyph: Glyph.chat;
            label: @tr("Chats");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 1;
            glyph: Glyph.contact;
            label: @tr("Contacts");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 2;
            glyph: Glyph.app;
            label: @tr("Discover");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }

        NavTab {
            width: 25%;
            height: 100%;
            index: 3;
            glyph: Glyph.me;
            label: @tr("Me");
            active-tab: root.active-tab;
            clicked(idx) => { root.tab-clicked(idx); }
        }
    }
}
