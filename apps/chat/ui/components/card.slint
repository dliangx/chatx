import { Icon, Glyph } from "./icon.slint";
import { Theme } from "../theme.slint";

export component CardView inherits Rectangle {
    in property <int> id;
    in property <image> image;
    in property <string> title;
    in property <string> user;
    in property <bool> is-liked;
    in property <int> likes;
    callback clicked(int);
    callback like-toggled();

    out property <length> cover-h: root.width * 4 / 3;
    out property <length> content-h: root.cover-h + 60px;

    height: root.content-h;

    clip: true;

    VerticalLayout {
        spacing: 8px;
        Rectangle {

            width: root.width;
            height: root.cover-h;
            border-radius: 8px;
            background: #f2f2f5;
            Image {
                width: root.width;
                height: root.cover-h;
                source: root.image;
                image-fit: cover;
            }

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.clicked(root.id); }
            }
        }

        Text {

            width: root.width;
            height: 28px;
            text: root.title;
            font-size: 14px;
            font-weight: 500;
            color: Theme.fg;
            wrap: word-wrap;
            overflow: clip;
        }

        Rectangle {
            width: root.width;
            height: 16px;

            Rectangle {
                x: 0px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #a0aec0;
            }

            Text {
                x: 20px;
                width: root.width - 40px;
                height: 16px;
                text: root.user;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                color: Theme.fg-muted;
            }

            Text {
                x: root.width - 60px;
                width: 40px;
                height: 16px;
                text: root.likes;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: root.is-liked ? #ff2442 : Theme.fg-muted;
            }

            Icon {
                x: root.width - 18px;
                y: (parent.height - 18px) / 2;
                size: 18px;
                glyph: Glyph.heart;
                tint: root.is-liked ? #ff2442 : #d9d9de;
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.like-toggled(); }
                }
            }
        }
    }
}
