import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { GlobalOverlayType, AppState } from "./app_state.slint";

export component SearchBar inherits HorizontalLayout {
    height: 48px;
    padding: 8px;
    spacing: 4px;

    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-radius: 8px;
        background: Theme.surface-2;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: AppState.search-active ? Theme.brand : Theme.surface-2;

                Icon {
                    x: (parent.width - self.size) / 2;
                    y: (parent.height - self.size) / 2;
                    size: 18px;
                    glyph: Glyph.search;
                    tint: AppState.search-active ? white : Theme.fg;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        if (AppState.search-q != "") {
                            // Non-empty: the icon acts as a clear button.
                            AppState.search-q = "";
                            AppState.local-search("");
                            AppState.search-active = false;
                        } else {
                            AppState.search-active = !AppState.search-active;
                            input.focus();
                        }
                    }
                }
            }

            input := TextInput {
                horizontal-stretch: 1;
                height: 100%;
                color: Theme.fg;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.brand;
                selection-foreground-color: white;
                text <=> AppState.search-q;
                // Live search: every keystroke refreshes the active tab's
                // results on the Rust side. (`edited` fires for user typing;
                // programmatic clears go through `local-search` directly.)
                edited => {
                    let t = self.text;
                    AppState.search-active = t != "";
                    AppState.local-search(t);
                }
            }
        }
    }

    Rectangle {
        width: 32px;
        height: 32px;

        Icon {
            x: (parent.width - self.size) / 2;
            y: (parent.height - self.size) / 2;
            size: 18px;
            glyph: Glyph.add;
            tint: Theme.fg;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                AppState.add-menu-type = 0;
                AppState.nav-state.global-overlay = AppState.nav-state.global-overlay == GlobalOverlayType.AddMenu
                    ? GlobalOverlayType.None
                    : GlobalOverlayType.AddMenu;
            }
        }
    }
}
