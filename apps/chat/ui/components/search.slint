import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { AppState } from "./app_state.slint";

export component SearchBar inherits HorizontalLayout {
    height: 48px;
    padding: 8px;
    spacing: 4px;

    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-radius: 8px;
        background: #e8e8e8;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: AppState.search-active ? Theme.brand : #e8e8e8;

                Icon {
                    x: (parent.width - self.size) / 2;
                    y: (parent.height - self.size) / 2;
                    size: 18px;
                    glyph: Glyph.siri;
                    tint: AppState.search-active ? white : Theme.fg;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { AppState.search-active = !AppState.search-active; }
                }
            }

            input := TextInput {
                horizontal-stretch: 1;
                height: 100%;
                color: Theme.fg;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.brand;
                selection-foreground-color: white;
                accepted => {}
            }
        }
    }

    Rectangle {
        width: 32px;
        height: 32px;

        Icon {
            x: (parent.width - self.size) / 2;
            y: (parent.height - self.size) / 2;
            size: 18px;
            glyph: Glyph.add;
            tint: Theme.fg;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {}
        }
    }
}
