import { Icon, Glyph } from "../components/icon.slint";
import { Theme } from "../theme.slint";
import { AppState } from "./app_state.slint";
import { SubPageType } from "./nav_state.slint";

export component SearchBar inherits HorizontalLayout {
    height: 48px;
    padding: 8px;
    spacing: 4px;

    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-radius: 8px;
        background: #e8e8e8;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: AppState.search-active ? Theme.brand : #e8e8e8;

                Icon {
                    x: (parent.width - self.size) / 2;
                    y: (parent.height - self.size) / 2;
                    size: 18px;
                    glyph: Glyph.siri;
                    tint: AppState.search-active ? white : Theme.fg;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { AppState.search-active = !AppState.search-active; }
                }
            }

            input := TextInput {
                horizontal-stretch: 1;
                height: 100%;
                color: Theme.fg;
                font-size: 15px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.brand;
                selection-foreground-color: white;
                accepted => {}
            }
        }
    }

    Rectangle {
        width: 32px;
        height: 32px;

        Icon {
            x: (parent.width - self.size) / 2;
            y: (parent.height - self.size) / 2;
            size: 18px;
            glyph: Glyph.add;
            tint: Theme.fg;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { AppState.menu-open = !AppState.menu-open; }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <Glyph> icon;
    in property <string> label;
    callback clicked();
    height: 44px;

    Icon {
        x: 12px;
        y: (parent.height - self.size) / 2;
        size: 18px;
        glyph: root.icon;
        tint: Theme.fg;
    }

    Text {
        x: 40px;
        width: parent.width - 52px;
        height: 100%;
        text: root.label;
        font-size: 14px;
        color: Theme.fg;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component AddMenu inherits Rectangle {
    visible: AppState.menu-open;
    width: 176px;
    height: 5 * 44px + 8px;
    border-radius: 8px;
    background: #ffffff;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000033;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 4px;
        spacing: 0px;

        MenuRow {
            icon: Glyph.scan;
            label: "扫描";
            clicked => { AppState.menu-open = false; AppState.open-scanner(); }
        }
        MenuRow {
            icon: Glyph.friends-add;
            label: "添加朋友";
            clicked => { AppState.menu-open = false; AppState.push-sub(SubPageType.AddContact, 0); }
        }
        MenuRow {
            icon: Glyph.add-circle;
            label: "新建群聊";
            clicked => { AppState.menu-open = false; AppState.push-sub(SubPageType.AddGroup, 0); }
        }
        MenuRow {
            icon: Glyph.meeting;
            label: "发起会议";
            clicked => { AppState.menu-open = false; AppState.start-meeting(); }
        }
        MenuRow {
            icon: Glyph.share;
            label: "桌面共享";
            clicked => { AppState.menu-open = false; AppState.start-screen-share(); }
        }
    }
}
