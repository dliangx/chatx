import { Theme } from "../theme.slint";
import { AppState } from "./app_state.slint";

component AuthInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback accepted();

    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 48px;

    input := TextInput {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        color: Theme.fg;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        selection-foreground-color: white;
        selection-background-color: Theme.brand;
        enabled: root.enabled;
        opacity: root.enabled ? 1 : 0.5;
        accepted => { root.accepted(); }
    }

    placeholder-label := Text {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        visible: root.text == "";
        color: Theme.fg-muted;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.placeholder;
    }
}

component BrandButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 48px;
    border-radius: 24px;
    background: root.enabled ? Theme.brand : Theme.fg-muted;

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: white;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component AuthView inherits Rectangle {
    in-out property <string> auth-error: "";

    in-out property <string> uid: "";
    in-out property <string> pass: "";

    in-out property <bool> show-confirm: false;

    width: 100%;
    height: 100%;
    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding-left: 28px;
        padding-right: 28px;

        Text {
            text: "ChatX";
            font-size: 32px;
            font-weight: 800;
            color: Theme.brand;
            width: 100%;
            horizontal-alignment: center;
        }

        Text {
            text: AppState.auth-register ? @tr("Create a new account") : @tr("Sign in");
            font-size: 16px;
            color: Theme.fg-muted;
            width: 100%;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 420px);
                placeholder: @tr("User");
                text <=> root.uid;
                enabled: AppState.auth-register || !AppState.auth-uid-locked;
                accepted => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 420px);
                placeholder: @tr("Password");
                text <=> root.pass;
                accepted => { root.submit(); }
            }
        }

        Text {
            text: root.auth-error != "" ? root.auth-error : AppState.auth-message;
            color: Theme.brand;
            font-size: 14px;
            width: 100%;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            BrandButton {
                width: min(parent.width, 420px);
                text: AppState.auth-busy ? @tr("Please wait…") : (AppState.auth-register ? @tr("Sign up") : @tr("Sign in"));
                enabled: !AppState.auth-busy;
                clicked => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(parent.width, 420px);
                height: 40px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: AppState.auth-register ? @tr("Have an account? Sign in") : @tr("No account? Sign up");
                    color: Theme.brand;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    visible: !root.show-confirm;
                    clicked => {
                        if (AppState.auth-uid-locked && !AppState.auth-register) {
                            root.show-confirm = true;
                        } else {
                            AppState.auth-register = !AppState.auth-register;
                        }
                    }
                }
            }
        }
    }

    if root.show-confirm:
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        clip: true;

        Rectangle {
            x: (parent.width - 320px) / 2;
            y: (parent.height - 200px) / 2;
            width: 320px;
            height: 200px;
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 20px;

                Text {
                    width: 100%;
                    text: @tr("Delete all data of the current account and create a new one?");
                    font-size: 15px;
                    color: Theme.fg;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 16px;

                    BrandButton {
                        width: 130px;
                        text: @tr("Cancel");
                        clicked => { root.show-confirm = false; }
                    }

                    BrandButton {
                        width: 130px;
                        text: @tr("Delete");
                        clicked => {
                            root.show-confirm = false;
                            AppState.auth-register = true;
                            AppState.auth-uid-locked = false;
                            root.uid = "";
                            root.pass = "";
                            AppState.clear-user-data();
                        }
                    }
                }
            }
        }
    }

    function submit() {
        root.auth-error = "";
        if (AppState.auth-register) {
            if (root.uid == "") {
                root.auth-error = @tr("Enter your username");
                return;
            }
            if (root.pass == "") {
                root.auth-error = @tr("Enter your password");
                return;
            }
            AppState.register(root.uid, root.pass);
            return;
        }
        if (root.uid == "") {
            root.auth-error = @tr("Enter your username");
            return;
        }
        if (root.pass == "") {
            root.auth-error = @tr("Enter your password");
            return;
        }
        AppState.login(root.uid, root.pass);
    }
}
