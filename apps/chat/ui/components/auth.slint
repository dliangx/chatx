import { FilledButton, TextButton } from "@material";

component AuthInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback accepted();

    background: #1f2433;
    border-radius: 8px;
    min-height: 56px;

    input := TextInput {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        height: parent.height - 28px;
        color: #ffffff;
        font-size: 20px;
        horizontal-alignment: center;
        single-line: true;
        text <=> root.text;
        selection-foreground-color: #14161f;
        enabled: root.enabled;
        opacity: root.enabled ? 1 : 0.5;
        accepted => { root.accepted(); }
    }

    placeholder-label := Text {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        height: parent.height - 28px;
        visible: root.text == "";
        color: #6b7280;
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.placeholder;
    }
}

export component AuthView inherits Rectangle {
    in property <string> message;
    in property <bool> busy;
    in-out property <string> auth-error: "";

    in-out property <bool> is-register: false;
    in-out property <string> uid: "";
    in-out property <string> pass: "";

    callback login(string, string);
    callback register(string, string);

    width: 100%;
    height: 100%;
    background: #14161f;

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding-left: 28px;
        padding-right: 28px;

        Text {
            text: "ChatX";
            font-size: 30px;
            font-weight: 600;
            color: #ffffff;
            width: 100%;
            horizontal-alignment: center;
        }

        Text {
            text: root.is-register ? "注册新账户" : "登录";
            font-size: 16px;
            color: #9aa0b4;
            width: 100%;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 500px);
                placeholder: "用户";
                text <=> root.uid;
                accepted => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 500px);
                placeholder: "密码";
                text <=> root.pass;
                accepted => { root.submit(); }
            }
        }

        Text {
            text: root.auth-error != "" ? root.auth-error : root.message;
            color: #ff6b6b;
            font-size: 14px;
            width: 100%;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            FilledButton {
                width: min(parent.width, 500px);
                text: root.busy ? "处理中…" : (root.is-register ? "注册" : "登录");
                enabled: !root.busy;
                clicked => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            TextButton {
                width: min(parent.width, 500px);
                text: root.is-register ? "已有账户？去登录" : "没有账户？去注册";
                clicked => { root.is-register = !root.is-register; }
            }
        }
    }

    function submit() {
        root.auth-error = "";
        if (root.is-register) {
            if (root.uid == "") {
                root.auth-error = "请输入用户名";
                return;
            }
            if (root.pass == "") {
                root.auth-error = "请输入口令";
                return;
            }
            root.register(root.uid, root.pass);
            return;
        }
        if (root.uid == "") {
            root.auth-error = "请输入用户名";
            return;
        }
        if (root.pass == "") {
            root.auth-error = "请输入口令";
            return;
        }
        root.login(root.uid, root.pass);
    }
}
