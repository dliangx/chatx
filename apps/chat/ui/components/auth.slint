import { Theme } from "../theme.slint";

component AuthInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback accepted();

    background: #ffffff;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 48px;

    input := TextInput {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        color: Theme.fg;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        single-line: true;
        text <=> root.text;
        selection-foreground-color: white;
        selection-background-color: Theme.brand;
        enabled: root.enabled;
        opacity: root.enabled ? 1 : 0.5;
        accepted => { root.accepted(); }
    }

    placeholder-label := Text {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        visible: root.text == "";
        color: Theme.fg-muted;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.placeholder;
    }
}

component BrandButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 48px;
    border-radius: 24px;
    background: root.enabled ? Theme.brand : Theme.fg-muted;

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: white;
        font-size: 16px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component AuthView inherits Rectangle {
    in property <string> message;
    in property <bool> busy;
    in-out property <string> auth-error: "";

    in-out property <bool> is-register: false;
    in-out property <string> uid: "";
    in-out property <string> pass: "";

    callback login(string, string);
    callback register(string, string);

    width: 100%;
    height: 100%;
    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding-left: 28px;
        padding-right: 28px;

        Text {
            text: "ChatX";
            font-size: 32px;
            font-weight: 800;
            color: Theme.fg;
            width: 100%;
            horizontal-alignment: center;
        }

        Text {
            text: root.is-register ? "注册新账户" : "登录";
            font-size: 16px;
            color: Theme.fg-muted;
            width: 100%;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 420px);
                placeholder: "用户";
                text <=> root.uid;
                accepted => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            AuthInput {
                width: min(parent.width, 420px);
                placeholder: "密码";
                text <=> root.pass;
                accepted => { root.submit(); }
            }
        }

        Text {
            text: root.auth-error != "" ? root.auth-error : root.message;
            color: Theme.brand;
            font-size: 14px;
            width: 100%;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            BrandButton {
                width: min(parent.width, 420px);
                text: root.busy ? "处理中…" : (root.is-register ? "注册" : "登录");
                enabled: !root.busy;
                clicked => { root.submit(); }
            }
        }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(parent.width, 420px);
                height: 40px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.is-register ? "已有账户？去登录" : "没有账户？去注册";
                    color: Theme.brand;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.is-register = !root.is-register; }
                }
            }
        }
    }

    function submit() {
        root.auth-error = "";
        if (root.is-register) {
            if (root.uid == "") {
                root.auth-error = "请输入用户名";
                return;
            }
            if (root.pass == "") {
                root.auth-error = "请输入口令";
                return;
            }
            root.register(root.uid, root.pass);
            return;
        }
        if (root.uid == "") {
            root.auth-error = "请输入用户名";
            return;
        }
        if (root.pass == "") {
            root.auth-error = "请输入口令";
            return;
        }
        root.login(root.uid, root.pass);
    }
}
