import { SubPageType, AppState } from "components/app_state.slint";
import { ChatView } from "chats/chat.slint";
import { ChatSettingView } from "chats/chat_setting.slint";
import { ContactProfileView } from "contacts/profile.slint";
import { SettingView } from "me/setting.slint";
import { GroupProfileView } from "contacts/group_profile.slint";
import { AddContactView } from "contacts/add_contact.slint";
import { AddGroupView } from "contacts/add_group.slint";
import { DiscoverDetailView } from "discovery/discover_detail.slint";
import { PomegranateSeedView } from "discovery/pomegranate_seed.slint";
import { MyCollectView } from "me/my_collect.slint";
import { AddMomentView } from "discovery/moment.slint";
import { AddNoteView } from "discovery/note.slint";
import { MyNoteView } from "me/my_note.slint";
import { MyShareView } from "me/my_share.slint";

export component SubPageView inherits Rectangle {
    in property <SubPageType> page;
    in property <int> payload;
    in property <bool> animate-in: true;
    background: #f5f5f5;

    in-out property <bool> slid-in: false;
    in-out property <bool> animating: false;
    in-out property <int> prev-top: -1;
    x: (AppState.is-mobile && root.animate-in) ? (root.slid-in ? 0px : root.width) : 0px;
    animate x {
        duration: (root.animate-in && root.animating) ? 280ms : 0ms;
        easing: ease-out;
    }
    Timer {
        interval: 16ms;
        running: root.animate-in && AppState.is-mobile && !root.slid-in;
        triggered => {
            root.animating = true;
            root.slid-in = true;
        }
    }

    changed page => {
        if root.animate-in {
            let top = AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top;
            if AppState.is-mobile && top > root.prev-top {
                root.animating = false;
                root.slid-in = false;
            }
            root.prev-top = top;
        }
    }
    changed payload => {
        if root.animate-in {
            let top = AppState.nav-state.tabs[AppState.nav-state.active-tab].sub-top;
            if AppState.is-mobile && top > root.prev-top {
                root.animating = false;
                root.slid-in = false;
            }
            root.prev-top = top;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    if root.page == SubPageType.ChatRoom: ChatView {
        chat-id: root.payload;
    }
    if root.page == SubPageType.ChatSetting: ChatSettingView {
        chat-id: root.payload;
    }
    if root.page == SubPageType.ContactProfile: ContactProfileView {
        user-id: root.payload;
    }
    if root.page == SubPageType.GroupProfile: GroupProfileView {
        group-id: root.payload;
    }
    if root.page == SubPageType.Settings: SettingView { }
    if root.page == SubPageType.MyNote: MyNoteView { }
    if root.page == SubPageType.MyCollect: MyCollectView {
        cards: AppState.my_collect;
        like-toggled(id) => { AppState.toggle-like(id); }
    }
    if root.page == SubPageType.MyShare: MyShareView {
        cards: AppState.my_share;
        like-toggled(id) => { AppState.toggle-like(id); }
    }
    if root.page == SubPageType.AddContact: AddContactView { }
    if root.page == SubPageType.AddMoment: AddMomentView { }
    if root.page == SubPageType.AddNote: AddNoteView { }
    if root.page == SubPageType.AddGroup: AddGroupView {
        group-type: root.payload;
    }
    if root.page == SubPageType.DiscoverDetail: DiscoverDetailView {
        key: root.payload;
    }
    if root.page == SubPageType.PomegranateSeed: PomegranateSeedView { }
}
